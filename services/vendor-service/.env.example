# vendor-service local development configuration template.
# Copy to .env and adjust. See docs/architecture/11_FEATURE_FLAG_AND_ROLLOUT_MODEL.md
# for what each flag gates.

APP_ENV=development
HTTP_ADDR=:8112

VENDOR_MIGRATION=false

VENDOR_DATABASE_URL=postgres://cosmicforge_logistics:cosmicforge_logistics@localhost:5445/vendor_service?sslmode=disable
VENDOR_REDIS_ADDR=localhost:6390
VENDOR_REDIS_PASSWORD=
VENDOR_REDIS_DB=0

# HMAC secrets for inbound internal callers, "caller=secret,caller2=secret2".
# Section 7 verification callbacks require verification-compliance-service.
VENDOR_SERVICE_SECRETS=verification-compliance-service=development-verification-vendor-secret

# --- Feature flags / kill switches (all default false) ---
VENDOR_SERVICE_ENABLED=false
VENDOR_ONBOARDING_WRITES_ENABLED=false
VENDOR_CRM_ENABLED=false
# Section 8B. Segmentation requires VENDOR_CRM_ENABLED; materialization requires
# segmentation. Both prerequisites are checked at startup.
VENDOR_CRM_SEGMENTATION_ENABLED=false
VENDOR_CRM_SEGMENT_MATERIALIZATION_ENABLED=false
# Section 8C. These flags expose the interaction and task read surfaces;
# mutations also require VENDOR_CRM_WRITES_ENABLED.
VENDOR_CRM_INTERACTIONS_ENABLED=false
VENDOR_CRM_TASKS_ENABLED=false
# Section 8D. Exposes the loyalty points surface; mutations also require
# VENDOR_CRM_WRITES_ENABLED. (Absent from this file until Section 8E; the flag
# itself has existed and defaulted false since Section 8D shipped.)
VENDOR_CRM_LOYALTY_ENABLED=false
# Section 8E. Campaigns require VENDOR_CRM_ENABLED and
# VENDOR_CRM_SEGMENTATION_ENABLED, because the Section 8B segment engine is the
# only source a campaign audience has. Preparation requires campaigns, and
# freezing it never disturbs an audience that is already prepared. Both
# prerequisites are checked at startup.
VENDOR_CRM_CAMPAIGNS_ENABLED=false
VENDOR_CRM_CAMPAIGN_PREPARATION_ENABLED=false
VENDOR_CRM_CAMPAIGN_EXECUTION_ENABLED=false
VENDOR_INVENTORY_ENABLED=false
VENDOR_PURCHASING_ENABLED=false
VENDOR_RECIPES_ENABLED=false

# Section 9A food catalogue. COMMERCE_FOOD_ENABLED registers the surface at all;
# with it false no food route exists. The writes flag additionally gates every
# mutation, so a rollout can expose the read surface before it accepts edits,
# and COMMERCE_GLOBAL_KILL_SWITCH below overrides it either way.
COMMERCE_FOOD_ENABLED=false
VENDOR_FOOD_CATALOGUE_WRITES_ENABLED=false
COMMERCE_SHOP_ENABLED=false
VENDOR_SHOP_CATALOGUE_WRITES_ENABLED=false
# Explicit HMAC caller identities allowed to consume internal Shop discovery
# and inventory reservation contracts. Empty denies every caller.
VENDOR_SHOP_INTERNAL_CALLERS=
COMMERCE_MULTI_VENDOR_ENABLED=false
COMMERCE_VARIABLE_WEIGHT_ENABLED=false
COMMERCE_BULK_RFQ_ENABLED=false

VENDOR_OWN_DELIVERY_ENABLED=false

DISPATCH_COMMERCE_INTEGRATION_ENABLED=false
TAXI_GOODS_DELIVERY_ENABLED=false
HAULING_COMMERCE_INTEGRATION_ENABLED=false

PAYMENT_WALLET_COMMERCE_ENABLED=false
VENDOR_VERIFICATION_INTEGRATION_ENABLED=false

COMMERCE_FULFILMENT_WORKERS_ENABLED=false
COMMERCE_GLOBAL_KILL_SWITCH=false

# --- Downstream integration credentials (leave unset until each flag above
#     is turned on for a specific implemented feature section) ---
VENDOR_WALLET_URL=
VENDOR_WALLET_SECRET=
VENDOR_VERIFICATION_URL=
VENDOR_VERIFICATION_SECRET=
VENDOR_MEDIA_URL=
VENDOR_MEDIA_SECRET=
VENDOR_NOTIFICATION_URL=
VENDOR_NOTIFICATION_SECRET=
VENDOR_SUPPORT_URL=
VENDOR_SUPPORT_SECRET=
VENDOR_ADMIN_URL=
VENDOR_ADMIN_SECRET=
VENDOR_ANALYTICS_URL=
VENDOR_ANALYTICS_SECRET=
VENDOR_DISPATCH_URL=
VENDOR_DISPATCH_SECRET=
VENDOR_TAXI_URL=
VENDOR_TAXI_SECRET=
VENDOR_HAULING_URL=
VENDOR_HAULING_SECRET=
VENDOR_INTERNAL_SERVICE_TIMEOUT_SECONDS=5

# Section 8G. Corporate CRM requires VENDOR_CRM_ENABLED, because a corporate
# contact is a reference to a Section 8A customer relationship and corporate
# activity runs on the Section 8C engine. Mutations also require
# VENDOR_CRM_WRITES_ENABLED; corporate interactions and tasks additionally
# require VENDOR_CRM_INTERACTIONS_ENABLED / VENDOR_CRM_TASKS_ENABLED, and their
# routes are not registered at all without them.
VENDOR_CRM_CORPORATE_ENABLED=false

# Section 8H. Intelligence requires VENDOR_CRM_ENABLED, because every score is
# computed from Section 8A commercial projections. The worker flag stands the
# materializer down without hiding existing scores. Exports require
# VENDOR_CRM_ENABLED and, at startup, VENDOR_MEDIA_URL/VENDOR_MEDIA_SECRET:
# there is no local-file fallback, so an export with no private artifact store
# is a boot failure rather than a queue of jobs that can never finish.
VENDOR_CRM_INTELLIGENCE_ENABLED=false
VENDOR_CRM_INTELLIGENCE_WORKER_ENABLED=false
VENDOR_CRM_EXPORTS_ENABLED=false
