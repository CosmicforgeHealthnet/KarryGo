# vendor-service local development configuration template.
# Copy to .env and adjust. See docs/architecture/11_FEATURE_FLAG_AND_ROLLOUT_MODEL.md
# for what each flag gates.

APP_ENV=development
HTTP_ADDR=:8112

VENDOR_MIGRATION=false

VENDOR_DATABASE_URL=postgres://cosmicforge_logistics:cosmicforge_logistics@localhost:5445/vendor_service?sslmode=disable
VENDOR_REDIS_ADDR=localhost:6390
VENDOR_REDIS_PASSWORD=
VENDOR_REDIS_DB=0

# HMAC secrets for inbound internal callers, "caller=secret,caller2=secret2".
# Section 7 verification callbacks require verification-compliance-service.
VENDOR_SERVICE_SECRETS=verification-compliance-service=development-verification-vendor-secret

# --- Feature flags / kill switches (all default false) ---
VENDOR_SERVICE_ENABLED=false
VENDOR_ONBOARDING_WRITES_ENABLED=false
VENDOR_CRM_ENABLED=false
# Section 8B. Segmentation requires VENDOR_CRM_ENABLED; materialization requires
# segmentation. Both prerequisites are checked at startup.
VENDOR_CRM_SEGMENTATION_ENABLED=false
VENDOR_CRM_SEGMENT_MATERIALIZATION_ENABLED=false
# Section 8C. These flags expose the interaction and task read surfaces;
# mutations also require VENDOR_CRM_WRITES_ENABLED.
VENDOR_CRM_INTERACTIONS_ENABLED=false
VENDOR_CRM_TASKS_ENABLED=false
# Section 8D. Exposes the loyalty points surface; mutations also require
# VENDOR_CRM_WRITES_ENABLED. (Absent from this file until Section 8E; the flag
# itself has existed and defaulted false since Section 8D shipped.)
VENDOR_CRM_LOYALTY_ENABLED=false
# Section 8E. Campaigns require VENDOR_CRM_ENABLED and
# VENDOR_CRM_SEGMENTATION_ENABLED, because the Section 8B segment engine is the
# only source a campaign audience has. Preparation requires campaigns, and
# freezing it never disturbs an audience that is already prepared. Both
# prerequisites are checked at startup.
VENDOR_CRM_CAMPAIGNS_ENABLED=false
VENDOR_CRM_CAMPAIGN_PREPARATION_ENABLED=false
VENDOR_CRM_CAMPAIGN_EXECUTION_ENABLED=false
VENDOR_INVENTORY_ENABLED=false
VENDOR_INVENTORY_WRITES_ENABLED=false
# Explicit HMAC caller identities allowed to consume the internal generic
# Inventory contracts, which carry stock-mutation authority on behalf of
# another service. Empty denies every caller.
VENDOR_INVENTORY_INTERNAL_CALLERS=
VENDOR_PURCHASING_ENABLED=false
VENDOR_RECIPES_ENABLED=false

# Section 9A food catalogue. COMMERCE_FOOD_ENABLED registers the surface at all;
# with it false no food route exists. The writes flag additionally gates every
# mutation, so a rollout can expose the read surface before it accepts edits,
# and COMMERCE_GLOBAL_KILL_SWITCH below overrides it either way.
COMMERCE_FOOD_ENABLED=false
VENDOR_FOOD_CATALOGUE_WRITES_ENABLED=false
COMMERCE_SHOP_ENABLED=false
VENDOR_SHOP_CATALOGUE_WRITES_ENABLED=false
# Explicit HMAC caller identities allowed to consume internal Shop discovery
# and inventory reservation contracts. Empty denies every caller.
VENDOR_SHOP_INTERNAL_CALLERS=
COMMERCE_MULTI_VENDOR_ENABLED=false
COMMERCE_VARIABLE_WEIGHT_ENABLED=false
COMMERCE_BULK_RFQ_ENABLED=false

VENDOR_OWN_DELIVERY_ENABLED=false

DISPATCH_COMMERCE_INTEGRATION_ENABLED=false
TAXI_GOODS_DELIVERY_ENABLED=false
HAULING_COMMERCE_INTEGRATION_ENABLED=false

PAYMENT_WALLET_COMMERCE_ENABLED=false
VENDOR_VERIFICATION_INTEGRATION_ENABLED=false

COMMERCE_FULFILMENT_WORKERS_ENABLED=false
COMMERCE_GLOBAL_KILL_SWITCH=false

# Section 17B checkout validation and Inventory reservation. It is separable
# from the Section 17A cart on purpose: standing checkout down must never take
# the cart with it. With COMMERCE_SHOP_ENABLED=true it additionally requires
# VENDOR_INVENTORY_ENABLED and VENDOR_INVENTORY_WRITES_ENABLED, because a Shop
# checkout holds real physical stock through Section 14.
COMMERCE_CHECKOUT_ENABLED=false
# The background sweep that releases stock a lapsed or crashed checkout is
# still holding and hands the cart back to its customer.
COMMERCE_CHECKOUT_RECOVERY_ENABLED=false
# How long a validated checkout holds real stock. There is no hardcoded
# default anywhere in the code; 5-15 minutes is the usual operating range.
COMMERCE_CHECKOUT_RESERVATION_TTL_SECONDS=600
# How long a checkout may sit mid-reservation before recovery treats it as
# abandoned by a dead process. Must be shorter than the TTL.
COMMERCE_CHECKOUT_STRANDED_GRACE_SECONDS=120
COMMERCE_CHECKOUT_RECOVERY_INTERVAL_SECONDS=30

# --- Section 17C: fulfilment planning and logistics integration ---
# Turns validated Section 17B groups into a candidate fulfilment plan. Requires
# COMMERCE_CHECKOUT_ENABLED, and at least one delivery authority
# (VENDOR_OWN_DELIVERY_ENABLED, DISPATCH_COMMERCE_INTEGRATION_ENABLED or
# HAULING_COMMERCE_INTEGRATION_ENABLED) - otherwise it would be a surface whose
# only possible answer is "no delivery option available".
COMMERCE_FULFILMENT_PLANNING_ENABLED=false
# How long one call to a logistics authority may take. Short on purpose: a
# customer is waiting, and a slow authority must make the group unserviceable
# rather than hang the checkout.
COMMERCE_FULFILMENT_QUOTE_TIMEOUT_SECONDS=8
# Bounds a plan independently of its quotes. The effective expiry is always the
# earlier of this and the soonest authority quote inside the plan.
COMMERCE_FULFILMENT_PLAN_TTL_SECONDS=900
# How close two vendor pickups must be before one mission may cover both.
# Deliberately tight: no logistics authority models a multi-pickup mission
# today, so consolidating distant pickups would price a route nobody can drive.
# The real case is co-located vendors - two traders in one market.
COMMERCE_FULFILMENT_CONSOLIDATION_RADIUS_METERS=150
# Background sweep that expires lapsed plans, gated additionally by
# COMMERCE_FULFILMENT_WORKERS_ENABLED.
COMMERCE_FULFILMENT_EXPIRY_INTERVAL_SECONDS=60

# --- Section 17D: immutable checkout quote lock ---
# Freezes authoritative product prices, the selected fulfilment plan, delivery
# funding and approved commercial adjustments into a customer-scoped quote.
# Requires both COMMERCE_CHECKOUT_ENABLED and
# COMMERCE_FULFILMENT_PLANNING_ENABLED. It creates no payment or order.
COMMERCE_QUOTE_LOCK_ENABLED=false
# Effective expiry is the earliest of this, checkout expiry and plan expiry.
COMMERCE_QUOTE_TTL_SECONDS=300

# --- Section 17E: ParentOrder and multi-vendor VendorOrders ---
# Turns one approved, unexpired Section 17D quote into exactly one ParentOrder
# and one financially and operationally isolated VendorOrder per vendor/branch
# allocation. Requires COMMERCE_QUOTE_LOCK_ENABLED: without an approved quote
# there is nothing an order could ever be cut from.
#
# It creates no payment operation, moves no money and executes no logistics
# mission. It needs no new credential and no new permission: the vendor staff
# surface uses vendor.orders.read and vendor.orders.manage, both already seeded
# in Section 5.
COMMERCE_ORDERS_ENABLED=false

# --- Section 17F: payment binding and total price guarantee ---
# Payment is not a flag of its own. It appears when a money authority is
# configured: PAYMENT_WALLET_COMMERCE_ENABLED with VENDOR_WALLET_URL and
# VENDOR_WALLET_SECRET (already required together by config validation). With
# no authority wired, COMMERCE_ORDERS_ENABLED still gives a fully working order
# service and NO payment route exists at all - a disabled capability has no
# surface to probe rather than one that can only answer 503.
#
# Vendor Commerce is not a money authority. It never fabricates a payment
# status, edits a ledger, computes a balance or settles vendor funds; every
# financial effect is performed by payment-wallet-service.

# --- Downstream integration credentials (leave unset until each flag above
#     is turned on for a specific implemented feature section) ---
VENDOR_WALLET_URL=
VENDOR_WALLET_SECRET=
VENDOR_VERIFICATION_URL=
VENDOR_VERIFICATION_SECRET=
VENDOR_MEDIA_URL=
VENDOR_MEDIA_SECRET=
VENDOR_NOTIFICATION_URL=
VENDOR_NOTIFICATION_SECRET=
VENDOR_SUPPORT_URL=
VENDOR_SUPPORT_SECRET=
VENDOR_ADMIN_URL=
VENDOR_ADMIN_SECRET=
VENDOR_ANALYTICS_URL=
VENDOR_ANALYTICS_SECRET=
# Section 17C logistics quote authorities. BOTH URLs are BARE ORIGINS: the
# shared quote client appends each service's own API base and path itself.
# Pasting a full path here produces a doubled path that 404s every call - a
# mistake this platform has already made once with HAULING_PAYMENT_URL.
# The secret must match the entry this service is allowlisted under on the far
# side: VENDOR_SERVICE_SECRET on driver-dispatch-delivery-service, and a
# "vendor-service=<secret>" entry in HAULING_SERVICE_SECRETS on
# driver-hauling-service.
VENDOR_DISPATCH_URL=
VENDOR_DISPATCH_SECRET=
# Taxi is NOT used by Section 17C. driver-taxi-service has no production
# goods-delivery capability, the shared quote contract has no CAR class, and
# the class-to-service mapping refuses one. These stay unset.
VENDOR_TAXI_URL=
VENDOR_TAXI_SECRET=
VENDOR_HAULING_URL=
VENDOR_HAULING_SECRET=
# Section 17A Customer Service identity/address integration.
# URL/HMAC secret are used only for authoritative saved-address resolution.
# Customer access-token secret verifies Customer Service bearer tokens; do not reuse Vendor staff auth.
VENDOR_CUSTOMER_URL=
VENDOR_CUSTOMER_SECRET=
VENDOR_CUSTOMER_ACCESS_TOKEN_SECRET=
VENDOR_INTERNAL_SERVICE_TIMEOUT_SECONDS=5

# Section 8G. Corporate CRM requires VENDOR_CRM_ENABLED, because a corporate
# contact is a reference to a Section 8A customer relationship and corporate
# activity runs on the Section 8C engine. Mutations also require
# VENDOR_CRM_WRITES_ENABLED; corporate interactions and tasks additionally
# require VENDOR_CRM_INTERACTIONS_ENABLED / VENDOR_CRM_TASKS_ENABLED, and their
# routes are not registered at all without them.
VENDOR_CRM_CORPORATE_ENABLED=false

# Section 8H. Intelligence requires VENDOR_CRM_ENABLED, because every score is
# computed from Section 8A commercial projections. The worker flag stands the
# materializer down without hiding existing scores. Exports require
# VENDOR_CRM_ENABLED and, at startup, VENDOR_MEDIA_URL/VENDOR_MEDIA_SECRET:
# there is no local-file fallback, so an export with no private artifact store
# is a boot failure rather than a queue of jobs that can never finish.
VENDOR_CRM_INTELLIGENCE_ENABLED=false
VENDOR_CRM_INTELLIGENCE_WORKER_ENABLED=false
VENDOR_CRM_EXPORTS_ENABLED=false
