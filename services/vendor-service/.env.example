# vendor-service local development configuration template.
# Copy to .env and adjust. See docs/architecture/11_FEATURE_FLAG_AND_ROLLOUT_MODEL.md
# for what each flag gates.

APP_ENV=development
HTTP_ADDR=:8112

VENDOR_MIGRATION=false

VENDOR_DATABASE_URL=postgres://cosmicforge_logistics:cosmicforge_logistics@localhost:5445/vendor_service?sslmode=disable
VENDOR_REDIS_ADDR=localhost:6390
VENDOR_REDIS_PASSWORD=
VENDOR_REDIS_DB=0

# HMAC secrets for inbound internal callers, "caller=secret,caller2=secret2".
# Section 7 verification callbacks require verification-compliance-service.
VENDOR_SERVICE_SECRETS=verification-compliance-service=development-verification-vendor-secret

# --- Feature flags / kill switches (all default false) ---
VENDOR_SERVICE_ENABLED=false
VENDOR_ONBOARDING_WRITES_ENABLED=false
VENDOR_CRM_ENABLED=false
VENDOR_INVENTORY_ENABLED=false
VENDOR_PURCHASING_ENABLED=false
VENDOR_RECIPES_ENABLED=false

COMMERCE_FOOD_ENABLED=false
COMMERCE_SHOP_ENABLED=false
COMMERCE_MULTI_VENDOR_ENABLED=false
COMMERCE_VARIABLE_WEIGHT_ENABLED=false
COMMERCE_BULK_RFQ_ENABLED=false

VENDOR_OWN_DELIVERY_ENABLED=false

DISPATCH_COMMERCE_INTEGRATION_ENABLED=false
TAXI_GOODS_DELIVERY_ENABLED=false
HAULING_COMMERCE_INTEGRATION_ENABLED=false

PAYMENT_WALLET_COMMERCE_ENABLED=false
VENDOR_VERIFICATION_INTEGRATION_ENABLED=false

COMMERCE_FULFILMENT_WORKERS_ENABLED=false
COMMERCE_GLOBAL_KILL_SWITCH=false

# --- Downstream integration credentials (leave unset until each flag above
#     is turned on for a specific implemented feature section) ---
VENDOR_WALLET_URL=
VENDOR_WALLET_SECRET=
VENDOR_VERIFICATION_URL=
VENDOR_VERIFICATION_SECRET=
VENDOR_MEDIA_URL=
VENDOR_MEDIA_SECRET=
VENDOR_NOTIFICATION_URL=
VENDOR_NOTIFICATION_SECRET=
VENDOR_SUPPORT_URL=
VENDOR_SUPPORT_SECRET=
VENDOR_ADMIN_URL=
VENDOR_ADMIN_SECRET=
VENDOR_ANALYTICS_URL=
VENDOR_ANALYTICS_SECRET=
VENDOR_DISPATCH_URL=
VENDOR_DISPATCH_SECRET=
VENDOR_TAXI_URL=
VENDOR_TAXI_SECRET=
VENDOR_HAULING_URL=
VENDOR_HAULING_SECRET=
VENDOR_INTERNAL_SERVICE_TIMEOUT_SECONDS=5
