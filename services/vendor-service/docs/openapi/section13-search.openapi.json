  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "hmacV2": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Signature"
      }
    },
    "responses": {
      "Error": {
        "description": "Stable platform error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "EmptyCommand": {
        "type": "object",
        "additionalProperties": false,
        "description": "No body fields. The command's subject comes from the path and its actor from the verified caller."
      },
      "Error": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "FoodSearchRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "description": "No generation field exists: the ACTIVE generation is resolved server-side. Supplying shop_filters is rejected.",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "branch_ref": {
            "type": "string",
            "maxLength": 200
          },
          "profile_code": {
            "type": "string",
            "maxLength": 96
          },
          "facets": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string"
            }
          },
          "sort": {
            "type": "string",
            "enum": [
              "RELEVANCE",
              "PRICE_ASC",
              "PRICE_DESC",
              "DISTANCE"
            ]
          },
          "page_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50,
            "description": "Clamped to the maximum rather than rejected."
          },
          "cursor": {
            "type": "string",
            "description": "Opaque stable cursor from a previous response."
          },
          "distance_context": {
            "type": "object",
            "nullable": true,
            "description": "Required for DISTANCE sorting. Distance sorting without it is rejected."
          },
          "food_filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ProviderTypes": {
                "type": "array",
                "maxItems": 32,
                "items": {
