{
  "openapi": "3.0.3",
  "info": {
    "title": "KarryGo Vendor Service - Section 13 Food and Shop Search",
    "version": "1.0.0",
    "description": "Section 13 internal Food and Shop discovery: ranked search, bounded facets and bounded suggestions. FOOD and SHOP are separate engines over separate projections with separate generations; there is deliberately no combined endpoint. Every response is derived state read from the ACTIVE generation - it confers no availability, price or stock guarantee, and authoritative Food/Shop revalidation happens at checkout. Callers cannot select a generation. No personalization, no customer profiling, no search-history ranking, no vector or LLM search."
  },
  "servers": [
    {
      "url": "/internal/vendor/v1"
    }
  ],
  "security": [
    {
      "hmacV2": []
    }
  ],
  "paths": {
    "/search/food": {
      "post": {
        "operationId": "post_internal_vendor_v1_search_food",
        "summary": "Search the Food projection",
        "description": "Ranked Food search at the ACTIVE generation. The generation is resolved server-side and cannot be supplied. A Shop filter block is rejected. Results are derived state: a hit confers no availability, price or stock guarantee.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Service-Name",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Verified calling service identity."
          },
          {
            "in": "header",
            "name": "X-Service-Timestamp",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unix seconds; rejected outside the verifier's skew window."
          },
          {
            "in": "header",
            "name": "X-Service-Nonce",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Consumed exactly once against vendor_service_nonces; a replay is rejected."
          },
          {
            "in": "header",
            "name": "X-Service-Signature",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "HMAC-SHA256 over version, caller, method, request URI, timestamp, nonce and body digest."
          },
          {
            "in": "header",
            "name": "X-Service-Signature-Version",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Signature version. Must be v2."
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Caller command reference. Replaying the same key returns the original result rather than applying the command twice."
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FoodSearchRequest"
              }
            }
          }
        }
      }
    },
