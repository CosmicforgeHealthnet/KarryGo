    "/search/food/suggestions": {
      "get": {
        "operationId": "get_internal_vendor_v1_search_food_suggestions",
        "summary": "Food autocomplete suggestions",
        "description": "Bounded suggestions from canonical taxonomy, aliases, synonyms and projected Food names. There is no personalization input and no search history.",
