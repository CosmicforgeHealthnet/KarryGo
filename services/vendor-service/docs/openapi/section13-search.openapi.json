                "items": {
                  "type": "string"
                }
              },
              "Occasions": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string"
                }
              },
              "DietaryClaims": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string"
                }
              },
              "PreferenceClaims": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string"
                }
              },
              "MinPriceMinor": {
                "type": "integer",
                "format": "int64",
                "nullable": true
              },
              "MaxPriceMinor": {
                "type": "integer",
                "format": "int64",
                "nullable": true
              },
              "Available": {
                "type": "boolean",
                "nullable": true
              },
              "Serviceable": {
                "type": "boolean",
                "nullable": true
              },
              "Trusted": {
                "type": "boolean",
                "nullable": true
              }
            }
          }
        }
      },
      "ShopSearchRequest": {
        "type": "object",
        "required": [
          "query"
        ],
        "additionalProperties": false,
        "description": "No generation field exists. Supplying food_filters is rejected.",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
