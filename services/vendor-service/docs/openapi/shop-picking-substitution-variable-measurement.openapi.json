    "/api/v1/commerce/substitution-cases/{caseId}/accept": {
      "post": {
        "operationId": "shop_picking_substitution_variable_measurement_openapi_post_api_v1_commerce_substitution_cases_caseId_accept_224dd0ab",
        "parameters": [
          {
            "in": "path",
            "name": "caseId",
            "required": true,
            "schema": {
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Retry key. Same tenant/key/fingerprint replays the original result; a different fingerprint returns 409.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          },
          {
            "description": "Required optimistic version. A stale or missing version returns 409.",
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        },
        "summary": "Accept a substitution case with OCC",
        "security": [
          {
            "CustomerBearer": []
          }
        ]
      }
    },
