                            "nullable": true,
                            "properties": {
                              "mode": {
                                "type": "string"
                              },
                              "state": {
                                "type": "string"
                              },
                              "estimated_quantity": {
                                "type": "integer"
                              },
                              "unit_price_minor": {
                                "type": "integer"
                              },
                              "estimated_amount_minor": {
                                "type": "integer"
                              },
                              "tolerance_quantity": {
                                "type": "integer"
                              },
                              "hard_max_quantity": {
                                "type": "integer"
                              },
                              "reserved_upper_quantity": {
                                "type": "integer"
                              },
                              "actual_quantity": {
                                "type": "integer"
                              },
                              "final_amount_minor": {
                                "type": "integer"
                              },
                              "pricing_denominator": {
                                "type": "integer"
                              },
                              "version": {
                                "type": "integer"
                              }
                            }
                          },
                          "QualityResult": {
                            "type": "string",
                            "nullable": true
                          },
                          "QualityResults": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "preference_type": {
                                  "type": "string"
                                },
                                "preference_value": {
                                  "type": "string"
                                },
                                "result": {
                                  "type": "string"
                                },
                                "observed_value": {
                                  "type": "string"
                                },
                                "reason": {
                                  "type": "string"
                                },
                                "version": {
                                  "type": "integer"
                                },
                                "created_at": {
                                  "type": "string"
                                }
                              }
                            }
                          },
                          "HasOutcome": {
                            "type": "boolean"
                          },
                          "Version": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Read immutable Shop picking snapshots and current evidence"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CustomerBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Customer Service access token; the customer is derived from the token, never from the request."
      }
    }
  }
}
