{
  "openapi": "3.0.3",
  "info": {
    "title": "Vendor cloud kitchen context",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/vendor/cloud-kitchen/context/{branchId}": {
      "get": {
        "operationId": "cloudKitchenContext",
        "parameters": [
          {
            "name": "branchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped business currency or eligible active CRM corporate profile IDs"
          },
          "403": {
            "description": "Staff scope denied"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/vendor/cloud-kitchen/corporate-references": {
      "get": {
        "operationId": "cloudKitchenCorporateReferences",
        "parameters": [
          {
            "name": "branch_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped business currency or eligible active CRM corporate profile IDs"
          },
          "403": {
            "description": "Staff scope denied"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
