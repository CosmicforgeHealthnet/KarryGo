      "get": {
        "operationId": "CustomerFoodCatalogue",
        "parameters": [
          {
            "name": "branchId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          {
            "name": "capability",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "RESTAURANT",
                "CLOUD_KITCHEN",
                "PASTRY_BAKERY"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Customer-safe authoritative read (search is derived; preview is not guaranteed)",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "no-store"
                  ]
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "trust": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PublicTrustFact"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid customer access bearer"
          },
          "403": {
            "description": "Wrong token role/service/type"
          },
          "404": {
            "description": "Disabled domain, missing resource or ownership mismatch"
          },
          "429": {
            "description": "Per-customer rate budget exhausted"
          },
          "503": {
            "description": "Authority or Redis unavailable; fail closed"
          }
        }
      }
    },
