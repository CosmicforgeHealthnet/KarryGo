{
  "openapi": "3.0.3",
  "info": {
    "title": "Karryam V4 Customer Commerce discovery and delivery preview",
    "version": "14",
    "description": "Customer bearer reads over existing catalogue/search and quote-only fulfilment authorities. Both CUSTOMER and COMMERCE domain switches are required; global kill switch closes reads. Discovery budget 120/customer/minute; delivery preview 20/customer/minute. Redis failure fails closed. No inventory reservation, mission, assignment or money movement. Customer V4 section 19: trust is an authority-backed, read-time allowlist independent of ratings. Facts older than five minutes are omitted. Expired VERIFIED becomes EXPIRED. Trust responses are no-store; search overlays trust after its cache."
  },
  "servers": [
    {
      "url": "/api/v1/commerce"
    }
  ],
  "security": [
    {
      "CustomerBearer": []
    }
  ],
