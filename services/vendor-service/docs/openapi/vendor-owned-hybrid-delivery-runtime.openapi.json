      "get": {
        "operationId": "vendor_owned_hybrid_delivery_runtime_openapi_get_api_v1_vendor_delivery_rider_availability_e3519611",
        "responses": {
          "200": {
            "description": "Availability"
          }
        },
        "summary": "Read the authenticated Vendor Rider availability"
      },
      "put": {
        "operationId": "vendor_owned_hybrid_delivery_runtime_openapi_put_api_v1_vendor_delivery_rider_availability_e3a518e6",
        "parameters": [
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Availability updated"
          }
        },
        "summary": "Set authenticated Vendor Rider online availability"
      }
    },
    "/api/v1/vendor/delivery/rider/missions": {
      "get": {
        "operationId": "vendor_owned_hybrid_delivery_runtime_openapi_get_api_v1_vendor_delivery_rider_missions_e1769359",
        "responses": {
          "200": {
            "description": "Assigned missions"
          }
        },
        "summary": "List missions assigned to the authenticated Vendor Rider"
      }
    },
    "/api/v1/vendor/delivery/rider/missions/current": {
      "get": {
        "operationId": "vendor_owned_hybrid_delivery_runtime_openapi_get_api_v1_vendor_delivery_rider_missions_current_6828d363",
        "responses": {
          "200": {
            "description": "Current mission"
          },
          "404": {
            "description": "No current mission"
          }
        },
        "summary": "Read the authenticated Vendor Rider current mission"
      }
    },
    "/api/v1/vendor/delivery/rider/missions/{missionId}": {
      "get": {
        "operationId": "vendor_owned_hybrid_delivery_runtime_openapi_get_api_v1_vendor_delivery_rider_missions_missionId_1f0aeda1",
        "parameters": [
          {
            "in": "path",
            "name": "missionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Assigned mission"
          },
          "404": {
            "description": "Not assigned"
          }
        },
        "summary": "Read one mission assigned to the authenticated Vendor Rider"
      }
    },
    "/api/v1/vendor/delivery/rider/missions/{missionId}/actions/{action}": {
      "post": {
        "operationId": "vendor_owned_hybrid_delivery_runtime_openapi_post_api_v1_vendor_delivery_rider_missions_missionId_actions_action_848cda54",
        "parameters": [
          {
            "in": "path",
            "name": "missionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "action",
            "required": true,
            "schema": {
              "enum": [
                "acknowledge",
                "start-pickup",
                "arrive-pickup",
                "complete-pickup",
                "start-receiver",
                "arrive-receiver",
                "complete-delivery",
                "receiver-unavailable",
                "return"
              ],
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Action applied"
          },
          "503": {
            "description": "Secure handover authority unavailable"
          }
        },
        "summary": "Execute one controlled Vendor Rider mission action"
      }
    },
    "/api/v1/vendor/fulfilment/vendor-missions/fallbacks/{operationRef}": {
      "get": {
        "operationId": "vendor_owned_hybrid_delivery_runtime_openapi_get_api_v1_vendor_fulfilment_vendor_missions_fallbacks_operationRef_19a3ea24",
        "parameters": [
          {
            "in": "path",
            "name": "operationRef",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fallback operation"
          }
        },
        "summary": "Inspect a durable Hybrid fallback operation"
      }
    },
    "/api/v1/vendor/fulfilment/vendor-missions/{missionId}/fallbacks": {
      "post": {
        "operationId": "vendor_owned_hybrid_delivery_runtime_openapi_post_api_v1_vendor_fulfilment_vendor_missions_missionId_fallbacks_26e19e7d",
        "parameters": [
          {
            "in": "path",
            "name": "missionId",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "If-Match",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fallback operation"
          },
          "409": {
            "description": "Custody or plan conflict"
          }
        },
        "summary": "Start or recover a pre-custody Vendor to platform fallback"
      }
    }
  }
}
