{
  "openapi": "3.0.3",
  "info": {
    "title": "KarryGo Vendor CRM Interactions and Tasks API",
    "version": "8.3.0",
    "description": "Section 8C records vendor-local relationship interactions and staff follow-up tasks. It is not support ticketing, notification delivery, canonical customer identity, payment authority, or campaign execution. Free-text fields are plain text and canonical customer PII is not stored."
  },
  "servers": [{"url": "/api/v1/vendor"}],
  "security": [{"BearerAuth": []}],
  "x-feature-flags": ["VENDOR_CRM_ENABLED", "VENDOR_CRM_WRITES_ENABLED", "VENDOR_CRM_INTERACTIONS_ENABLED", "VENDOR_CRM_TASKS_ENABLED", "COMMERCE_GLOBAL_KILL_SWITCH"],
  "x-rate-limit-contract": "The existing Redis limiter applies per business/staff: 60 interaction/task creates per minute and 120 corrections/task mutations per minute. Limit excess returns the established 429 envelope; limiter unavailability fails closed with 503. Idempotency reservations are released for retryable 429/5xx responses.",
  "x-task-state-machine": "OPEN may transition to IN_PROGRESS, COMPLETED, or CANCELLED. IN_PROGRESS may transition to COMPLETED or CANCELLED. COMPLETED and CANCELLED are terminal. OVERDUE is derived from due_at and is never a stored status.",
  "x-privacy-contract": "Redacted profiles expose no interaction notes or tasks through ordinary CRM APIs. Open tasks are made non-actionable and retained records are display-suppressed transactionally. Identity merge moves interactions and tasks to the canonical target under the shared profile-row fence. MARKETING_SUPPRESS does not erase relationship history and never changes consent authority.",
  "x-authority-contract": "EMAIL, SMS and IN_APP interaction types describe a staff-recorded interaction method only. No operation sends a notification or creates a support/dispute case. No response contains canonical customer email, phone, address, government identifier, payment data, or authentication material.",
  "paths": {
    "/crm/interactions": {
      "get": {"operationId":"listCRMInteractions","x-permission":"vendor.crm.interactions.read","parameters":[{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/Offset"},{"name":"customer_profile_ref","in":"query","schema":{"type":"string"}},{"name":"type","in":"query","schema":{"$ref":"#/components/schemas/InteractionType"}},{"name":"direction","in":"query","schema":{"$ref":"#/components/schemas/InteractionDirection"}},{"name":"outcome","in":"query","schema":{"$ref":"#/components/schemas/InteractionOutcome"}},{"name":"branch_ref","in":"query","schema":{"type":"string"}},{"name":"recorded_by","in":"query","schema":{"type":"string"}},{"name":"search","in":"query","schema":{"type":"string","maxLength":120}},{"name":"occurred_from","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"occurred_to","in":"query","schema":{"type":"string","format":"date-time"}}],"responses":{"200":{"description":"Scope-filtered interaction page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InteractionListEnvelope"}}}},"401":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"}}},
      "post": {"operationId":"createCRMInteraction","x-permission":"vendor.crm.interactions.create","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateInteractionRequest"}}}},"responses":{"201":{"description":"Interaction created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InteractionEnvelope"}}}},"400":{"$ref":"#/components/responses/Error"},"403":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"}}}
    },
    "/crm/interactions/{interactionId}": {
      "parameters":[{"$ref":"#/components/parameters/InteractionId"}],
      "get":{"operationId":"getCRMInteraction","x-permission":"vendor.crm.interactions.read","responses":{"200":{"description":"Interaction","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InteractionEnvelope"}}}},"404":{"$ref":"#/components/responses/Error"}}}
    },
    "/crm/interactions/{interactionId}/correct": {
      "parameters":[{"$ref":"#/components/parameters/InteractionId"}],
      "post":{"operationId":"correctCRMInteraction","x-permission":"vendor.crm.interactions.manage","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CorrectInteractionRequest"}}}},"responses":{"200":{"description":"Corrected interaction with a new immutable revision","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InteractionEnvelope"}}}},"409":{"$ref":"#/components/responses/Error"}}}
    },
    "/crm/interactions/{interactionId}/revisions": {
      "parameters":[{"$ref":"#/components/parameters/InteractionId"}],
      "get":{"operationId":"listCRMInteractionRevisions","x-permission":"vendor.crm.interactions.read","responses":{"200":{"description":"Immutable revision history","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InteractionRevisionListEnvelope"}}}},"404":{"$ref":"#/components/responses/Error"}}}
    },
    "/crm/customers/{profileId}/interactions": {
      "parameters":[{"$ref":"#/components/parameters/ProfileId"}],
      "get":{"operationId":"listCustomerCRMInteractions","x-permission":"vendor.crm.interactions.read","parameters":[{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/Offset"}],"responses":{"200":{"description":"Scope-filtered customer timeline","content":{"application/json":{"schema":{"$ref":"#/components/schemas/InteractionListEnvelope"}}}},"404":{"$ref":"#/components/responses/Error"}}}
    },
    "/crm/tasks": {
      "get":{"operationId":"listCRMTasks","x-permission":"vendor.crm.tasks.read","parameters":[{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/Offset"},{"name":"customer_profile_ref","in":"query","schema":{"type":"string"}},{"name":"status","in":"query","schema":{"$ref":"#/components/schemas/TaskStatus"}},{"name":"priority","in":"query","schema":{"$ref":"#/components/schemas/TaskPriority"}},{"name":"assigned_staff_ref","in":"query","schema":{"type":"string"}},{"name":"branch_ref","in":"query","schema":{"type":"string"}},{"name":"due_before","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"due_after","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"overdue","in":"query","schema":{"type":"boolean"}},{"name":"created_from","in":"query","schema":{"type":"string","format":"date-time"}},{"name":"created_to","in":"query","schema":{"type":"string","format":"date-time"}}],"responses":{"200":{"description":"Scope-filtered task page","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskListEnvelope"}}}},"403":{"$ref":"#/components/responses/Error"}}},
      "post":{"operationId":"createCRMTask","x-permission":"vendor.crm.tasks.create","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateTaskRequest"}}}},"responses":{"201":{"description":"Task created","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskEnvelope"}}}},"400":{"$ref":"#/components/responses/Error"},"409":{"$ref":"#/components/responses/Error"}}}
    },
    "/crm/tasks/{taskId}": {
      "parameters":[{"$ref":"#/components/parameters/TaskId"}],
      "get":{"operationId":"getCRMTask","x-permission":"vendor.crm.tasks.read","responses":{"200":{"description":"Task","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskEnvelope"}}}},"404":{"$ref":"#/components/responses/Error"}}},
      "patch":{"operationId":"updateCRMTask","x-permission":"vendor.crm.tasks.manage","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateTaskRequest"}}}},"responses":{"200":{"description":"Updated task","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskEnvelope"}}}},"409":{"$ref":"#/components/responses/Error"}}}
    },
    "/crm/tasks/{taskId}/start": {"parameters":[{"$ref":"#/components/parameters/TaskId"}],"post":{"operationId":"startCRMTask","x-permission":"vendor.crm.tasks.manage","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/VersionCommand"},"responses":{"200":{"description":"Task in progress","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskEnvelope"}}}},"409":{"$ref":"#/components/responses/Error"}}}},
    "/crm/tasks/{taskId}/complete": {"parameters":[{"$ref":"#/components/parameters/TaskId"}],"post":{"operationId":"completeCRMTask","x-permission":"vendor.crm.tasks.manage","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/VersionCommand"},"responses":{"200":{"description":"Task completed","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskEnvelope"}}}},"409":{"$ref":"#/components/responses/Error"}}}},
    "/crm/tasks/{taskId}/cancel": {"parameters":[{"$ref":"#/components/parameters/TaskId"}],"post":{"operationId":"cancelCRMTask","x-permission":"vendor.crm.tasks.manage","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"$ref":"#/components/requestBodies/VersionCommand"},"responses":{"200":{"description":"Task cancelled","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskEnvelope"}}}},"409":{"$ref":"#/components/responses/Error"}}}},
    "/crm/tasks/{taskId}/reassign": {"parameters":[{"$ref":"#/components/parameters/TaskId"}],"post":{"operationId":"reassignCRMTask","x-permission":"vendor.crm.tasks.manage","parameters":[{"$ref":"#/components/parameters/IdempotencyKey"}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ReassignTaskRequest"}}}},"responses":{"200":{"description":"Task reassigned or unassigned","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskEnvelope"}}}},"409":{"$ref":"#/components/responses/Error"}}}},
    "/crm/tasks/{taskId}/history": {"parameters":[{"$ref":"#/components/parameters/TaskId"}],"get":{"operationId":"listCRMTaskHistory","x-permission":"vendor.crm.tasks.read","responses":{"200":{"description":"Immutable task activity","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskHistoryListEnvelope"}}}},"404":{"$ref":"#/components/responses/Error"}}}},
    "/crm/customers/{profileId}/tasks": {"parameters":[{"$ref":"#/components/parameters/ProfileId"}],"get":{"operationId":"listCustomerCRMTasks","x-permission":"vendor.crm.tasks.read","parameters":[{"$ref":"#/components/parameters/Limit"},{"$ref":"#/components/parameters/Offset"}],"responses":{"200":{"description":"Scope-filtered customer tasks","content":{"application/json":{"schema":{"$ref":"#/components/schemas/TaskListEnvelope"}}}},"404":{"$ref":"#/components/responses/Error"}}}}
  },
  "components": {
    "securitySchemes":{"BearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}},
    "parameters": {
      "IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":1}},
      "Limit":{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":200,"default":50}},
      "Offset":{"name":"offset","in":"query","schema":{"type":"integer","minimum":0,"default":0}},
      "InteractionId":{"name":"interactionId","in":"path","required":true,"schema":{"type":"string"}},
      "TaskId":{"name":"taskId","in":"path","required":true,"schema":{"type":"string"}},
      "ProfileId":{"name":"profileId","in":"path","required":true,"schema":{"type":"string"}}
    },
    "requestBodies":{"VersionCommand":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VersionCommandRequest"}}}}},
    "responses":{"Error":{"description":"Established Vendor error envelope","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ErrorEnvelope"}}}}},
    "schemas": {
      "InteractionType":{"type":"string","enum":["NOTE","PHONE_CALL","IN_PERSON","EMAIL","SMS","IN_APP","SOCIAL","SALES_FOLLOW_UP","SERVICE_FOLLOW_UP","FEEDBACK","ACCOUNT_REVIEW","OTHER"]},
      "InteractionDirection":{"type":"string","enum":["INBOUND","OUTBOUND","INTERNAL","NOT_APPLICABLE"]},
      "InteractionOutcome":{"type":"string","enum":["NONE","SUCCESSFUL","NO_RESPONSE","FOLLOW_UP_REQUIRED","RESOLVED","UNRESOLVED","CUSTOMER_DECLINED","VENDOR_DECLINED","ESCALATED","CANCELLED"]},
      "VisibilityScope":{"type":"string","enum":["BUSINESS","BRANCH"]},
      "TaskStatus":{"type":"string","enum":["OPEN","IN_PROGRESS","COMPLETED","CANCELLED"]},
      "TaskPriority":{"type":"string","enum":["LOW","NORMAL","HIGH","URGENT"]},
      "ActivityErrorCode":{"type":"string","enum":["CRM_INTERACTION_NOT_FOUND","CRM_INTERACTION_SCOPE_DENIED","CRM_INTERACTION_IMMUTABLE","CRM_NOTE_TOO_LONG","CRM_NOTE_INVALID","CRM_TASK_NOT_FOUND","CRM_TASK_SCOPE_DENIED","CRM_TASK_INVALID_STATE_TRANSITION","CRM_TASK_ASSIGNEE_INVALID","CRM_TASK_VERSION_CONFLICT","CRM_TASK_ALREADY_COMPLETED","CRM_TASK_ALREADY_CANCELLED","CRM_PROFILE_REDACTED","CRM_PROFILE_MERGED","CRM_IDEMPOTENCY_CONFLICT"]},
      "Interaction":{"type":"object","required":["interaction_ref","customer_profile_ref","type","direction","outcome","subject","note","visibility","occurred_at","recorded_by_staff_ref","version"],"properties":{"interaction_ref":{"type":"string"},"customer_profile_ref":{"type":"string"},"branch_ref":{"type":"string"},"type":{"$ref":"#/components/schemas/InteractionType"},"direction":{"$ref":"#/components/schemas/InteractionDirection"},"outcome":{"$ref":"#/components/schemas/InteractionOutcome"},"subject":{"type":"string","maxLength":200},"note":{"type":"string","maxLength":5000,"description":"Plain text only; never rendered as HTML."},"visibility":{"$ref":"#/components/schemas/VisibilityScope"},"occurred_at":{"type":"string","format":"date-time"},"recorded_by_staff_ref":{"type":"string"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"version":{"type":"integer","format":"int64"}}},
      "InteractionRevision":{"type":"object","required":["revision_ref","version","subject","note","outcome","occurred_at","changed_by_staff_ref","created_at"],"properties":{"revision_ref":{"type":"string"},"version":{"type":"integer","format":"int64"},"subject":{"type":"string"},"note":{"type":"string"},"outcome":{"$ref":"#/components/schemas/InteractionOutcome"},"occurred_at":{"type":"string","format":"date-time"},"correction_reason":{"type":"string","maxLength":500},"changed_by_staff_ref":{"type":"string"},"created_at":{"type":"string","format":"date-time"}}},
      "Task":{"type":"object","required":["task_ref","customer_profile_ref","visibility","title","description","status","priority","created_by_staff_ref","is_overdue","version"],"properties":{"task_ref":{"type":"string"},"customer_profile_ref":{"type":"string"},"branch_ref":{"type":"string"},"visibility":{"$ref":"#/components/schemas/VisibilityScope"},"title":{"type":"string","maxLength":200},"description":{"type":"string","maxLength":5000,"description":"Plain text only."},"status":{"$ref":"#/components/schemas/TaskStatus"},"priority":{"$ref":"#/components/schemas/TaskPriority"},"assigned_staff_ref":{"type":"string"},"assignee_active":{"type":"boolean"},"created_by_staff_ref":{"type":"string"},"due_at":{"type":"string","format":"date-time"},"completed_at":{"type":"string","format":"date-time"},"cancelled_at":{"type":"string","format":"date-time"},"source_interaction_ref":{"type":"string"},"is_overdue":{"type":"boolean","readOnly":true},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"version":{"type":"integer","format":"int64"}}},
      "TaskHistory":{"type":"object","required":["history_ref","action","status","priority","title","description","version","occurred_at"],"properties":{"history_ref":{"type":"string"},"action":{"type":"string","enum":["CREATED","UPDATED","STARTED","COMPLETED","CANCELLED","REASSIGNED","PRIVACY_SUPPRESSED"]},"status":{"$ref":"#/components/schemas/TaskStatus"},"priority":{"$ref":"#/components/schemas/TaskPriority"},"assigned_staff_ref":{"type":"string"},"due_at":{"type":"string","format":"date-time"},"title":{"type":"string"},"description":{"type":"string"},"version":{"type":"integer","format":"int64"},"changed_by_staff_ref":{"type":"string"},"occurred_at":{"type":"string","format":"date-time"}}},
      "CreateInteractionRequest":{"type":"object","additionalProperties":false,"required":["customer_profile_ref","type","direction","subject","visibility"],"properties":{"customer_profile_ref":{"type":"string"},"branch_ref":{"type":"string"},"type":{"$ref":"#/components/schemas/InteractionType"},"direction":{"$ref":"#/components/schemas/InteractionDirection"},"outcome":{"$ref":"#/components/schemas/InteractionOutcome"},"subject":{"type":"string","maxLength":200},"note":{"type":"string","maxLength":5000},"visibility":{"$ref":"#/components/schemas/VisibilityScope"},"occurred_at":{"type":"string","format":"date-time"}}},
      "CorrectInteractionRequest":{"type":"object","additionalProperties":false,"required":["correction_reason","expected_version"],"properties":{"subject":{"type":"string","maxLength":200},"note":{"type":"string","maxLength":5000},"outcome":{"$ref":"#/components/schemas/InteractionOutcome"},"occurred_at":{"type":"string","format":"date-time"},"correction_reason":{"type":"string","maxLength":500},"expected_version":{"type":"integer","format":"int64","minimum":1}}},
      "CreateTaskRequest":{"type":"object","additionalProperties":false,"required":["customer_profile_ref","visibility","title"],"properties":{"customer_profile_ref":{"type":"string"},"branch_ref":{"type":"string"},"visibility":{"$ref":"#/components/schemas/VisibilityScope"},"title":{"type":"string","maxLength":200},"description":{"type":"string","maxLength":5000},"priority":{"$ref":"#/components/schemas/TaskPriority"},"assigned_staff_ref":{"type":"string"},"due_at":{"type":"string","format":"date-time"},"source_interaction_ref":{"type":"string"}}},
      "UpdateTaskRequest":{"type":"object","additionalProperties":false,"required":["expected_version"],"properties":{"title":{"type":"string","maxLength":200},"description":{"type":"string","maxLength":5000},"priority":{"$ref":"#/components/schemas/TaskPriority"},"due_at":{"type":"string","format":"date-time"},"clear_due_at":{"type":"boolean"},"expected_version":{"type":"integer","format":"int64","minimum":1}}},
      "VersionCommandRequest":{"type":"object","additionalProperties":false,"required":["expected_version"],"properties":{"expected_version":{"type":"integer","format":"int64","minimum":1}}},
      "ReassignTaskRequest":{"type":"object","additionalProperties":false,"required":["expected_version"],"properties":{"assigned_staff_ref":{"type":"string","description":"Omit or send an empty value to unassign."},"expected_version":{"type":"integer","format":"int64","minimum":1}}},
      "Pagination":{"type":"object","required":["limit","offset","has_more"],"properties":{"limit":{"type":"integer"},"offset":{"type":"integer"},"has_more":{"type":"boolean"}}},
      "InteractionEnvelope":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"$ref":"#/components/schemas/Interaction"}}},
      "InteractionListEnvelope":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/Interaction"}},"pagination":{"$ref":"#/components/schemas/Pagination"}}}}},
      "InteractionRevisionListEnvelope":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/InteractionRevision"}}}}}},
      "TaskEnvelope":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"$ref":"#/components/schemas/Task"}}},
      "TaskListEnvelope":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/Task"}},"pagination":{"$ref":"#/components/schemas/Pagination"}}}}},
      "TaskHistoryListEnvelope":{"type":"object","properties":{"success":{"type":"boolean"},"data":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/TaskHistory"}}}}}},
      "ErrorEnvelope":{"type":"object","properties":{"success":{"type":"boolean","enum":[false]},"error":{"type":"object","properties":{"code":{"type":"string"},"message":{"type":"string"},"details":{"type":"object","properties":{"code":{"$ref":"#/components/schemas/ActivityErrorCode"}}}}}}}
    }
  }
}
