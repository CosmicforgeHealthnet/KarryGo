            }
          }
        }
      }
    },
    "schemas": {
      "EmptyCommand": {
        "type": "object",
        "additionalProperties": false,
        "description": "No body fields. The command's subject comes from the path and its actor from the verified caller."
      },
      "Error": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "RankingWeightUpdate": {
        "type": "object",
        "additionalProperties": false,
        "description": "Every field is optional; an omitted weight is left unchanged. max_non_text_boost must stay strictly below exact_name_weight, and commercial/promotion weight must not exceed max_non_text_boost.",
        "properties": {
          "exact_name_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "prefix_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "full_text_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "alias_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "synonym_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "category_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "tag_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "brand_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "identifier_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "measurement_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "typo_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "availability_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "serviceability_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "trust_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "reliability_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "distance_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "commercial_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "promotion_weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "max_non_text_boost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "max_typo_distance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "max_candidates": {
            "type": "integer",
            "minimum": 50,
            "maximum": 2000
          }
        }
      },
      "RebuildRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "FULL",
              "BUSINESS",
              "BRANCH"
            ],
            "description": "Omitted or FULL allocates a new generation; a narrower scope enqueues a scoped job."
          },
          "scope_ref": {
            "type": "string",
            "maxLength": 200,
            "description": "Business or branch reference for a scoped rebuild."
          }
        }
      },
      "SuccessEnvelope": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
