{
  "openapi": "3.0.3",
  "info": {
    "title": "KarryGo Vendor Service - Section 13 Search Ranking and Projection Administration",
    "version": "1.0.0",
    "description": "Section 13 ranking profile administration and search projection generation lifecycle: rebuild request, generation inspection, retry, activation, retirement, dead-letter replay and bounded health. Generation lifecycle is BUILDING -> READY -> ACTIVE -> RETIRED, with FAILED reachable from BUILDING; only READY may become ACTIVE and a failed build can never replace the live generation. Ranking administration is bounded configuration, not advertising: there is no campaign, budget or auction, and commercial boost is capped strictly below exact-name relevance."
  },
  "servers": [
    {
      "url": "/internal/vendor/v1"
    }
  ],
  "security": [
    {
      "hmacV2": []
    }
  ],
  "paths": {
    "/search/projection-health": {
      "get": {
        "operationId": "get_internal_vendor_v1_search_projection_health",
        "summary": "Read projection and cache health",
        "description": "Bounded operational health for both namespaces: active generation and status, cache revision, document and processed counts, generation state counts and job backlog. Cache availability is reported SEPARATELY from search health, because Redis being unreachable degrades latency without making search incorrect - every engine reads through to the PostgreSQL projection.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Service-Name",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Verified calling service identity."
          },
          {
            "in": "header",
            "name": "X-Service-Timestamp",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unix seconds; rejected outside the verifier's skew window."
          },
          {
            "in": "header",
            "name": "X-Service-Nonce",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Consumed exactly once against vendor_service_nonces; a replay is rejected."
          },
          {
            "in": "header",
            "name": "X-Service-Signature",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "HMAC-SHA256 over version, caller, method, request URI, timestamp, nonce and body digest."
          },
          {
            "in": "header",
            "name": "X-Service-Signature-Version",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Signature version. Must be v2."
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
