{
  "openapi": "3.0.3",
  "info": {
    "title": "KarryGo Vendor Service - Customer Cart",
    "version": "17A",
    "description": "Customer cart foundation. Customer identity is derived from the Customer Service bearer token."
  },
  "servers": [
    {
      "url": "/api/v1/commerce"
    }
  ],
  "security": [
    {
      "CustomerBearer": []
    }
  ],
  "paths": {
    "/carts": {
      "post": {
        "operationId": "createOrGetActiveCustomerCart",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "responses": {
          "200": { "description": "Active cart" }
        }
      }
    },
    "/carts/{cartId}": {
      "get": {
        "operationId": "getCustomerCart",
        "parameters": [
          { "$ref": "#/components/parameters/CartId" }
        ],
        "responses": {
          "200": { "description": "Customer-owned cart" },
          "404": { "description": "Cart not found" }
        }
      }
    },
    "/carts/{cartId}/groups": {
      "get": {
        "operationId": "getGroupedShopCart",
        "parameters": [
          { "$ref": "#/components/parameters/CartId" }
        ],
        "responses": {
          "200": { "description": "Shop grouping" }
        }
      }
    },
    "/carts/{cartId}/items": {
      "post": {
        "operationId": "addCustomerCartItem",
        "description": "Shop lines may carry substitution_policy (EXACT_ONLY default, AUTO_REFUND, CONTACT_FIRST, VENDOR_SUGGEST_AND_APPROVE). It is copied into checkout, bound into the quote fingerprint and frozen on the order. Food lines accept only EXACT_ONLY.",
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["item_ref", "quantity"],
                "additionalProperties": false,
                "properties": {
                  "item_ref": { "type": "string" },
                  "variant_ref": { "type": "string" },
                  "menu_ref": { "type": "string" },
                  "listing_ref": { "type": "string" },
                  "sell_unit_ref": { "type": "string" },
                  "size_ref": { "type": "string" },
                  "quantity": { "type": "integer", "format": "int64", "minimum": 1 },
                  "requested_measure_ref": { "type": "string" },
                  "expected_measure_quantity": { "type": "integer", "format": "int64" },
                  "pricing_basis": { "type": "string" },
                  "substitution_policy": { "type": "string", "enum": ["EXACT_ONLY", "AUTO_REFUND", "CONTACT_FIRST", "VENDOR_SUGGEST_AND_APPROVE"] },
                  "options": { "type": "array", "items": { "type": "object", "properties": { "group_ref": { "type": "string" }, "option_ref": { "type": "string" }, "quantity": { "type": "integer", "format": "int64" } } } }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated cart" },
          "400": { "description": "Invalid item, quantity or substitution policy" }
        }
      },
      "delete": {
        "operationId": "clearCustomerCart",
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "responses": {
          "200": { "description": "Cleared cart" }
        }
      }
    },
    "/carts/{cartId}/items/{itemId}": {
      "patch": {
        "operationId": "updateCustomerCartItemQuantity",
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/ItemId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "responses": {
          "200": { "description": "Updated cart" }
        }
      },
      "delete": {
        "operationId": "removeCustomerCartItem",
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/ItemId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "responses": {
          "200": { "description": "Updated cart" }
        }
      }
    },
    "/carts/{cartId}/delivery-address": {
      "put": {
        "operationId": "setCustomerCartDeliveryAddress",
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "responses": {
          "200": { "description": "Updated cart" }
        }
      },
      "delete": {
        "operationId": "removeCustomerCartDeliveryAddress",
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "responses": {
          "200": { "description": "Updated cart" }
        }
      }
    },
    "/carts/{cartId}/receiver": {
      "put": {
        "operationId": "setCustomerCartReceiver",
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "responses": {
          "200": { "description": "Updated cart" }
        }
      },
      "delete": {
        "operationId": "removeCustomerCartReceiver",
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "responses": {
          "200": { "description": "Updated cart" }
        }
      }
    },
    "/carts/{cartId}/abandon": {
      "post": {
        "operationId": "abandonCustomerCart",
        "parameters": [
          { "$ref": "#/components/parameters/CartId" },
          { "$ref": "#/components/parameters/IdempotencyKey" },
          { "$ref": "#/components/parameters/IfMatch" }
        ],
        "responses": {
          "200": { "description": "Abandoned cart" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CustomerBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "CartId": {
        "name": "cartId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "ItemId": {
        "name": "itemId",
        "in": "path",
        "required": true,
        "schema": { "type": "string" }
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string" }
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": { "type": "string" }
      }
    }
  }
}