              "type": "string",
              "enum": [
                "FOOD_ITEM",
                "SHOP_PRODUCT",
                "SHOP_VARIANT"
              ]
            },
            "description": "Bounded vendor source vocabulary. The type decides the namespace, so a Food type is never classifiable inside SHOP."
          },
          {
            "in": "query",
            "name": "source_ref",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Identifier of the vendor's own catalogue resource. Ownership is resolved from the owning catalogue table; another vendor's reference returns 404."
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded successful response",
            "content": {
