      "put": {
        "operationId": "put_api_v1_vendor_taxonomy_namespaces_namespaceCode_mappings",
        "summary": "Replace the facet mappings of an owned resource",
        "description": "Idempotent replacement of every mapping a resource holds inside one facet. business_ref and branch_ref are NOT accepted in the body: the server resolves them from the source resource's authoritative ownership, and sending them is a 400.",
        "parameters": [
          {
            "in": "path",
            "name": "namespaceCode",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "FOOD",
                "SHOP"
              ]
            },
            "description": "Canonical namespace. FOOD and SHOP are separate vocabularies; an identifier from one is never resolvable through the other."
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Command reference for idempotent replay."
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded successful response",
            "content": {
              "application/json": {
                "schema": {
