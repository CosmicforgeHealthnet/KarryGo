{
  "openapi": "3.0.3",
  "info": {
    "title": "KarryGo Vendor Service - Section 13 Vendor Taxonomy",
    "version": "1.0.0",
    "description": "Section 13 vendor-facing canonical taxonomy classification. A vendor reads the published taxonomy and manages the classification of resources inside their own vendor/business/branch scope. Every source-addressed operation resolves ownership from the owning catalogue table; business_ref and branch_ref are never taken from the request. Global taxonomy authoring and publication are NOT here - they are platform capabilities on the internal HMAC-v2 surface. Requires vendor.taxonomy.read; mapping replacement requires vendor.taxonomy.mapping.manage."
  },
  "servers": [
    {
      "url": "/api/v1/vendor"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/taxonomy/namespaces/{namespaceCode}/classifications": {
      "get": {
        "operationId": "get_api_v1_vendor_taxonomy_namespaces_namespaceCode_classifications",
        "summary": "Read the full classification of one owned resource",
        "description": "Mappings, semantic tag assignments and dietary claim assignments for one of the caller's own catalogue resources, in one response.",
        "parameters": [
          {
            "in": "path",
            "name": "namespaceCode",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "FOOD",
                "SHOP"
              ]
            },
            "description": "Canonical namespace. FOOD and SHOP are separate vocabularies; an identifier from one is never resolvable through the other."
          },
          {
            "in": "query",
            "name": "source_type",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "FOOD_ITEM",
                "SHOP_PRODUCT",
                "SHOP_VARIANT"
              ]
            },
            "description": "Bounded vendor source vocabulary. The type decides the namespace, so a Food type is never classifiable inside SHOP."
          },
          {
            "in": "query",
            "name": "source_ref",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "description": "Identifier of the vendor's own catalogue resource. Ownership is resolved from the owning catalogue table; another vendor's reference returns 404."
          }
        ],
        "responses": {
          "200": {
            "description": "Bounded successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
