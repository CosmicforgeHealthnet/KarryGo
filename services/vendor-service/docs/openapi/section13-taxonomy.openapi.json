  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      },
      "hmacV2": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Signature"
      }
    },
    "responses": {
      "Error": {
        "description": "Stable platform error envelope",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "EmptyCommand": {
        "type": "object",
        "additionalProperties": false,
        "description": "No body fields. The command's subject comes from the path and its actor from the verified caller."
      },
      "Error": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "MappingCandidate": {
        "type": "object",
        "required": [
          "node_code",
          "mapping_type"
        ],
        "additionalProperties": false,
        "properties": {
          "node_code": {
            "type": "string",
            "maxLength": 200
          },
          "mapping_type": {
            "type": "string",
            "enum": [
              "PRIMARY",
              "SECONDARY",
              "DERIVED"
            ]
          },
          "confidence_basis": {
            "type": "string",
            "enum": [
              "MANUAL",
              "RULE",
              "INFERRED"
            ]
          },
          "confidence_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "ReplaceFacetMappingsRequest": {
        "type": "object",
        "required": [
          "facet_code",
          "source_type",
          "source_ref",
          "mappings"
        ],
        "additionalProperties": false,
        "description": "business_ref and branch_ref are deliberately absent. Unknown fields are rejected, so an attempt to supply either is a 400 rather than a silently ignored field.",
        "properties": {
          "facet_code": {
            "type": "string",
            "maxLength": 200
          },
          "source_type": {
            "type": "string",
            "enum": [
              "FOOD_ITEM",
              "SHOP_PRODUCT",
              "SHOP_VARIANT"
            ]
          },
          "source_ref": {
            "type": "string",
            "maxLength": 200
          },
          "mappings": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/MappingCandidate"
            }
          }
        }
      },
      "SuccessEnvelope": {
        "type": "object",
        "required": [
          "success",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "data": {
            "type": "object"
          }
        }
      }
    }
  }
}
