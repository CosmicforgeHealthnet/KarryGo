  "info": {
    "description": "Section 12B authoritative vendor-owned inventory, reservations, stock operations, preorder/backorder, variable fulfilment and effective discovery. Physical stock never becomes negative. Expired or quarantined lots are not sellable. Approximate calibration is never exact reservation arithmetic. No Customer PII, Order authority, Wallet/payment, logistics execution or KarryGo dark-store inventory is implemented.",
    "title": "KarryGo Vendor Service — Section 12 Internal Shop Contract",
    "version": "1.0.0"
  },
  "openapi": "3.0.3",
