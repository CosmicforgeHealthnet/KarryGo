          "format": "int64"
         },
         "length_mm": {
          "type": "integer",
          "format": "int64"
         },
         "width_mm": {
          "type": "integer",
          "format": "int64"
         },
         "height_mm": {
          "type": "integer",
          "format": "int64"
         },
         "fragile": {
          "type": "boolean"
         },
         "temperature_control": {
          "type": "string",
          "enum": [
           "NONE",
           "CHILLED",
           "FROZEN",
           "HOT"
          ]
         }
        }
       }
      }
     }
    },
