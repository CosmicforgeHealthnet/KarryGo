     "200": {
      "description": "Success.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "success",
          "data"
         ],
         "properties": {
          "success": {
           "type": "boolean"
          },
          "data": {
           "$ref": "#/components/schemas/Parcel"
          }
         }
        }
       }
      }
