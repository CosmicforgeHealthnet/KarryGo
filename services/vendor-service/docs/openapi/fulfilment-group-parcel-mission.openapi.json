     "reason_code": {
      "type": "string",
      "enum": [
       "INITIAL_PLAN",
       "OWN_RIDER_FIRST",
       "DISTANCE_OVERFLOW",
       "TIME_OVERFLOW",
       "CAPACITY_OVERFLOW",
       "VEHICLE_OVERFLOW",
       "SLA_OVERFLOW",
       "PROVIDER_UNAVAILABLE",
       "VENDOR_UNAVAILABLE",
       "CUSTOMER_APPROVED_CHANGE",
       "MISSION_REPLACED",
       "RETURN",
       "TRANSFER"
