      "schema": {
       "type": "string"
      }
     },
     {
      "name": "Idempotency-Key",
      "in": "header",
      "required": true,
      "description": "Stable operation identity. The same key returns the same result rather than producing a second one.",
      "schema": {
       "type": "string"
      }
     }
    ],
    "requestBody": {
