      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "status"
        ],
        "properties": {
         "status": {
          "type": "string",
          "enum": [
           "PLANNED",
           "ASSIGNED",
           "READY_FOR_PICKUP",
           "CUSTODY_TRANSFERRED",
           "OUT_FOR_DELIVERY",
           "DELIVERED",
           "FAILED",
           "RETURN_REQUIRED",
           "RETURNED"
          ]
         },
         "handover_ref": {
          "type": "string"
         },
         "proof_ref": {
          "type": "string"
         },
