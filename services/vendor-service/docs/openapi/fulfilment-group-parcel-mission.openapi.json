      "type": "string"
     },
     "fulfilment_group_id": {
      "type": "string"
     },
     "parent_order_id": {
      "type": "string"
     },
     "vendor_order_id": {
      "type": "string"
     },
     "business_id": {
      "type": "string"
     },
     "branch_id": {
      "type": "string"
     },
     "pickup_address": {
      "type": "string"
     },
     "service_class": {
      "type": "string"
     },
     "vehicle_class": {
      "type": "string"
     },
     "required_weight_grams": {
      "type": "integer",
      "format": "int64"
     },
     "required_package_count": {
      "type": "integer",
      "format": "int64"
     },
