     "status_source_ref": {
      "type": "string"
     },
     "status_updated_at": {
      "type": "string",
      "format": "date-time"
     },
     "refusal_code": {
      "type": "string"
     },
     "failure_reason": {
      "type": "string"
     },
     "replaces_id": {
      "type": "string"
     },
     "replacement_reason": {
      "type": "string"
     },
     "version": {
      "type": "integer",
      "format": "int64"
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     },
     "updated_at": {
      "type": "string",
      "format": "date-time"
     },
     "linked_at": {
      "type": "string",
      "format": "date-time"
     }
    }
