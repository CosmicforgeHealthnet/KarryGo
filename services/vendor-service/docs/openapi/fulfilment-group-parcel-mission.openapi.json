  "/vendor/fulfilment/vendor-missions/{missionId}/status": {
   "put": {
    "summary": "Execute one step of a vendor-owned delivery",
    "description": "Each step is validated against the legal successor set: a mission cannot jump straight to delivered, and one that was never assigned cannot report a delivery at all. Custody-moving steps write the parcel custody chain in the same transaction.",
    "tags": [
     "Vendor mission"
    ],
    "security": [
     {
      "vendorStaffBearer": []
     }
    ],
    "parameters": [
     {
      "name": "missionId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
