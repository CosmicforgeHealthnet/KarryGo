  "schemas": {
   "Manifest": {
    "type": "object",
    "description": "What a parcel represented at handover. References and packed quantities, never a copy of the catalogue record. Frozen once custody moves.",
    "properties": {
     "lines": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "order_line_ref"
       ],
       "properties": {
        "order_line_ref": {
         "type": "string"
        },
        "item_ref": {
         "type": "string"
        },
        "description": {
         "type": "string"
        },
        "quantity": {
         "type": "integer",
         "format": "int64"
        },
        "unit_ref": {
         "type": "string"
        },
        "measured_quantity": {
         "type": "integer",
         "format": "int64",
         "description": "Variable-measure evidence in the unit named by unit_ref."
        }
       }
      }
     },
     "package_count": {
      "type": "integer",
      "format": "int64",
      "description": "Physical items inside this one parcel. Six sealed containers in one bag is one parcel with a package count of six."
     },
     "notes": {
      "type": "string"
     },
     "media_refs": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "special_handling_refs": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "sealed_at": {
      "type": "string",
      "format": "date-time",
      "readOnly": true,
      "description": "Set from custody evidence, never from a request body."
     }
    }
   },
   "Unit": {
    "type": "object",
    "description": "One vendor order's pickup obligation at one branch. Its relationship to the vendor order is permanent: logistics replanning never creates a new one.",
    "properties": {
