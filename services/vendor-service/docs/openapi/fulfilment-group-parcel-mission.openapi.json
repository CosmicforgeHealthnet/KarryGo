{
 "openapi": "3.0.3",
 "info": {
  "title": "Vendor Service Fulfilment Group, Parcel and Mission Model",
  "version": "1.0",
  "description": "The post-order operational fulfilment aggregate: the FulfilmentGroup rooted on one CommerceOrder, the FulfilmentUnits inside it, the Parcels that physically move, the versioned FulfilmentPlan history, the projections of platform logistics missions, and the VendorMissions this service genuinely owns.\n\nTwo authority rules govern this surface. VendorMission is CANONICAL here, and only for vendor-owned delivery. PlatformMissionRef is a PROJECTION: Dispatch, Hauling and Taxi each remain the authority for their own missions, so no route here creates a platform mission, sets its status, or chooses its canonical reference.\n\npayment-wallet-service remains the financial authority. A plan version stores a planned-cost snapshot as evidence; nothing here creates a hold, a settlement or a refund."
 },
 "servers": [
  {
   "url": "/api/v1"
  }
 ],
 "tags": [
  {
   "name": "Fulfilment group",
   "description": "The enduring planning root for one commerce order."
  },
  {
   "name": "Fulfilment unit",
   "description": "One vendor order's pickup obligation at one branch."
  },
  {
   "name": "Parcel",
   "description": "The stable, traceable physical package."
  },
  {
   "name": "Fulfilment plan",
   "description": "Append-only versioned planning decisions."
  },
  {
   "name": "Vendor mission",
   "description": "Vendor-owned delivery, canonical in this service."
  },
  {
   "name": "Return",
   "description": "A returned parcel is the same parcel."
  }
 ],
 "paths": {
  "/vendor/fulfilment/groups/{groupId}": {
   "get": {
    "summary": "Read one order's fulfilment",
    "description": "Returns the group, the plan currently in force, the platform mission projections, the acting vendor's own delivery missions and any returns. In a shared order, only the acting vendor's units and parcels are returned.",
    "tags": [
     "Fulfilment group"
    ],
    "security": [
     {
      "vendorStaffBearer": []
     }
    ],
    "parameters": [
     {
      "name": "groupId",
      "in": "path",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "Success.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "required": [
          "success",
          "data"
         ],
         "properties": {
          "success": {
           "type": "boolean"
          },
          "data": {
           "$ref": "#/components/schemas/GroupView"
          }
         }
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Unauthorized"
     },
     "403": {
      "$ref": "#/components/responses/Forbidden"
     },
     "404": {
      "$ref": "#/components/responses/NotFound"
     }
    }
   }
  },
