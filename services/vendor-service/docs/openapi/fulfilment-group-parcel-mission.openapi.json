       "NOT_READY",
       "PACKING",
       "READY",
       "COLLECTED",
       "CANCELLED"
      ]
     },
     "version": {
      "type": "integer",
      "format": "int64"
     },
     "created_at": {
      "type": "string",
      "format": "date-time"
     },
     "updated_at": {
      "type": "string",
      "format": "date-time"
     }
    }
   },
   "Parcel": {
