{
  "openapi": "3.0.3",
  "info": {"title": "KarryGo Vendor Onboarding API", "version": "7.0.0", "description": "Section 7 onboarding, KYB, authoritative verification projections, document references, masked bank profile, deterministic readiness and activation."},
  "servers": [{"url": "/api/v1/vendor"}],
  "x-feature-flags": {"service": "VENDOR_SERVICE_ENABLED", "writes": "VENDOR_ONBOARDING_WRITES_ENABLED", "verification": "VENDOR_VERIFICATION_INTEGRATION_ENABLED", "kill_switch": "COMMERCE_GLOBAL_KILL_SWITCH"},
  "x-list-contract": "Section 7 lists are bounded by one Vendor onboarding aggregate and intentionally have no pagination or filters.",
  "x-error-contract": "All errors use ErrorEnvelope; stable cases include validation_failed, forbidden, not_found, conflict, service_unavailable, STEP_UP_REQUIRED, VERIFICATION_SOURCE_UNAVAILABLE and EXTERNAL_DEPENDENCY_UNAVAILABLE.",
  "security": [{"bearerAuth": []}],
  "paths": {
    "/onboarding": {"get": {"operationId": "getOnboardingOverview", "x-permission": "vendor.onboarding.read", "responses": {"200": {"description": "Overview"}}}},
    "/onboarding/progress": {"get": {"operationId": "getOnboardingProgress", "x-permission": "vendor.onboarding.read", "responses": {"200": {"description": "Progress"}}}},
    "/onboarding/checklist": {"get": {"operationId": "getOnboardingChecklist", "x-permission": "vendor.onboarding.read", "responses": {"200": {"description": "Data-driven checklist"}}}},
    "/onboarding/blockers": {"get": {"operationId": "getOnboardingBlockers", "x-permission": "vendor.onboarding.read", "responses": {"200": {"description": "Activation blockers"}}}},
    "/onboarding/activation-readiness": {"get": {"operationId": "getActivationReadiness", "x-permission": "vendor.onboarding.read", "responses": {"200": {"description": "Activation readiness"}}}},
    "/onboarding/submit": {"post": {"operationId": "submitOnboarding", "x-permission": "vendor.onboarding.manage", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Onboarding submitted; does not force activation"}}}},
    "/onboarding/request-activation": {"post": {"operationId": "requestActivationEvaluation", "x-permission": "vendor.onboarding.manage", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Backend policy evaluation result"}}}},
    "/onboarding/representative": {
      "get": {"operationId": "getAuthorizedRepresentative", "x-permission": "vendor.onboarding.read", "responses": {"200": {"description": "Representative"}}},
      "put": {"operationId": "putAuthorizedRepresentative", "x-permission": "vendor.onboarding.manage", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/Representative"}, "responses": {"200": {"description": "Created or versioned update"}, "409": {"description": "Version conflict"}}}
    },
    "/onboarding/documents": {
      "get": {"operationId": "listOnboardingDocumentReferences", "x-permission": "vendor.onboarding.read", "responses": {"200": {"description": "Opaque document references"}}},
      "post": {"operationId": "attachOnboardingDocumentReference", "x-permission": "vendor.onboarding.manage", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/Document"}, "responses": {"201": {"description": "Reference attached after Media read-back"}}}
    },
    "/onboarding/documents/{documentId}": {
      "patch": {"operationId": "replaceOnboardingDocumentReference", "x-permission": "vendor.onboarding.manage", "parameters": [{"$ref": "#/components/parameters/DocumentId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/Document"}, "responses": {"200": {"description": "Draft reference replaced"}}},
      "delete": {"operationId": "removeDraftOnboardingDocumentReference", "x-permission": "vendor.onboarding.manage", "parameters": [{"$ref": "#/components/parameters/DocumentId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"200": {"description": "Draft reference removed"}}}
    },
    "/onboarding/verifications": {"get": {"operationId": "listVerificationProjections", "x-permission": "vendor.verification.read", "responses": {"200": {"description": "Authoritative projections"}}}},
    "/onboarding/verifications/{dimension}": {"get": {"operationId": "getVerificationDimension", "x-permission": "vendor.verification.read", "parameters": [{"$ref": "#/components/parameters/Dimension"}], "responses": {"200": {"description": "Dimension projections"}}}},
    "/onboarding/verifications/{dimension}/submit": {"post": {"operationId": "submitVerification", "x-permission": "vendor.verification.submit", "parameters": [{"$ref": "#/components/parameters/Dimension"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/VerificationSubmission"}, "responses": {"202": {"description": "Authoritative case submitted; pending results reconcile by client reference"}, "503": {"description": "Disabled integration writes nothing; an ambiguous configured remote call leaves a durable UNKNOWN operation for reconciliation"}}}},
    "/onboarding/verifications/{dimension}/resubmit": {"post": {"operationId": "resubmitVerification", "x-permission": "vendor.verification.submit", "parameters": [{"$ref": "#/components/parameters/Dimension"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/VerificationSubmission"}, "responses": {"202": {"description": "Remediation case submitted"}}}},
    "/onboarding/bank-profile": {
      "get": {"operationId": "getMaskedBankProfile", "x-permission": "vendor.bank_profile.read", "responses": {"200": {"description": "Masked Wallet-owned profile"}}},
      "put": {"operationId": "replaceBankProfile", "x-permission": "vendor.bank_profile.manage", "x-step-up-purpose": "finance.bank_change", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"$ref": "#/components/requestBodies/BankProfile"}, "responses": {"200": {"description": "Resolved Wallet projection"}, "403": {"description": "Step-up required"}}}
    },
    "/internal/vendor/v1/verification-events": {"post": {"operationId": "ingestVerificationEvent", "servers": [{"url": "/"}], "security": [{"serviceHmacV2": []}], "x-permission": "verification-compliance-service only", "x-replay-protection": "X-Service-Nonce plus event_id", "requestBody": {"$ref": "#/components/requestBodies/VerificationEvent"}, "responses": {"200": {"description": "Source-versioned projection applied or duplicate replay acknowledged"}, "409": {"description": "Stale source version"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}, "serviceHmacV2": {"type": "apiKey", "in": "header", "name": "X-Service-Signature"}},
    "parameters": {
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string"}},
      "DocumentId": {"name": "documentId", "in": "path", "required": true, "schema": {"type": "string"}},
      "Dimension": {"name": "dimension", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/VerificationDimension"}}
    },
    "schemas": {
      "VerificationDimension": {"type": "string", "enum": ["IDENTITY", "BUSINESS", "BANK", "LOCATION", "BRAND", "FOOD_KITCHEN"]},
      "VerificationStatus": {"type": "string", "enum": ["NOT_STARTED", "IN_PROGRESS", "PENDING_REVIEW", "VERIFIED", "REJECTED", "EXPIRED", "SUSPENDED"]},
      "SubjectType": {"type": "string", "enum": ["BUSINESS", "REPRESENTATIVE", "BRANCH", "BRAND", "CAPABILITY", "BRANCH_CAPABILITY"]},
      "Representative": {"type": "object", "required": ["id", "business_id", "capacity", "first_name", "last_name", "email", "phone", "authorized", "active", "version"], "properties": {"id": {"type": "string"}, "business_id": {"type": "string", "readOnly": true}, "capacity": {"type": "string", "enum": ["OWNER", "DIRECTOR", "AUTHORIZED_SIGNATORY"]}, "first_name": {"type": "string"}, "last_name": {"type": "string"}, "email": {"type": "string", "format": "email"}, "phone": {"type": "string"}, "authorized": {"type": "boolean"}, "active": {"type": "boolean", "readOnly": true}, "version": {"type": "integer", "readOnly": true}}},
      "OnboardingDocument": {"type": "object", "required": ["id", "business_id", "dimension", "media_ref", "document_type", "status", "version"], "properties": {"id": {"type": "string"}, "business_id": {"type": "string", "readOnly": true}, "dimension": {"$ref": "#/components/schemas/VerificationDimension"}, "media_ref": {"type": "string", "description": "Opaque Media authority reference; never bytes or a signed URL."}, "document_type": {"type": "string"}, "status": {"type": "string", "enum": ["DRAFT", "SUBMITTED", "SUPERSEDED"]}, "version": {"type": "integer"}}},
      "VerificationProjection": {"type": "object", "required": ["id", "business_id", "dimension", "subject_type", "subject_ref", "source_service", "source_ref", "source_version", "status", "observed_at", "version"], "properties": {"dimension": {"$ref": "#/components/schemas/VerificationDimension"}, "subject_type": {"$ref": "#/components/schemas/SubjectType"}, "status": {"$ref": "#/components/schemas/VerificationStatus"}, "source_service": {"type": "string", "readOnly": true}, "source_ref": {"type": "string", "readOnly": true}, "source_version": {"type": "integer", "readOnly": true}, "observed_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time", "nullable": true}, "reason_code": {"type": "string"}, "remediation": {"type": "string"}, "version": {"type": "integer"}}},
      "ActivationReadiness": {"type": "object", "required": ["ready", "progress_percent", "requirements", "blockers"], "properties": {"ready": {"type": "boolean"}, "progress_percent": {"type": "integer", "minimum": 0, "maximum": 100}, "requirements": {"type": "array", "items": {"type": "object"}}, "blockers": {"type": "array", "items": {"type": "object"}}}},
      "MaskedBankProfile": {"type": "object", "required": ["business_id", "external_ref", "bank_code", "masked_account", "resolved_account_name", "source_version", "status", "observed_at", "version"], "properties": {"business_id": {"type": "string"}, "external_ref": {"type": "string"}, "bank_code": {"type": "string"}, "masked_account": {"type": "string"}, "resolved_account_name": {"type": "string"}, "source_version": {"type": "integer"}, "status": {"$ref": "#/components/schemas/VerificationStatus"}, "observed_at": {"type": "string", "format": "date-time"}, "version": {"type": "integer"}}},
      "SuccessEnvelope": {"type": "object", "required": ["success", "data"], "properties": {"success": {"type": "boolean", "enum": [true]}, "data": {"type": "object"}}},
      "ErrorEnvelope": {"type": "object", "required": ["success", "error"], "properties": {"success": {"type": "boolean", "enum": [false]}, "error": {"type": "object", "required": ["code", "message", "request_id"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "request_id": {"type": "string"}, "fields": {"type": "array", "items": {"type": "object"}}}}}
    },
    "requestBodies": {
      "Representative": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["capacity", "first_name", "last_name", "email", "phone", "authorized", "expected_version"], "properties": {"capacity": {"type": "string", "enum": ["OWNER", "DIRECTOR", "AUTHORIZED_SIGNATORY"]}, "first_name": {"type": "string"}, "last_name": {"type": "string"}, "email": {"type": "string", "format": "email"}, "phone": {"type": "string"}, "ownership_percent": {"type": "number", "minimum": 0, "maximum": 100}, "authorized": {"type": "boolean"}, "step_up_grant_id": {"type": "string", "writeOnly": true}, "expected_version": {"type": "integer", "minimum": 0}}}}}},
      "Document": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["dimension", "media_ref", "document_type", "expected_version"], "properties": {"representative_id": {"type": "string"}, "branch_id": {"type": "string"}, "brand_id": {"type": "string"}, "dimension": {"$ref": "#/components/schemas/VerificationDimension"}, "media_ref": {"type": "string"}, "document_type": {"type": "string"}, "expected_version": {"type": "integer", "minimum": 0}}}}}},
      "VerificationSubmission": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["subject_type", "subject_ref", "document_refs"], "properties": {"subject_type": {"$ref": "#/components/schemas/SubjectType"}, "subject_ref": {"type": "string"}, "document_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}}},
      "BankProfile": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["account_number", "bank_code", "step_up_grant_id", "expected_version"], "properties": {"account_number": {"type": "string", "writeOnly": true}, "bank_code": {"type": "string"}, "step_up_grant_id": {"type": "string", "writeOnly": true}, "expected_version": {"type": "integer", "minimum": 0}}}}}},
      "VerificationEvent": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["event_id", "business_id", "dimension", "subject_type", "subject_ref", "source_ref", "source_version", "status", "observed_at"]}}}}
    }
  }
}
}
