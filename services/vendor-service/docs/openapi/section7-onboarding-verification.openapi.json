{
  "components": {
    "parameters": {
      "Dimension": {
        "in": "path",
        "name": "dimension",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/VerificationDimension"
        }
      },
      "DocumentId": {
        "in": "path",
        "name": "documentId",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "requestBodies": {
      "BankProfile": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "account_number": {
                  "type": "string",
                  "writeOnly": true
                },
                "bank_code": {
                  "type": "string"
                },
                "expected_version": {
                  "minimum": 0,
                  "type": "integer"
                },
                "step_up_grant_id": {
                  "type": "string",
                  "writeOnly": true
                }
              },
              "required": [
                "account_number",
                "bank_code",
                "step_up_grant_id",
                "expected_version"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "Document": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "branch_id": {
                  "type": "string"
                },
                "brand_id": {
                  "type": "string"
                },
                "dimension": {
                  "$ref": "#/components/schemas/VerificationDimension"
                },
                "document_type": {
                  "type": "string"
                },
                "expected_version": {
                  "minimum": 0,
                  "type": "integer"
                },
                "media_ref": {
                  "type": "string"
                },
                "representative_id": {
                  "type": "string"
                }
              },
              "required": [
                "dimension",
                "media_ref",
                "document_type",
                "expected_version"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "Representative": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "authorized": {
                  "type": "boolean"
                },
                "capacity": {
                  "enum": [
                    "OWNER",
                    "DIRECTOR",
                    "AUTHORIZED_SIGNATORY"
                  ],
                  "type": "string"
                },
                "email": {
                  "format": "email",
                  "type": "string"
                },
                "expected_version": {
                  "minimum": 0,
                  "type": "integer"
                },
                "first_name": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                },
                "ownership_percent": {
                  "maximum": 100,
                  "minimum": 0,
                  "type": "number"
                },
                "phone": {
                  "type": "string"
                },
                "step_up_grant_id": {
                  "type": "string",
                  "writeOnly": true
                }
              },
              "required": [
                "capacity",
                "first_name",
                "last_name",
                "email",
                "phone",
                "authorized",
                "expected_version"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "VerificationEvent": {
        "content": {
          "application/json": {
            "schema": {
              "required": [
                "event_id",
                "business_id",
                "dimension",
                "subject_type",
                "subject_ref",
                "source_ref",
                "source_version",
                "status",
                "observed_at"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      },
      "VerificationSubmission": {
        "content": {
          "application/json": {
            "schema": {
              "properties": {
                "document_refs": {
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "subject_ref": {
                  "type": "string"
                },
                "subject_type": {
                  "$ref": "#/components/schemas/SubjectType"
                }
              },
              "required": [
                "subject_type",
                "subject_ref",
                "document_refs"
              ],
              "type": "object"
            }
          }
        },
        "required": true
      }
    },
    "schemas": {
      "ActivationReadiness": {
        "properties": {
          "blockers": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "progress_percent": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
          },
          "ready": {
            "type": "boolean"
          },
          "requirements": {
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "ready",
          "progress_percent",
          "requirements",
          "blockers"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "properties": {
              "code": {
                "type": "string"
              },
              "fields": {
                "items": {
                  "type": "object"
                },
                "type": "array"
              },
              "message": {
                "type": "string"
              },
              "request_id": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "request_id"
            ],
            "type": "object"
          },
          "success": {
            "enum": [
              false
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "error"
        ],
        "type": "object"
      },
      "MaskedBankProfile": {
        "properties": {
          "bank_code": {
            "type": "string"
          },
          "business_id": {
            "type": "string"
          },
          "external_ref": {
            "type": "string"
          },
          "masked_account": {
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "type": "string"
          },
          "resolved_account_name": {
            "type": "string"
          },
          "source_version": {
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/VerificationStatus"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "business_id",
          "external_ref",
          "bank_code",
          "masked_account",
          "resolved_account_name",
          "source_version",
          "status",
          "observed_at",
          "version"
        ],
        "type": "object"
      },
      "OnboardingDocument": {
        "properties": {
          "business_id": {
            "readOnly": true,
            "type": "string"
          },
          "dimension": {
            "$ref": "#/components/schemas/VerificationDimension"
          },
          "document_type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "media_ref": {
            "description": "Opaque Media authority reference; never bytes or a signed URL.",
            "type": "string"
          },
          "status": {
            "enum": [
              "DRAFT",
              "SUBMITTED",
              "SUPERSEDED"
            ],
            "type": "string"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "business_id",
          "dimension",
          "media_ref",
          "document_type",
          "status",
          "version"
        ],
        "type": "object"
      },
      "Representative": {
        "properties": {
          "active": {
            "readOnly": true,
            "type": "boolean"
          },
          "authorized": {
            "type": "boolean"
          },
          "business_id": {
            "readOnly": true,
            "type": "string"
          },
          "capacity": {
            "enum": [
              "OWNER",
              "DIRECTOR",
              "AUTHORIZED_SIGNATORY"
            ],
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "first_name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "version": {
            "readOnly": true,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "business_id",
          "capacity",
          "first_name",
          "last_name",
          "email",
          "phone",
          "authorized",
          "active",
          "version"
        ],
        "type": "object"
      },
      "SubjectType": {
        "enum": [
          "BUSINESS",
          "REPRESENTATIVE",
          "BRANCH",
          "BRAND",
          "CAPABILITY",
          "BRANCH_CAPABILITY"
        ],
        "type": "string"
      },
      "SuccessEnvelope": {
        "properties": {
          "data": {
            "type": "object"
          },
          "success": {
            "enum": [
              true
            ],
            "type": "boolean"
          }
        },
        "required": [
          "success",
          "data"
        ],
        "type": "object"
      },
      "VerificationDimension": {
        "enum": [
          "IDENTITY",
          "BUSINESS",
          "BANK",
          "LOCATION",
          "BRAND",
          "FOOD_KITCHEN"
        ],
        "type": "string"
      },
      "VerificationProjection": {
        "properties": {
          "dimension": {
            "$ref": "#/components/schemas/VerificationDimension"
          },
          "expires_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "observed_at": {
            "format": "date-time",
            "type": "string"
          },
          "reason_code": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "source_ref": {
            "readOnly": true,
            "type": "string"
          },
          "source_service": {
            "readOnly": true,
            "type": "string"
          },
          "source_version": {
            "readOnly": true,
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/VerificationStatus"
          },
          "subject_type": {
            "$ref": "#/components/schemas/SubjectType"
          },
          "version": {
            "type": "integer"
          }
        },
        "required": [
          "id",
          "business_id",
          "dimension",
          "subject_type",
          "subject_ref",
          "source_service",
          "source_ref",
          "source_version",
          "status",
          "observed_at",
          "version"
        ],
        "type": "object"
      },
      "VerificationStatus": {
        "enum": [
          "NOT_STARTED",
          "IN_PROGRESS",
          "PENDING_REVIEW",
          "VERIFIED",
          "REJECTED",
          "EXPIRED",
          "SUSPENDED"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      },
      "serviceHmacV2": {
        "in": "header",
        "name": "X-Service-Signature",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Section 7 onboarding, KYB, authoritative verification projections, document references, masked bank profile, deterministic readiness and activation.",
    "title": "KarryGo Vendor Onboarding API",
    "version": "7.0.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/internal/vendor/v1/verification-events": {
      "post": {
        "operationId": "ingestVerificationEvent",
        "requestBody": {
          "$ref": "#/components/requestBodies/VerificationEvent"
        },
        "responses": {
          "200": {
            "description": "Source-versioned projection applied or duplicate replay acknowledged"
          },
          "409": {
            "description": "Stale source version"
          }
        },
        "security": [
          {
            "serviceHmacV2": []
          }
        ],
        "servers": [
          {
            "url": "/"
          }
        ],
        "x-permission": "verification-compliance-service only",
        "x-replay-protection": "X-Service-Nonce plus event_id"
      }
    },
    "/onboarding": {
      "get": {
        "operationId": "getOnboardingOverview",
        "responses": {
          "200": {
            "description": "Overview"
          }
        },
        "x-permission": "vendor.onboarding.read"
      }
    },
    "/onboarding/activation-readiness": {
      "get": {
        "operationId": "getActivationReadiness",
        "responses": {
          "200": {
            "description": "Activation readiness"
          }
        },
        "x-permission": "vendor.onboarding.read"
      }
    },
    "/onboarding/bank-profile": {
      "get": {
        "operationId": "getMaskedBankProfile",
        "responses": {
          "200": {
            "description": "Masked Wallet-owned profile"
          }
        },
        "x-permission": "vendor.bank_profile.read"
      },
      "put": {
        "operationId": "replaceBankProfile",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/BankProfile"
        },
        "responses": {
          "200": {
            "description": "Resolved Wallet projection"
          },
          "403": {
            "description": "Step-up required"
          }
        },
        "x-permission": "vendor.bank_profile.manage",
        "x-step-up-purpose": "finance.bank_change"
      }
    },
    "/onboarding/blockers": {
      "get": {
        "operationId": "getOnboardingBlockers",
        "responses": {
          "200": {
            "description": "Activation blockers"
          }
        },
        "x-permission": "vendor.onboarding.read"
      }
    },
    "/onboarding/checklist": {
      "get": {
        "operationId": "getOnboardingChecklist",
        "responses": {
          "200": {
            "description": "Data-driven checklist"
          }
        },
        "x-permission": "vendor.onboarding.read"
      }
    },
    "/onboarding/documents": {
      "get": {
        "operationId": "listOnboardingDocumentReferences",
        "responses": {
          "200": {
            "description": "Opaque document references"
          }
        },
        "x-permission": "vendor.onboarding.read"
      },
      "post": {
        "operationId": "attachOnboardingDocumentReference",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Document"
        },
        "responses": {
          "201": {
            "description": "Reference attached after Media read-back"
          }
        },
        "x-permission": "vendor.onboarding.manage"
      }
    },
    "/onboarding/documents/{documentId}": {
      "delete": {
        "operationId": "removeDraftOnboardingDocumentReference",
        "parameters": [
          {
            "$ref": "#/components/parameters/DocumentId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "description": "Draft reference removed"
          }
        },
        "x-permission": "vendor.onboarding.manage"
      },
      "patch": {
        "operationId": "replaceOnboardingDocumentReference",
        "parameters": [
          {
            "$ref": "#/components/parameters/DocumentId"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Document"
        },
        "responses": {
          "200": {
            "description": "Draft reference replaced"
          }
        },
        "x-permission": "vendor.onboarding.manage"
      }
    },
    "/onboarding/progress": {
      "get": {
        "operationId": "getOnboardingProgress",
        "responses": {
          "200": {
            "description": "Progress"
          }
        },
        "x-permission": "vendor.onboarding.read"
      }
    },
    "/onboarding/representative": {
      "get": {
        "operationId": "getAuthorizedRepresentative",
        "responses": {
          "200": {
            "description": "Representative"
          }
        },
        "x-permission": "vendor.onboarding.read"
      },
      "put": {
        "operationId": "putAuthorizedRepresentative",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/Representative"
        },
        "responses": {
          "200": {
            "description": "Created or versioned update"
          },
          "409": {
            "description": "Version conflict"
          }
        },
        "x-permission": "vendor.onboarding.manage"
      }
    },
    "/onboarding/request-activation": {
      "post": {
        "operationId": "requestActivationEvaluation",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "description": "Backend policy evaluation result"
          }
        },
        "x-permission": "vendor.onboarding.manage"
      }
    },
    "/onboarding/submit": {
      "post": {
        "operationId": "submitOnboarding",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "responses": {
          "200": {
            "description": "Onboarding submitted; does not force activation"
          }
        },
        "x-permission": "vendor.onboarding.manage"
      }
    },
    "/onboarding/verifications": {
      "get": {
        "operationId": "listVerificationProjections",
        "responses": {
          "200": {
            "description": "Authoritative projections"
          }
        },
        "x-permission": "vendor.verification.read"
      }
    },
    "/onboarding/verifications/{dimension}": {
      "get": {
        "operationId": "getVerificationDimension",
        "parameters": [
          {
            "$ref": "#/components/parameters/Dimension"
          }
        ],
        "responses": {
          "200": {
            "description": "Dimension projections"
          }
        },
        "x-permission": "vendor.verification.read"
      }
    },
    "/onboarding/verifications/{dimension}/resubmit": {
      "post": {
        "operationId": "resubmitVerification",
        "parameters": [
          {
            "$ref": "#/components/parameters/Dimension"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/VerificationSubmission"
        },
        "responses": {
          "202": {
            "description": "Remediation case submitted"
          }
        },
        "x-permission": "vendor.verification.submit"
      }
    },
    "/onboarding/verifications/{dimension}/submit": {
      "post": {
        "operationId": "submitVerification",
        "parameters": [
          {
            "$ref": "#/components/parameters/Dimension"
          },
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/VerificationSubmission"
        },
        "responses": {
          "202": {
            "description": "Authoritative case submitted; pending results reconcile by client reference"
          },
          "503": {
            "description": "Disabled integration writes nothing; an ambiguous configured remote call leaves a durable UNKNOWN operation for reconciliation"
          }
        },
        "x-permission": "vendor.verification.submit"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "servers": [
    {
      "url": "/api/v1/vendor"
    }
  ],
  "x-error-contract": "All errors use ErrorEnvelope; stable cases include validation_failed, forbidden, not_found, conflict, service_unavailable, STEP_UP_REQUIRED, VERIFICATION_SOURCE_UNAVAILABLE and EXTERNAL_DEPENDENCY_UNAVAILABLE.",
  "x-feature-flags": {
    "kill_switch": "COMMERCE_GLOBAL_KILL_SWITCH",
    "service": "VENDOR_SERVICE_ENABLED",
    "verification": "VENDOR_VERIFICATION_INTEGRATION_ENABLED",
    "writes": "VENDOR_ONBOARDING_WRITES_ENABLED"
  },
  "x-list-contract": "Section 7 lists are bounded by one Vendor onboarding aggregate and intentionally have no pagination or filters."
}
