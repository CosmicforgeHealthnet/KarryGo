{
  "openapi": "3.0.3",
  "info": {
    "title": "KarryGo Taxi Goods Delivery API",
    "version": "29.2.0",
    "description": "Feature-gated Vendor Commerce Taxi Goods authority. This contract does not use passenger bookings or ride_purpose=parcel."
  },
  "servers": [{"url": "/api/v1/taxi"}],
  "paths": {
    "/internal/commerce/missions/{missionRef}/handover/{stage}": {"get": {"operationId": "readTaxiGoodsHandover", "description": "Vendor-only opaque handover observation. Includes mission_ref, handover_ref, stage, status, source_version. No credential, hash, attempt, resend or expiry fields. Revision advances on canonical challenge changes.", "security": [{"serviceHmac": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}, {"name": "stage", "in": "path", "required": true, "schema": {"type": "string", "enum": ["PICKUP", "DELIVERY"]}}], "responses": {"200": {"description": "Canonical opaque observation"}, "404": {"description": "No source-owned handover"}, "503": {"description": "Authority unavailable"}}}},
    "/internal/commerce/quotes": {"post": {"operationId": "quoteTaxiGoods", "security": [{"serviceHmac": []}], "responses": {"200": {"description": "Persisted authoritative CAR quote"}, "503": {"description": "Feature disabled or dependency unavailable"}}}},
    "/internal/commerce/missions": {"post": {"operationId": "createTaxiGoodsMission", "security": [{"serviceHmac": []}], "responses": {"201": {"description": "Idempotent mission result"}, "409": {"description": "Quote, operation, or state conflict"}}}},
    "/internal/commerce/missions/operations/{operationRef}": {"get": {"operationId": "readTaxiGoodsMissionByOperation", "security": [{"serviceHmac": []}], "parameters": [{"$ref": "#/components/parameters/OperationRef"}], "responses": {"200": {"description": "Source-scoped mission"}, "404": {"description": "Not found"}}}},
    "/internal/commerce/missions/{missionRef}": {"get": {"operationId": "readTaxiGoodsMission", "security": [{"serviceHmac": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Source-scoped mission"}}}},
    "/internal/commerce/missions/{missionRef}/cancel": {"post": {"operationId": "cancelTaxiGoodsMission", "security": [{"serviceHmac": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Cancelled before custody"}, "409": {"description": "Version or custody conflict"}}}},
    "/internal/commerce/missions/{missionRef}/pickup/verify": {"post": {"operationId": "verifyTaxiGoodsPickup", "description": "Vendor verifies the provider-held pickup OTP or opaque QR credential.", "security": [{"serviceHmac": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Pickup custody confirmed"}, "409": {"description": "Credential or state conflict"}}}},
    "/internal/commerce/missions/{missionRef}/receiver": {"post": {"operationId": "changeTaxiGoodsReceiver", "description": "Vendor-scoped idempotent receiver change. Atomically invalidates the prior receiver's active delivery challenge and sends a replacement when required.", "security": [{"serviceHmac": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReceiverChangeCommand"}}}}, "responses": {"200": {"description": "Receiver binding changed"}, "409": {"description": "Version, operation fingerprint, or custody-state conflict"}}}},
    "/internal/operations/goods/providers/{providerId}/capability": {"put": {"operationId": "setTaxiGoodsCapability", "description": "Operations-only capability approval; vendor-service is explicitly denied.", "security": [{"operationsHmac": []}], "parameters": [{"$ref": "#/components/parameters/ProviderId"}], "responses": {"200": {"description": "Versioned capability decision"}}}},
    "/internal/operations/goods/providers/{providerId}/vehicles/{vehicleId}/verification": {"put": {"operationId": "verifyTaxiGoodsCargoProfile", "description": "Operations-only verification of the provider-declared cargo profile.", "security": [{"operationsHmac": []}], "parameters": [{"$ref": "#/components/parameters/ProviderId"}, {"$ref": "#/components/parameters/VehicleId"}], "responses": {"200": {"description": "Versioned verification decision"}}}},
    "/internal/operations/goods/missions/{missionRef}/reassign": {"post": {"operationId": "reassignTaxiGoodsProvider", "description": "Operations-only idempotent pre-custody provider reassignment with durable operational-state locking and challenge rotation.", "security": [{"operationsHmac": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProviderReassignmentCommand"}}}}, "responses": {"200": {"description": "Provider binding changed"}, "409": {"description": "Version, operation fingerprint, eligibility, or custody-state conflict"}}}},
    "/provider/goods/settings": {"get": {"operationId": "readTaxiGoodsSettings", "security": [{"providerBearer": []}], "responses": {"200": {"description": "Capability and independent Goods availability"}}}, "put": {"operationId": "setTaxiGoodsAvailability", "security": [{"providerBearer": []}], "responses": {"200": {"description": "Versioned Goods availability"}}}},
    "/provider/goods/vehicles/{vehicleId}/cargo-profile": {"get": {"operationId": "readTaxiCargoProfile", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/VehicleId"}], "responses": {"200": {"description": "Provider-owned cargo profile"}}}, "put": {"operationId": "declareTaxiCargoProfile", "description": "A provider edit clears operations verification.", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/VehicleId"}], "responses": {"200": {"description": "Versioned unverified cargo declaration"}}}},
    "/provider/goods/missions": {"get": {"operationId": "listTaxiGoodsMissions", "security": [{"providerBearer": []}], "responses": {"200": {"description": "Provider-scoped, privacy-safe jobs"}}}},
    "/provider/goods/missions/{missionRef}": {"get": {"operationId": "readProviderTaxiGoodsMission", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Provider-scoped job"}}}},
    "/provider/goods/missions/{missionRef}/accept": {"post": {"operationId": "acceptTaxiGoodsMission", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Assigned with DB-safe execution exclusivity"}}}},
    "/provider/goods/missions/{missionRef}/en-route-pickup": {"post": {"operationId": "markTaxiGoodsEnRoutePickup", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Provider-safe mission projection"}}}},
    "/provider/goods/missions/{missionRef}/arrived-pickup": {"post": {"operationId": "markTaxiGoodsArrivedPickup", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Provider-safe mission projection"}}}},
    "/provider/goods/missions/{missionRef}/pickup/credential": {"post": {"operationId": "issueProviderHeldPickupCredential", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Provider-held pickup OTP and opaque QR"}}}},
    "/provider/goods/missions/{missionRef}/pickup/resend": {"post": {"operationId": "resendProviderHeldPickupCredential", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Previous OTP and QR invalidated; replacement credential returned to provider"}, "409": {"description": "Cooldown or resend ceiling conflict"}}}},
    "/provider/goods/missions/{missionRef}/in-transit": {"post": {"operationId": "markTaxiGoodsInTransit", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Pickup custody already established"}}}},
    "/provider/goods/missions/{missionRef}/arrived-dropoff": {"post": {"operationId": "markTaxiGoodsArrivedDropoff", "description": "Creates and notifies a receiver-held delivery challenge.", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Delivery handover is required"}}}},
    "/provider/goods/missions/{missionRef}/delivery/resend": {"post": {"operationId": "resendReceiverHeldDeliveryCredential", "description": "Provider receives metadata only; Notification transport delivers the replacement secret to the receiver.", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Safe challenge metadata"}, "409": {"description": "Cooldown or resend ceiling conflict"}}}},
    "/provider/goods/missions/{missionRef}/delivery/verify": {"post": {"operationId": "verifyReceiverHeldDeliveryCredential", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Delivery custody confirmed"}}}},
    "/provider/goods/missions/{missionRef}/evidence": {"post": {"operationId": "attachTaxiGoodsEvidenceReference", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Media reference attached; no bytes stored"}}}},
    "/provider/goods/missions/{missionRef}/complete": {"post": {"operationId": "completeTaxiGoodsMission", "security": [{"providerBearer": []}], "parameters": [{"$ref": "#/components/parameters/MissionRef"}], "responses": {"200": {"description": "Proof-gated completion and Wallet settlement scheduling"}}}}
  },
  "components": {
    "securitySchemes": {
      "serviceHmac": {"type": "apiKey", "in": "header", "name": "X-Service-Signature", "description": "HMAC v2 with timestamp and one-use nonce; vendor-service only on Commerce routes."},
      "operationsHmac": {"type": "apiKey", "in": "header", "name": "X-Service-Signature", "description": "HMAC v2 with timestamp and one-use nonce; exact operations caller allowlist and vendor-service denied."},
      "providerBearer": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
    },
    "parameters": {
      "MissionRef": {"name": "missionRef", "in": "path", "required": true, "schema": {"type": "string"}},
      "OperationRef": {"name": "operationRef", "in": "path", "required": true, "schema": {"type": "string"}},
      "ProviderId": {"name": "providerId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "VehicleId": {"name": "vehicleId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
    },
    "schemas": {
      "ReceiverChangeCommand": {"type": "object", "additionalProperties": false, "required": ["receiver_ref", "receiver_name", "operation_ref", "expected_version"], "properties": {"receiver_ref": {"type": "string", "minLength": 1}, "receiver_name": {"type": "string", "minLength": 1}, "receiver_phone": {"type": "string"}, "operation_ref": {"type": "string", "minLength": 1}, "expected_version": {"type": "integer", "format": "int64", "minimum": 1}}},
      "ProviderReassignmentCommand": {"type": "object", "additionalProperties": false, "required": ["new_provider_id", "new_vehicle_id", "operation_ref", "expected_version"], "properties": {"new_provider_id": {"type": "string", "format": "uuid"}, "new_vehicle_id": {"type": "string", "format": "uuid"}, "operation_ref": {"type": "string", "minLength": 1}, "expected_version": {"type": "integer", "format": "int64", "minimum": 1}}}
    }
  }
}
