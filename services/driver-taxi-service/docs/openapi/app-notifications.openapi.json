{
  "openapi": "3.1.0",
  "info": {
    "title": "Taxi app notification proxies",
    "version": "1.0.0"
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Matching provider or customer role/service required."
      }
    }
  },
  "paths": {
    "/api/v1/taxi/customer/notifications": {
      "get": {
        "operationId": "taxi.customer.notifications.feed",
        "summary": "List notifications for the authenticated subject",
        "description": "Recipient ID comes exclusively from validated bearer claims. Notification service calls are signed internally; callers cannot choose another recipient.",
        "responses": {
          "401": {
            "description": "Missing or invalid matching audience bearer"
          },
          "400": {
            "description": "Invalid device input"
          },
          "503": {
            "description": "Notification authority unavailable"
          },
          "200": {
            "description": "Native success envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {}
                  },
                  "required": [
                    "success"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            },
            "description": "Invalid/nonpositive values use 50; values above 100 are capped."
          }
        ]
      }
    },
    "/api/v1/taxi/customer/notifications/realtime-token": {
