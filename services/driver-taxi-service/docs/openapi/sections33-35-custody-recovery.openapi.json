{
  "openapi": "3.0.3",
  "info": {"title": "KarryGo Taxi Goods Custody Recovery API", "version": "1.0.0", "description": "Sections 33-35 authority-local CAR Goods custody contract."},
  "paths": {
    "/api/v1/taxi/internal/custody/v1/manifests/freeze": {"post": {"operationId": "taxiFreezeCustodyManifest", "security": [{"serviceHmacV2": []}], "responses": {"201": {"description": "Frozen"}}}},
    "/api/v1/taxi/internal/custody/v1/manifests/confirm": {"post": {"operationId": "taxiConfirmExactPickupParcels", "security": [{"serviceHmacV2": []}], "responses": {"200": {"description": "Confirmed"}}}},
    "/api/v1/taxi/internal/custody/v1/evidence": {"post": {"operationId": "taxiRecordTypedEvidence", "security": [{"serviceHmacV2": []}], "responses": {"201": {"description": "Recorded"}}}},
    "/api/v1/taxi/internal/custody/v1/exceptions": {"post": {"operationId": "taxiReportException", "security": [{"serviceHmacV2": []}], "responses": {"200": {"description": "Recorded"}}}},
    "/api/v1/taxi/internal/custody/v1/returns": {"post": {"operationId": "taxiStartReturn", "security": [{"serviceHmacV2": []}], "responses": {"201": {"description": "Started"}}}},
    "/api/v1/taxi/internal/custody/v1/returns/complete": {"post": {"operationId": "taxiCompleteReturn", "security": [{"serviceHmacV2": []}], "responses": {"200": {"description": "Completed"}}}},
    "/api/v1/taxi/internal/custody/v1/incidents": {"post": {"operationId": "taxiReportInternalIncident", "security": [{"serviceHmacV2": []}], "responses": {"201": {"description": "Frozen"}}}},
    "/api/v1/taxi/internal/custody/v1/replacements": {"post": {"operationId": "taxiAssignReplacement", "security": [{"serviceHmacV2": []}], "responses": {"201": {"description": "Assigned"}}}},
    "/api/v1/taxi/internal/custody/v1/transfers": {"post": {"operationId": "taxiCompleteTransfer", "security": [{"serviceHmacV2": []}], "responses": {"200": {"description": "Transferred"}}}},
    "/api/v1/taxi/internal/custody/v1/earning-allocations": {"post": {"operationId": "taxiRecordWalletAllocation", "security": [{"serviceHmacV2": []}], "responses": {"200": {"description": "Recorded"}}}},
    "/api/v1/taxi/provider/custody/missions/{missionRef}/incidents": {"post": {"operationId": "taxiProviderReportsIncident", "security": [{"providerBearer": []}], "parameters": [{"name": "missionRef", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"201": {"description": "Recorded"}, "403": {"description": "Not current provider"}}}}
  },
  "components": {"securitySchemes": {"serviceHmacV2": {"type": "apiKey", "in": "header", "name": "X-KarryGo-Signature"}, "providerBearer": {"type": "http", "scheme": "bearer"}}, "schemas": {"IncidentReason": {"type": "string", "enum": ["BREAKDOWN", "ILLNESS", "SAFETY_INCIDENT"]}}}
}
