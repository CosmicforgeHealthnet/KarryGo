APP_ENV=development
HTTP_ADDR=:8102
TAXI_MIGRATION=false

TAXI_DATABASE_URL=postgres://cosmicforge_logistics:cosmicforge_logistics@localhost:5434/taxi_service?sslmode=disable
TAXI_REDIS_ADDR=localhost:6381
TAXI_REDIS_PASSWORD=
TAXI_REDIS_DB=0

# Must equal the `taxi=` entry in payment-wallet's
# PAYMENT_WALLET_PROVIDER_ACCESS_TOKEN_SECRETS and support-dispute's
# SUPPORT_DISPUTE_TAXI_PROVIDER_TOKEN_SECRET. One driver token is presented to
# all three services.
TAXI_PROVIDER_TOKEN_SECRET=development-taxi-access-token-secret
TAXI_PROVIDER_REFRESH_SECRET=development-taxi-provider-refresh-secret
TAXI_PROVIDER_OTP_SECRET=development-taxi-provider-otp-secret
# Must equal CUSTOMER_ACCESS_TOKEN_SECRET in customer-service.
TAXI_CUSTOMER_TOKEN_SECRET=development-customer-access-token-secret

# Signs the pickup ride PIN. Service-local; no cross-service match required.
HANDOVER_CODE_SECRET=development-handover-code-secret

TAXI_ACCESS_TOKEN_TTL_SECONDS=3600
TAXI_REFRESH_TOKEN_TTL_DAYS=30
TAXI_OTP_TTL_SECONDS=600
TAXI_OTP_RATE_WINDOW_SECONDS=60
TAXI_OTP_MAX_REQUESTS=5
TAXI_OTP_MAX_ATTEMPTS=5
TAXI_OTP_DEBUG=false

# BARE ORIGINS ONLY. walletclient and the notification client append their own
# /api/v1/... paths; a prefixed URL 404s every internal call. Config.Validate
# rejects a path at boot.
# The notification QUEUE must point at the Redis notification-service itself
# consumes (6385), not this service's own Redis (6381). Publishing to our own
# instance leaves entries nobody ever reads -- the whole point of the durable
# stream is that notification-service picks them up.
TAXI_NOTIFICATION_REDIS_ADDR=localhost:6385
TAXI_NOTIFICATION_URL=
TAXI_NOTIFICATION_SECRET=
TAXI_PAYMENT_URL=
TAXI_PAYMENT_SECRET=

# Section 29 Vendor Commerce Taxi Goods. Both Taxi and Vendor gates remain
# false by default. This product never calls /customer/bookings or passenger
# fare estimation.
TAXI_GOODS_DELIVERY_ENABLED=false
TAXI_GOODS_PRICING=
TAXI_GOODS_HANDOVER_SECRET=
TAXI_GOODS_QUOTE_TTL_SECONDS=900
TAXI_MEDIA_URL=
TAXI_MEDIA_TOKEN=
# Vendor's bare origin and the outbound driver-taxi-service HMAC secret.
TAXI_VENDOR_URL=
TAXI_VENDOR_SECRET=

# Google Cloud key with the Routes API enabled. Separate from the app-side Maps
# SDK key. Unset means straight-line geometry everywhere.
TAXI_ROUTES_API_KEY=

# Inbound internal callers (HMAC).
TAXI_SERVICE_SECRETS=support-dispute-service=development-support-dispute-service-secret,vendor-service=development-vendor-service-secret

TAXI_BOOKING_MATCH_TIMEOUT=30
TAXI_BOOKING_SEARCH_WINDOW=60
# 90 and no higher: a longer TTL keeps force-quit drivers dispatchable.
TAXI_PROVIDER_ONLINE_TTL=90
TAXI_MATCH_MAX_RADIUS_KM=10
TAXI_SCHEDULE_LEAD_MINUTES=10

# Referral programme feed. When enabled, new drivers (and drivers becoming
# fully approved) are announced to referral-service in the transaction that
# records them; only keyed hashes of phone/device are sent. URL is a bare
# origin; the secret must match driver-taxi-service in REFERRAL_SERVICE_SECRETS;
# the pepper must be identical in every service that feeds referral-service.
# Existing drivers: run `go run ./cmd/referral-backfill` once.
TAXI_REFERRAL_FEED_ENABLED=false
TAXI_REFERRAL_SERVICE_URL=http://localhost:8114
TAXI_REFERRAL_SERVICE_SECRET=
TAXI_REFERRAL_IDENTITY_PEPPER=

# Section 7 (all default false). Enable shadow evaluation before enforcement,
# and multi-pickup only once goods capability, secure handover and cumulative
# fit are all enabled; config validation refuses anything else.
TAXI_SERVICE_PRODUCTS_ENABLED=false
TAXI_CAPABILITY_MATCHING_ENABLED=false
TAXI_GOODS_CAPABILITY_ENABLED=false
TAXI_GOODS_MULTI_PICKUP_ENABLED=false
TAXI_GOODS_SECURE_HANDOVER_ENABLED=false
TAXI_GOODS_CUMULATIVE_FIT_ENABLED=false
TAXI_RECOVERY_ENABLED=false
TAXI_SCHEDULED_RISK_MONITOR_ENABLED=false
# Customer movement summaries -> customer-service (bare origin; the HMAC
# secret must match CUSTOMER_SERVICE_SECRETS driver-taxi-service entry).
TAXI_CUSTOMER_MOVEMENT_EVENTS_ENABLED=false
# Hand saved customer mobility needs into new passenger bookings. Requires
# TAXI_SERVICE_PRODUCTS_ENABLED and customer-service CUSTOMER_CONTEXT_CALLER_SCOPES
# granting driver-taxi-service the mobility_preferences scope.
TAXI_CUSTOMER_CONTEXT_ENABLED=false
TAXI_CUSTOMER_SERVICE_URL=
TAXI_CUSTOMER_SERVICE_SECRET=
TAXI_CAPABILITY_INTERNAL_CALLERS=vendor-service,operations-service,verification-compliance-service
