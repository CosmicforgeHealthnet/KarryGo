# pricing-service configuration.
#
# NOTE what is absent: there is no rate, minimum fare, commission percentage or
# surcharge here. Commercial values are versioned policy DATA in the database,
# created as drafts and activated through the approval API, so every rate in
# production has an approver's name against it. A rate that could be changed by
# an environment variable would bypass approval entirely.

APP_ENV=development
HTTP_ADDR=:8115

PRICING_MIGRATION=false
PRICING_DATABASE_URL=postgres://cosmicforge_logistics:cosmicforge_logistics@localhost:5451/pricing_service?sslmode=disable

# Which services may call the internal API, and the HMAC secret each one signs
# with ("caller=secret,..."). A caller listed below without a secret here can
# never succeed, and the service refuses to start rather than pretend otherwise.
PRICING_SERVICE_SECRETS=taxi-service=development-taxi-pricing-secret,dispatch-delivery-service=development-dispatch-pricing-secret,driver-hauling-service=development-hauling-pricing-secret,api-gateway=development-gateway-pricing-secret,admin-backoffice-service=development-admin-pricing-secret,pricing-ops-cli=development-ops-pricing-secret

# Holding a secret is not permission to price. Authority is granted per route
# group: a booking service may ask for a quote, not approve a rate change.
PRICING_QUOTE_CALLERS=taxi-service,dispatch-delivery-service,driver-hauling-service,api-gateway
PRICING_ADMIN_CALLERS=admin-backoffice-service,pricing-ops-cli

# Separation of duties. Cannot be false when APP_ENV=production.
PRICING_FOUR_EYE_REQUIRED=true

# A route snapshot older than this is too stale to describe current conditions.
PRICING_MAX_ROUTE_AGE_SECONDS=900
# Policy bodies are immutable and cached indefinitely; only "which version is
# active now" needs re-reading.
PRICING_POLICY_CACHE_REFRESH_SECONDS=30
# How long an UNBOUND expired quote is kept. Bound quotes and reconciliations are
# financial records and are never purged by this setting.
PRICING_QUOTE_RETENTION_DAYS=30

# Outbox relay. Leave both empty until a consumer exists: events then stay
# durable in the outbox rather than being dropped. Bare origin only.
PRICING_OUTBOX_RELAY_URL=
PRICING_OUTBOX_RELAY_SECRET=

PRICING_NONCE_PRUNE_INTERVAL_SECONDS=600
PRICING_OUTBOX_RELAY_INTERVAL_SECONDS=10
PRICING_RETENTION_INTERVAL_SECONDS=3600
PRICING_WORKER_BATCH_SIZE=100

# Fuel index: driver services that may report fuel prices, how many days one
# index covers, and how often it is rebuilt and checked for tariff changes.
PRICING_FUEL_CALLERS=driver-taxi-service,driver-dispatch-delivery-service,driver-hauling-service
PRICING_FUEL_INDEX_WINDOW_DAYS=3
PRICING_FUEL_INDEX_INTERVAL_SECONDS=3600
