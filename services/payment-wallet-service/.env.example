# Payment & Wallet Service — local configuration template.
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit secrets.

APP_ENV=development
HTTP_ADDR=:8105

# Postgres / Redis (defaults match infra/docker-compose.yml and the local bootstrap).
PAYMENT_WALLET_DATABASE_URL=
PAYMENT_WALLET_REDIS_ADDR=localhost:6384
PAYMENT_WALLET_REDIS_PASSWORD=
PAYMENT_WALLET_REDIS_DB=0

# Auth secrets. Provider secrets must match each provider service's access-token
# secret (e.g. hauling mirrors HAULING_PROVIDER_TOKEN_SECRET).
PAYMENT_WALLET_CUSTOMER_ACCESS_TOKEN_SECRET=
PAYMENT_WALLET_PROVIDER_ACCESS_TOKEN_SECRETS=
PAYMENT_WALLET_SERVICE_SECRETS=

# Paystack. Use test keys from your Paystack dashboard (https://dashboard.paystack.com/#/settings/developers).
PAYMENT_WALLET_PAYSTACK_BASE_URL=https://api.paystack.co
PAYMENT_WALLET_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYMENT_WALLET_PAYSTACK_SECRET_KEY=

# Business rules.
PAYMENT_WALLET_PLATFORM_FEE_BPS=1500
PAYMENT_WALLET_HTTP_TIMEOUT_SECONDS=15
PAYMENT_WALLET_WEBHOOK_MAX_SKEW_SECONDS=300
PAYMENT_WALLET_WITHDRAWAL_MIN_KOBO=10000
PAYMENT_WALLET_WITHDRAWAL_MAX_KOBO=500000000
PAYMENT_WALLET_REQUIRE_MANUAL_PAYOUTS=true
PAYMENT_WALLET_DEFAULT_CURRENCY=NGN

# Public base URL Paystack redirects back to after checkout (set to a reachable URL when testing top-ups).
PAYMENT_WALLET_PUBLIC_CALLBACK_BASE_URL=http://localhost:8105

# Referral programme feed. When enabled, every job payout appends a
# finance.job.settled.v1 event (same transaction as the payout) and a relay
# delivers it to referral-service. TARGET_URL is a bare origin; the secret must
# match the payment-wallet-service entry in REFERRAL_SERVICE_SECRETS.
PAYMENT_WALLET_REFERRAL_OUTBOX_ENABLED=false
PAYMENT_WALLET_REFERRAL_OUTBOX_TARGET_URL=http://localhost:8114
PAYMENT_WALLET_REFERRAL_OUTBOX_SECRET=

# Driver referral cash-outs (POST /provider/referral-withdrawals). Off by
# default. When on, every payout is first checked with referral-service at
# the target URL above, signed with the secret above; the destination bank
# account is sent only as a hash keyed with the identity pepper, which must
# equal the pepper every referral producer uses. Minimum ₦5,000.
PAYMENT_WALLET_REFERRAL_WITHDRAWALS_ENABLED=false
PAYMENT_WALLET_REFERRAL_IDENTITY_PEPPER=
PAYMENT_WALLET_REFERRAL_WITHDRAWAL_MIN_KOBO=500000
