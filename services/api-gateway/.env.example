# services/api-gateway/.env.example

# ── Server
HTTP_ADDR=:8080

# ── Database (api-gateway owns its own DB)
API_GATEWAY_DATABASE_URL=postgres://user:pass@localhost:5432/api_gateway_db

# ── Redis (shared with all services)
API_GATEWAY_REDIS_ADDR=localhost:6379
API_GATEWAY_REDIS_PASSWORD=
API_GATEWAY_REDIS_DB=0

# ── Partner Dashboard Auth
PARTNER_JWT_SECRET=replace-with-min-32-char-random-string
PARTNER_JWT_TTL_HOURS=24

# ── Internal service key (used by admin-backoffice to call /internal/partner/*)
PARTNER_INTERNAL_SERVICE_KEY=replace-with-strong-random-key

# ── API Key Config
PARTNER_API_KEY_HASH_COST=12

# ── Payment Wallet Service (HMAC internal calls)
API_GATEWAY_WALLET_SERVICE_URL=http://localhost:8105/api/v1/payment-wallet
API_GATEWAY_WALLET_SERVICE_NAME=api-gateway
API_GATEWAY_WALLET_SERVICE_SECRET=replace-must-match-wallet-PAYMENT_WALLET_SERVICE_SECRETS

# ── Pricing (all values in kobo)
PRICING_BASE_KOBO=50000
PRICING_STANDARD_PER_KM_KOBO=15000
PRICING_EXPRESS_PER_KM_KOBO=25000
PRICING_LARGE_MULTIPLIER=1.2

# ── Webhook Delivery
# WEBHOOK_SIGNING_SECRET encrypts stored webhook signing secrets at rest.
WEBHOOK_SIGNING_SECRET=replace-with-webhook-signing-secret
WEBHOOK_MAX_RETRIES=5
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=30
