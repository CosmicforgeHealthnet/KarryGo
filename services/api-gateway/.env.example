# Routing-only public gateway: no database or partner secrets.
APP_ENV=development
HTTP_ADDR=:8080
GATEWAY_UPSTREAM_PARTNER_WEB_URL=http://partner-web-service:8080
# Each other upstream must use its authorized private container origin.
GATEWAY_UPSTREAM_CUSTOMER_URL=
GATEWAY_UPSTREAM_TAXI_URL=
GATEWAY_UPSTREAM_DISPATCH_URL=
GATEWAY_UPSTREAM_HAULING_URL=
GATEWAY_UPSTREAM_PAYMENT_WALLET_URL=
GATEWAY_UPSTREAM_NOTIFICATION_URL=
GATEWAY_UPSTREAM_SUPPORT_URL=
GATEWAY_UPSTREAM_VENDOR_URL=
GATEWAY_UPSTREAM_FLEET_URL=
GATEWAY_UPSTREAM_TIMEOUT_SECONDS=15
GATEWAY_BREAKER_THRESHOLD=5
GATEWAY_BREAKER_COOLDOWN_SECONDS=30
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,https://karry-go.vercel.app
