{
  "openapi": "3.0.3",
  "info": {
    "title": "Gateway Partner Browser Authentication",
    "version": "1.1.0",
    "description": "Focused browser auth contract supplement. Existing request DTOs remain authoritative; no JSON refresh credential accepted/returned. SameSite deployment policy must match trusted origins. Cookie Path: /api/v1/partner/v1/auth"
  },
  "paths": {
    "/api/v1/partner/v1/auth/register": {
      "post": {
        "summary": "register",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured trusted web origin."
          }
        ],
        "security": [],
        "responses": {
          "201": {
            "description": "Access credential and safe session metadata only. Refresh secret exclusively in Set-Cookie.",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly; host-only; Secure in production; SameSite=Lax by default; auth-scoped Path; Max-Age/Expires match the server session. Confidential; never expose through browser JavaScript.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessSessionEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked, expired or replayed session credential."
          },
          "403": {
            "description": "Missing or untrusted browser Origin."
          },
          "429": {
            "description": "Existing auth abuse limits."
          },
          "503": {
            "description": "Authentication dependency unavailable."
          }
        }
      }
    },
