  "components": {
    "securitySchemes": {
      "BrowserRefresh": {
        "type": "apiKey",
        "in": "cookie",
        "name": "karrygo_partner_refresh"
      },
      "BearerAccess": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AccessSessionEnvelope": {
        "type": "object",
        "description": "Legacy access field name token is preserved; refresh secrets never serialized.",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/AccessSession"
          }
        }
      },
      "AccessSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "token": {
            "type": "string",
            "description": "Short-lived access JWT only"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "account": {
            "type": "object"
          },
          "api_key": {
            "type": "object",
            "description": "Existing registration-only API key issuance; not a refresh credential"
          }
        }
      }
    }
  }
