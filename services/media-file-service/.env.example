# Media/File Service
APP_ENV=development
HTTP_ADDR=:8109
MIGRATION=false

# Media-owned Postgres database.
MEDIA_FILE_DATABASE_URL=

# Firebase Storage.
MEDIA_FILE_FIREBASE_BUCKET=karrygo-dev-media.appspot.com
MEDIA_FILE_FIREBASE_CREDENTIALS_FILE=
MEDIA_FILE_FIREBASE_CREDENTIALS_JSON=
MEDIA_FILE_PUBLIC_BASE_URL=

# Upload limits.
MEDIA_FILE_MAX_UPLOAD_BYTES=26214400

# Internal service auth tokens. Use strong unique values outside local development.
MEDIA_FILE_SERVICE_TOKENS=


# Partner web uploads can authenticate with api-gateway Partner Session JWTs.
PARTNER_JWT_SECRET=


# --- WP10 private media object contract -------------------------------------
# Off by default. Every write and worker flag below is false until a deployment
# has deliberately configured callers, secrets and a signing key.
MEDIA_FILE_PRIVATE_API_ENABLED=false

# Per-caller HMAC secrets for the private contract ("name=secret,...").
# Example values stay EMPTY: a shipped default secret is a shipped credential.
MEDIA_FILE_SERVICE_SECRETS=
MEDIA_FILE_PRIVATE_ALLOWED_CALLERS=fleet-partner-service

# Signs short-lived, object-specific download grants. Mandatory whenever the
# private API is enabled — without it the service refuses to boot rather than
# serving private content without a bounded credential.
MEDIA_FILE_DOWNLOAD_SIGNING_SECRET=

# Filesystem-backed private storage. Used only when no bucket is configured.
MEDIA_FILE_PRIVATE_STORAGE_DIR=

# Grant lifetimes and upload limits.
MEDIA_FILE_UPLOAD_AUTHORIZATION_TTL_SECONDS=900
MEDIA_FILE_PRIVATE_DOWNLOAD_TTL_SECONDS=300
MEDIA_FILE_PRIVATE_MAX_UPLOAD_BYTES=26214400
MEDIA_FILE_PRIVATE_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/webp
MEDIA_FILE_PROHIBIT_EXECUTABLE_CONTENT=true

# Refuse a content grant for anything not confirmed SAFE. There is no malware
# provider configured for this platform, so enabling this means no private
# content can be served at all — which is the correct fail-closed posture when
# policy demands a clean verdict.
MEDIA_FILE_REQUIRE_SAFE_FOR_DOWNLOAD=false

# Retention. 0 leaves retention_until unset; media still refuses deletion under
# a legal hold.
MEDIA_FILE_DEFAULT_RETENTION_SECONDS=0

# Maintenance sweep: expires lapsed upload grants, stale uploads and nonces.
MEDIA_FILE_WORKERS_ENABLED=false
MEDIA_FILE_WORKER_INTERVAL_SECONDS=60
MEDIA_FILE_WORKER_LEASE_SECONDS=120
MEDIA_FILE_WORKER_BATCH_SIZE=100

# Kill switch: stops every media worker and the private write path.
MEDIA_FILE_KILL_SWITCH=false

# Outbox publisher (media events -> fleet-partner-service).
MEDIA_FILE_OUTBOX_ENABLED=false
MEDIA_FILE_OUTBOX_TARGET_URL=
MEDIA_FILE_OUTBOX_PATH=/internal/fleet-partner/v1/documents/media-events
MEDIA_FILE_OUTBOX_SECRET=
MEDIA_FILE_OUTBOX_BATCH_SIZE=50
MEDIA_FILE_OUTBOX_INTERVAL_SECONDS=5
MEDIA_FILE_OUTBOX_LEASE_SECONDS=30
MEDIA_FILE_OUTBOX_MAX_ATTEMPTS=10
MEDIA_FILE_HTTP_REQUEST_TIMEOUT_SECONDS=10

# Disposable database for the mandatory integration suite. The name must
# contain "test".
MEDIA_FILE_TEST_DATABASE_URL=

# Optional private ClamAV daemon; empty address keeps uploads unverified.
# Keep TCP access inside the trusted service network; use unix for a local socket.
MEDIA_FILE_SCANNER_NETWORK=tcp
MEDIA_FILE_SCANNER_ADDRESS=
MEDIA_FILE_SCANNER_TIMEOUT_SECONDS=5

# Section 10: owner-attested legacy asset adoption (private HMAC v2 route
# POST /internal/media/v1/legacy-adoptions). Default false. The sources file
# is {"sources":[{"owner":"driver-dispatch-delivery-service","secret_file":"..."}]};
# each key is a raw base64url value (>=32 bytes) distinct from every other
# Media credential. No values are supplied here.
MEDIA_LEGACY_ADOPTION_ENABLED=false
MEDIA_LEGACY_ADOPTION_SOURCES_FILE=

# Section 19 (Secure Admin): legacy media hardening. Default false: legacy
# document_file, proof_image and signature assets are NOT served by the
# unauthenticated /:id/download route (profile photos stay public). Owners
# read them via the authenticated GET /files/:id/content. Enabling this is a
# compatibility escape hatch only; adoption, integrity and malware checks
# still apply and the bytes are never served inline.
MEDIA_LEGACY_PUBLIC_SENSITIVE_DOWNLOAD_ENABLED=false
# Private Bridge lookup POST /internal/media/v1/legacy-mappings (caller
# admin-backoffice-service, HMAC v2 with the MEDIA_ADMIN_CASE_SECRET_FILE key,
# durable nonce). Default false.
MEDIA_LEGACY_MAPPING_LOOKUP_ENABLED=false
