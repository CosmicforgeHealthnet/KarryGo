  "components": {
    "securitySchemes": {
      "CaseWorkloadHMAC": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Signature",
        "description": "HMAC v2 exact method/path/query/body plus service-name/version/timestamp/nonce/signature headers. Fixed caller admin-backoffice-service, distinct case key, timestamp window 30 seconds, durable replay protection. Current staff metadata is trusted only from that authenticated workload; the Bridge must validate its HQ staff assertion on every request."
      }
    }
  }
