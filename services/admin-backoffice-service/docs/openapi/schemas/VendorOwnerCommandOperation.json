{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "action": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "subject_kind": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "subject_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "case_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        {
          "const": ""
        }
      ]
    },
    "expected_version": {
      "type": "integer",
      "minimum": 0
    },
    "approval_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "const": "karryam"
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "zone": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "organization": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "tenant": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        }
      },
      "required": [
        "product",
        "market",
        "zone",
        "organization",
        "tenant"
      ]
    },
    "status": {
      "enum": [
        "EXECUTING",
        "UNKNOWN_OUTCOME",
        "CONFIRMED",
        "REJECTED"
      ]
    },
    "rejection_code": {
      "enum": [
        "owner_refused",
        "superseded_by_owner_version"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "enum": [
            "vendor.admin-command.v1"
          ]
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        },
        "decision_id": {
          "type": "string",
          "format": "uuid"
        },
        "subject_kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        "case_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
              "maxLength": 128
            },
            {
              "const": ""
            }
          ]
        },
        "action": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        "intent_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "const": ""
            }
          ]
        },
        "prior_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "resulting_state": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "recorded_version": {
          "type": "integer",
          "minimum": 1
        },
        "outcome": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "product": {
              "const": "karryam"
            },
            "market": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            },
            "zone": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            },
            "organization": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            },
            "tenant": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          "required": [
            "product",
            "market",
            "zone",
            "organization",
            "tenant"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "contract_version",
        "owner",
        "operation_id",
        "decision_id",
        "subject_kind",
        "subject_id",
        "case_ref",
        "action",
        "idempotency_key",
        "intent_digest",
        "approval_id",
        "prior_state",
        "resulting_state",
        "recorded_version",
        "outcome",
        "scope",
        "recorded_at"
      ]
    }
  },
  "required": [
    "operation_id",
    "owner",
    "action",
    "subject_kind",
    "subject_id",
    "case_ref",
    "expected_version",
    "scope",
    "status",
    "created_at",
    "as_of"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "CONFIRMED"
          }
        }
      },
      "then": {
        "required": [
          "receipt"
        ]
      },
      "else": {
        "not": {
          "required": [
            "receipt"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "REJECTED"
          }
        }
      },
      "then": {
        "required": [
          "rejection_code"
        ]
      },
      "else": {
        "not": {
          "required": [
            "rejection_code"
          ]
        }
      }
    }
  ]
}
