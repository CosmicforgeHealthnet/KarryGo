{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "subject_kind": {
      "enum": [
        "CUSTOMER",
        "PROVIDER",
        "VENDOR_STAFF"
      ]
    },
    "subject_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "request_type": {
      "enum": [
        "ACCESS_EXPORT",
        "ERASURE",
        "RECTIFICATION",
        "CONSENT_WITHDRAWAL",
        "RESTRICT_PROCESSING"
      ]
    },
    "received_on": {
      "type": "string",
      "format": "date"
    },
    "legal_hold": {
      "type": "boolean"
    }
  },
  "required": [
    "request_id",
    "subject_kind",
    "subject_ref",
    "request_type",
    "received_on",
    "legal_hold"
  ]
}
