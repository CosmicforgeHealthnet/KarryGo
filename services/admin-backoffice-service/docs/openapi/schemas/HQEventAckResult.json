{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "consumer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "acknowledged_sequence": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "consumer",
    "acknowledged_sequence"
  ]
}
