{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "product": {
      "const": "karryam"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "freshness": {
      "enum": [
        "LIVE",
        "RECENT",
        "STALE",
        "PARTIAL",
        "UNKNOWN",
        "UNAVAILABLE"
      ]
    },
    "result": {
      "type": [
        "object",
        "array",
        "null"
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "message": {
          "type": "string",
          "maxLength": 128
        },
        "retryable": {
          "type": "boolean"
        },
        "operation_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ]
    }
  },
  "required": [
    "contract_version",
    "product",
    "correlation_id",
    "as_of",
    "freshness",
    "result"
  ]
}
