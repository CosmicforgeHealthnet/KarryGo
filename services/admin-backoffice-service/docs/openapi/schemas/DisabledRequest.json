{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "product": {
      "const": "karryam"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "market": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        "organization": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        }
      },
      "required": [
        "market",
        "organization"
      ]
    },
    "reason_code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    }
  },
  "required": [
    "contract_version",
    "product",
    "scope",
    "reason_code",
    "idempotency_key"
  ]
}
