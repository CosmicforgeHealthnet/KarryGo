{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "export_id": {
      "type": "string",
      "format": "uuid"
    },
    "row_count": {
      "type": "integer",
      "minimum": 0
    },
    "download_token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "plaintext_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "export_id",
    "row_count",
    "expires_at",
    "plaintext_sha256"
  ]
}
