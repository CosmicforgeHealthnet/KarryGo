{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "customer_id": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "const": "karryam"
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "zone": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "organization": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        },
        "tenant": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
        }
      },
      "required": [
        "product",
        "market",
        "zone",
        "organization",
        "tenant"
      ]
    },
    "status": {
      "enum": [
        "EXECUTING",
        "UNKNOWN_OUTCOME",
        "CONFIRMED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "const": "customer.admin-review-request.v1"
        },
        "status": {
          "const": "REVIEW_REQUEST_RECORDED"
        },
        "review_request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "request_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "customer_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]{0,127}$"
        },
        "intent_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "recorded_review_revision": {
          "type": "integer",
          "minimum": 2
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "product": {
              "const": "karryam"
            },
            "market": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            },
            "zone": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            },
            "organization": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            },
            "tenant": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          "required": [
            "product",
            "market",
            "zone",
            "organization",
            "tenant"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "contract_version",
        "status",
        "review_request_id",
        "request_id",
        "customer_id",
        "idempotency_key",
        "intent_digest",
        "recorded_review_revision",
        "scope",
        "recorded_at"
      ]
    }
  },
  "required": [
    "operation_id",
    "customer_id",
    "scope",
    "status",
    "created_at",
    "as_of"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "CONFIRMED"
          }
        }
      },
      "then": {
        "required": [
          "receipt"
        ]
      },
      "else": {
        "not": {
          "required": [
            "receipt"
          ]
        }
      }
    }
  ]
}
