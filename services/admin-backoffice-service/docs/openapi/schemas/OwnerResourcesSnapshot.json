{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "karryam.owner-resources.v1"
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "const": "karryam"
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        "zone": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        "organization": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        "tenant": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        }
      },
      "required": [
        "product",
        "market",
        "zone",
        "organization",
        "tenant"
      ]
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "policy_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "const": "CONTEXT_SCOPED_PARTIAL"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
            "maxLength": 128
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "source_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "snapshot_etag": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "dimensions": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "flag": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "value",
                "flag"
              ]
            }
          },
          "counters": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                },
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "required": [
                "name",
                "value"
              ]
            }
          },
          "references": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                },
                "reference": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                }
              },
              "required": [
                "kind",
                "reference"
              ]
            }
          },
          "timeline": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reference": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                },
                "type": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                },
                "at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                }
              },
              "required": [
                "reference",
                "type",
                "at"
              ]
            }
          },
          "timeline_truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "reference",
          "kind",
          "status",
          "source_version",
          "snapshot_etag",
          "created_at",
          "updated_at",
          "dimensions",
          "counters",
          "references",
          "timeline",
          "timeline_truncated"
        ]
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    }
  },
  "required": [
    "contract_version",
    "owner",
    "kind",
    "scope",
    "policy_id",
    "policy_version",
    "policy_checksum",
    "as_of",
    "coverage",
    "items",
    "next_cursor"
  ]
}
