{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "karryam.owner-resources.v1"
    },
    "owner": {
      "const": "vendor-service"
    },
    "kind": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "product": {
          "const": "karryam"
        },
        "market": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        "zone": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        "organization": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        },
        "tenant": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
          "maxLength": 128
        }
      },
      "required": [
        "product",
        "market",
        "zone",
        "organization",
        "tenant"
      ]
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "policy_version": {
      "type": "integer",
      "minimum": 1
    },
    "policy_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "as_of": {
      "type": "string",
      "format": "date-time"
    },
    "coverage": {
      "const": "CONTEXT_SCOPED_PARTIAL"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reference": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
            "maxLength": 128
          },
          "kind": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
            "maxLength": 128
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ]
          },
          "source_version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "snapshot_etag": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "dimensions": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "flag": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "value",
                "flag"
              ]
            }
          },
          "counters": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                },
                "value": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "required": [
                "name",
                "value"
              ]
            }
          },
          "references": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                },
                "reference": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                }
              },
              "required": [
                "kind",
                "reference"
              ]
            }
          },
          "timeline": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reference": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                },
                "type": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                  "maxLength": 128
                },
                "at": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                }
              },
              "required": [
                "reference",
                "type",
                "at"
              ]
            }
          },
          "timeline_truncated": {
            "type": "boolean"
          },
          "custody": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "contract_version": {
                "const": "custody.inventory.v1"
              },
              "authority": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                "maxLength": 128
              },
              "mode": {
                "enum": [
                  "LEGACY_SINGLE",
                  "MULTI_MANIFEST"
                ]
              },
              "legacy_manifest": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "reference": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                        "maxLength": 128
                      },
                      "version": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "pickup_stop": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                        "maxLength": 128
                      },
                      "package_count": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "parcel_references": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 100,
                        "items": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                          "maxLength": 128
                        }
                      },
                      "frozen_at": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "reference",
                      "version",
                      "pickup_stop",
                      "package_count",
                      "parcel_references",
                      "frozen_at"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stops": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "reference": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "type": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "sequence": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "status": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "reference",
                    "type",
                    "sequence",
                    "status",
                    "version"
                  ]
                }
              },
              "manifests": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "reference": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "manifest_version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "pickup_stop": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                          "maxLength": 128
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "authority": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "package_count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "weight_grams": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "volume_ml": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "status": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "custodian": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                          "maxLength": 128
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "reference",
                    "manifest_version",
                    "pickup_stop",
                    "authority",
                    "package_count",
                    "weight_grams",
                    "volume_ml",
                    "required",
                    "status",
                    "custodian",
                    "version"
                  ]
                }
              },
              "packages": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "reference": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "manifest": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "manifest_version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "package_count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "weight_grams": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "volume_ml": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "status": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    }
                  },
                  "required": [
                    "reference",
                    "manifest",
                    "manifest_version",
                    "package_count",
                    "weight_grams",
                    "volume_ml",
                    "status"
                  ]
                }
              },
              "holdings": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "reference": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "manifest": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "manifest_version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "custodian": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "acquired_via": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "acquired_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "release_reason": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                          "maxLength": 128
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "released_at": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "reference",
                    "manifest",
                    "manifest_version",
                    "custodian",
                    "acquired_via",
                    "acquired_at",
                    "release_reason",
                    "released_at"
                  ]
                }
              },
              "transfers": {
                "type": "array",
                "maxItems": 100,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "operation": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "manifest": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "manifest_version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "from": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "package_count": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "operation",
                    "manifest",
                    "manifest_version",
                    "from",
                    "to",
                    "package_count",
                    "at"
                  ]
                }
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "required": [
              "contract_version",
              "authority",
              "mode",
              "legacy_manifest",
              "stops",
              "manifests",
              "packages",
              "holdings",
              "transfers",
              "truncated"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
          }
        },
        "required": [
          "reference",
          "kind",
          "status",
          "source_version",
          "snapshot_etag",
          "created_at",
          "updated_at",
          "dimensions",
          "counters",
          "references",
          "timeline",
          "timeline_truncated"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "custody-missions"
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "custody"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "merchants",
                    "brands",
                    "branches",
                    "food-items",
                    "food-variants",
                    "shop-products",
                    "shop-variants"
                  ]
                }
              }
            },
            "else": {
              "not": {
                "required": [
                  "label"
                ]
              }
            }
          }
        ]
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4096
    }
  },
  "required": [
    "contract_version",
    "owner",
    "kind",
    "scope",
    "policy_id",
    "policy_version",
    "policy_checksum",
    "as_of",
    "coverage",
    "items",
    "next_cursor"
  ]
}
