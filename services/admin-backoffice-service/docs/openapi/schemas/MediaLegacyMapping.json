{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "media.legacy-mapping.v1"
    },
    "legacy_asset_id": {
      "type": "string",
      "format": "uuid"
    },
    "media_object_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
      "maxLength": 128
    },
    "attestation_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "contract_version",
    "legacy_asset_id",
    "media_object_id",
    "attestation_digest"
  ]
}
