# fleet-partner-service configuration example.
# Copy to .env for local development. Never commit real secrets.
# Full documentation: docs/configuration.md

# --- Process ---
APP_ENV=development
HTTP_ADDR=:8113
MIGRATION=true
FLEET_PARTNER_WORKER_ENABLED=true
FLEET_PARTNER_LOG_LEVEL=info
FLEET_PARTNER_SHUTDOWN_TIMEOUT=15s
FLEET_PARTNER_MAX_REQUEST_BODY_BYTES=1048576

# --- Dedicated PostgreSQL (this service's own database; never another service's) ---
FLEET_PARTNER_DATABASE_URL=postgres://cosmicforge_logistics:cosmicforge_logistics@localhost:5445/fleet_partner_service?sslmode=disable
FLEET_PARTNER_DATABASE_MAX_OPEN_CONNECTIONS=10
FLEET_PARTNER_DATABASE_MAX_IDLE_CONNECTIONS=2
FLEET_PARTNER_DATABASE_CONNECTION_MAX_LIFETIME=1h

# --- Redis (optional; bounded operational use only, never a source of truth) ---
FLEET_PARTNER_REDIS_REQUIRED=false
FLEET_PARTNER_REDIS_ADDR=
FLEET_PARTNER_REDIS_PASSWORD=
FLEET_PARTNER_REDIS_DB=0

# --- Authentication (mandatory; no development fallback secrets) ---
# KarryGo corporate authentication is PASSWORDLESS. There is no password
# setting here because no user password exists anywhere in the platform.
# Email + phone are required to start any flow; the OTP is emailed only.
FLEET_PARTNER_ACCESS_TOKEN_SECRET=change-me-development-access-token-secret
# Internal service callers, "name=secret,..." (shared serviceauth format).
FLEET_PARTNER_SERVICE_SECRETS=admin-backoffice-service=change-me-admin-secret

# Peppers the keyed OTP digest. Without it a six-digit code would be
# brute-forceable offline from a leaked table. Startup fails if unset.
FLEET_PARTNER_OTP_HMAC_SECRET=change-me-development-otp-pepper
# Hashes refresh tokens and staff/provider invitation tokens.
FLEET_PARTNER_SESSION_HASH_SECRET=change-me-development-session-secret
# Hashes email/phone for rate-limit keys and security events.
FLEET_PARTNER_CONTACT_HASH_SECRET=change-me-development-contact-secret

# --- OTP policy (bounded by config validation) ---
FLEET_PARTNER_OTP_LENGTH=6
FLEET_PARTNER_OTP_EXPIRY=10m
FLEET_PARTNER_OTP_MAX_ATTEMPTS=5
FLEET_PARTNER_OTP_RESEND_COOLDOWN=60s
FLEET_PARTNER_OTP_MAX_REQUESTS_PER_HOUR=10

# --- Sessions, step-up and invitations ---
FLEET_PARTNER_ACCESS_TOKEN_TTL=15m
FLEET_PARTNER_REFRESH_TOKEN_TTL=720h
FLEET_PARTNER_STEP_UP_TTL=5m
FLEET_PARTNER_STAFF_INVITATION_TTL=168h
FLEET_PARTNER_PROVIDER_INVITATION_TTL=336h
FLEET_PARTNER_AUTHORIZATION_CACHE_TTL=30s

# --- Contact normalization and invitation links ---
# Default country calling code for national-format phone numbers.
FLEET_PARTNER_DEFAULT_COUNTRY_CODE=234
FLEET_PARTNER_STAFF_ACCEPT_URL=
FLEET_PARTNER_PROVIDER_ACCEPT_URL=

# --- Metrics (protected; token mandatory while metrics are enabled) ---
FLEET_PARTNER_METRICS_ENABLED=true
FLEET_PARTNER_METRICS_AUTH_TOKEN=change-me-metrics-token

# --- Workers ---
FLEET_PARTNER_OUTBOX_POLL_INTERVAL=2s
FLEET_PARTNER_JOB_POLL_INTERVAL=2s
FLEET_PARTNER_JOB_LEASE_DURATION=60s
FLEET_PARTNER_JOB_HEARTBEAT_INTERVAL=15s

# --- Downstream platform services (unset = client explicitly not configured) ---
FLEET_PARTNER_HTTP_CLIENT_TIMEOUT=10s
FLEET_PARTNER_CUSTOMER_SERVICE_BASE_URL=
FLEET_PARTNER_CUSTOMER_SERVICE_SECRET=
FLEET_PARTNER_DISPATCH_SERVICE_BASE_URL=
FLEET_PARTNER_DISPATCH_SERVICE_SECRET=
FLEET_PARTNER_TAXI_SERVICE_BASE_URL=
FLEET_PARTNER_TAXI_SERVICE_SECRET=
FLEET_PARTNER_HAULING_SERVICE_BASE_URL=
FLEET_PARTNER_HAULING_SERVICE_SECRET=
FLEET_PARTNER_PAYMENT_WALLET_SERVICE_BASE_URL=
FLEET_PARTNER_PAYMENT_WALLET_SERVICE_SECRET=
FLEET_PARTNER_NOTIFICATION_SERVICE_BASE_URL=
FLEET_PARTNER_NOTIFICATION_SERVICE_SECRET=
FLEET_PARTNER_MEDIA_FILE_SERVICE_BASE_URL=
FLEET_PARTNER_MEDIA_FILE_SERVICE_SECRET=
FLEET_PARTNER_VERIFICATION_COMPLIANCE_SERVICE_BASE_URL=
FLEET_PARTNER_VERIFICATION_COMPLIANCE_SERVICE_SECRET=
FLEET_PARTNER_SUPPORT_DISPUTE_SERVICE_BASE_URL=
FLEET_PARTNER_SUPPORT_DISPUTE_SERVICE_SECRET=
FLEET_PARTNER_ANALYTICS_SERVICE_BASE_URL=
FLEET_PARTNER_ANALYTICS_SERVICE_SECRET=
FLEET_PARTNER_ADMIN_BACKOFFICE_SERVICE_BASE_URL=
FLEET_PARTNER_ADMIN_BACKOFFICE_SERVICE_SECRET=

# --- Integration tests only ---
# FLEET_PARTNER_TEST_DATABASE_URL=postgres://user:pass@localhost:5445/fleet_partner_service_test?sslmode=disable
