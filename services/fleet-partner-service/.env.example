# fleet-partner-service configuration example.
# Copy to .env for local development. Never commit real secrets.
# Full documentation: docs/configuration.md

# --- Process ---
APP_ENV=development
HTTP_ADDR=:8113
MIGRATION=true
FLEET_PARTNER_WORKER_ENABLED=true
FLEET_PARTNER_LOG_LEVEL=info
FLEET_PARTNER_SHUTDOWN_TIMEOUT=15s
FLEET_PARTNER_MAX_REQUEST_BODY_BYTES=1048576

# --- Dedicated PostgreSQL (this service's own database; never another service's) ---
FLEET_PARTNER_DATABASE_URL=
FLEET_PARTNER_DATABASE_MAX_OPEN_CONNECTIONS=10
FLEET_PARTNER_DATABASE_MAX_IDLE_CONNECTIONS=2
FLEET_PARTNER_DATABASE_CONNECTION_MAX_LIFETIME=1h

# --- Redis (optional; bounded operational use only, never a source of truth) ---
FLEET_PARTNER_REDIS_REQUIRED=false
FLEET_PARTNER_REDIS_ADDR=
FLEET_PARTNER_REDIS_PASSWORD=
FLEET_PARTNER_REDIS_DB=0

# --- Authentication (mandatory; no development fallback secrets) ---
# KarryGo corporate authentication is PASSWORDLESS. There is no password
# setting here because no user password exists anywhere in the platform.
# Email + phone are required to start any flow; the OTP is emailed only.
FLEET_PARTNER_ACCESS_TOKEN_SECRET=
# Refresh cookie: always HttpOnly/host-only; Secure outside development/test.
FLEET_PARTNER_AUTH_COOKIE_NAME=karrygo_fleet_refresh
FLEET_PARTNER_AUTH_COOKIE_SAMESITE=lax
# FLEET_PARTNER_AUTH_COOKIE_SECURE=true
# Replace with exact corporate web origin(s), no wildcard/trailing slash.
FLEET_PARTNER_AUTH_WEB_ORIGINS=http://localhost:3000
# Internal service callers, "name=secret,..." (shared serviceauth format).
# Also accepts an optional rotated-version suffix: "name:v2=secret2" (a bare
# "name=secret" entry is always version 1) -- see
# internal/platform/serviceauth.ParseVersionedSecrets.
FLEET_PARTNER_SERVICE_SECRETS=
# Section 28: version-aware, route/method/event-scoped internal-caller
# authorization (fleet_partner_service_credentials, migration 000071) in
# place of single-secret-per-caller verification. Default false -- see
# config.Config.ServiceCredentialScopingEnabled's doc comment for why this
# is opt-in.
FLEET_PARTNER_SERVICE_CREDENTIAL_SCOPING_ENABLED=false
# Section 28: registers the executable-retention durable job handler
# (internal/platform/retentionexec) on the worker. Default false -- real
# anonymize/archive mutations must be an explicit deployment decision. See
# config.Config.RetentionExecutionEnabled's doc comment.
FLEET_PARTNER_RETENTION_EXECUTION_ENABLED=false

# Peppers the keyed OTP digest. Without it a six-digit code would be
# brute-forceable offline from a leaked table. Startup fails if unset.
FLEET_PARTNER_OTP_HMAC_SECRET=
# Hashes refresh tokens and staff/provider invitation tokens.
FLEET_PARTNER_SESSION_HASH_SECRET=
# Hashes email/phone for rate-limit keys and security events.
FLEET_PARTNER_CONTACT_HASH_SECRET=

# --- OTP policy (bounded by config validation) ---
FLEET_PARTNER_OTP_LENGTH=6
FLEET_PARTNER_OTP_EXPIRY=10m
FLEET_PARTNER_OTP_MAX_ATTEMPTS=5
FLEET_PARTNER_OTP_RESEND_COOLDOWN=60s
FLEET_PARTNER_OTP_MAX_REQUESTS_PER_HOUR=10

# --- Sessions, step-up and invitations ---
FLEET_PARTNER_ACCESS_TOKEN_TTL=15m
FLEET_PARTNER_REFRESH_TOKEN_TTL=720h
FLEET_PARTNER_STEP_UP_TTL=5m
FLEET_PARTNER_STAFF_INVITATION_TTL=168h
FLEET_PARTNER_PROVIDER_INVITATION_TTL=336h
FLEET_PARTNER_AUTHORIZATION_CACHE_TTL=30s

# --- Contact normalization and invitation links ---
# Default country calling code for national-format phone numbers.
FLEET_PARTNER_DEFAULT_COUNTRY_CODE=234
FLEET_PARTNER_STAFF_ACCEPT_URL=
FLEET_PARTNER_PROVIDER_ACCEPT_URL=

# --- Metrics (protected; token mandatory while metrics are enabled) ---
FLEET_PARTNER_METRICS_ENABLED=true
FLEET_PARTNER_METRICS_AUTH_TOKEN=

# --- Workers ---
FLEET_PARTNER_OUTBOX_POLL_INTERVAL=2s
FLEET_PARTNER_JOB_POLL_INTERVAL=2s
FLEET_PARTNER_JOB_LEASE_DURATION=60s
FLEET_PARTNER_JOB_HEARTBEAT_INTERVAL=15s

# --- Downstream platform services (unset = client explicitly not configured) ---
FLEET_PARTNER_HTTP_CLIENT_TIMEOUT=10s
FLEET_PARTNER_CUSTOMER_SERVICE_BASE_URL=
FLEET_PARTNER_CUSTOMER_SERVICE_SECRET=
FLEET_PARTNER_DISPATCH_SERVICE_BASE_URL=
FLEET_PARTNER_DISPATCH_SERVICE_SECRET=
FLEET_PARTNER_TAXI_SERVICE_BASE_URL=
FLEET_PARTNER_TAXI_SERVICE_SECRET=
FLEET_PARTNER_HAULING_SERVICE_BASE_URL=
FLEET_PARTNER_HAULING_SERVICE_SECRET=
FLEET_HAULING_INTEGRATION_ENABLED=false
FLEET_TAXI_INTEGRATION_ENABLED=false
# Emergency override: when true every optional execution integration is off.
FLEET_INTEGRATIONS_KILL_SWITCH=false
FLEET_PARTNER_PAYMENT_WALLET_SERVICE_BASE_URL=
FLEET_PARTNER_PAYMENT_WALLET_SERVICE_SECRET=
FLEET_PARTNER_NOTIFICATION_SERVICE_BASE_URL=
FLEET_PARTNER_NOTIFICATION_SERVICE_SECRET=
FLEET_PARTNER_MEDIA_FILE_SERVICE_BASE_URL=
FLEET_PARTNER_MEDIA_FILE_SERVICE_SECRET=
FLEET_PARTNER_VERIFICATION_COMPLIANCE_SERVICE_BASE_URL=
FLEET_PARTNER_VERIFICATION_COMPLIANCE_SERVICE_SECRET=
FLEET_PARTNER_SUPPORT_DISPUTE_SERVICE_BASE_URL=
FLEET_PARTNER_SUPPORT_DISPUTE_SERVICE_SECRET=
FLEET_PARTNER_ACCOUNTING_SERVICE_BASE_URL=
FLEET_PARTNER_ACCOUNTING_SERVICE_SECRET=
FLEET_PARTNER_ANALYTICS_SERVICE_BASE_URL=
FLEET_PARTNER_ANALYTICS_SERVICE_SECRET=
FLEET_PARTNER_ADMIN_BACKOFFICE_SERVICE_BASE_URL=
FLEET_PARTNER_ADMIN_BACKOFFICE_SERVICE_SECRET=

# --- Integration tests only ---
# FLEET_PARTNER_TEST_DATABASE_URL=

# --- Section 13: company wallets and provider sub-wallets ---
#
# Every write and every worker defaults false. The read surface can be enabled
# on its own so an organization can see its wallet before anyone is allowed to
# move money out of it. Enabling a write flag without a configured
# payment-wallet-service client fails startup rather than failing at the moment
# a payment is expected.
ORGANIZATION_WALLET_READ_ENABLED=false
PROVIDER_SUBWALLET_ENABLED=false
PROVIDER_ALLOCATION_ENABLED=false
PROVIDER_WITHDRAWAL_ENABLED=false
WALLET_PROJECTION_REFRESH_ENABLED=false
WALLET_RECONCILIATION_ENABLED=false
FLEET_COMPANY_WALLET_KILL_SWITCH=false
FLEET_COMPANY_WALLET_STALE_SECONDS=900
FLEET_COMPANY_WALLET_WORKER_INTERVAL_SECONDS=10
FLEET_COMPANY_WALLET_WORKER_BATCH_SIZE=25
FLEET_COMPANY_WALLET_WORKER_MAX_ATTEMPTS=8

# --- Section 14: company CRM ---
#
# Section 14 is production implemented: models, repositories, use cases, routes,
# workers and wiring. Every write and every worker defaults false, so a
# deployment that has not deliberately enabled a capability does not have it.
#
# CRM_ENABLED alone opens the READ surface. Each write flag is separate, so an
# operator can be given visibility into CRM without being given the ability to
# commit to a customer. See docs/company-crm.md.
CRM_ENABLED=false
CRM_CUSTOMER_WRITES_ENABLED=false
CRM_CONTACT_WRITES_ENABLED=false
CRM_LOCATION_WRITES_ENABLED=false
CRM_OPPORTUNITIES_ENABLED=false
QUOTATIONS_ENABLED=false
QUOTATION_ISSUE_ENABLED=false
QUOTATION_ACCEPTANCE_ENABLED=false
CONTRACTS_ENABLED=false
CONTRACT_ACTIVATION_ENABLED=false
SLA_ENABLED=false
CUSTOMER_CREDIT_ENABLED=false
FLEET_CRM_KILL_SWITCH=false
CRM_NOTIFICATION_WORKER_ENABLED=false
QUOTATION_EXPIRY_WORKER_ENABLED=false
CONTRACT_EXPIRY_WORKER_ENABLED=false
SLA_EVALUATION_WORKER_ENABLED=false
CONTRACT_RENEWAL_WORKER_ENABLED=false
SLA_ESCALATION_WORKER_ENABLED=false

# CRM worker tuning. One loop drives every enabled CRM worker, so a deployment
# cannot end up with the expiry sweep running and the notification drain not.
FLEET_CRM_WORKER_INTERVAL_SECONDS=30
FLEET_CRM_WORKER_BATCH_SIZE=25
FLEET_CRM_WORKER_MAX_ATTEMPTS=8

# How long an issued quotation's secure customer link stays usable, clamped at
# use to the quotation's own validity window: a link that outlives the offer it
# points at invites an acceptance nobody meant to allow. Default 14 days.
#
# The link is keyed with FLEET_PARTNER_SESSION_HASH_SECRET, which already keys
# refresh and invitation tokens. Only a digest is stored; the raw token is
# returned exactly once, in the issue response, and cannot be retrieved again.
FLEET_QUOTATION_TOKEN_TTL_SECONDS=1209600

# Section 15 private operations. New write surfaces default fail-closed.
SERVICE_CATALOG_ENABLED=false
SERVICE_CATALOG_WRITES_ENABLED=false
ORDERS_ENABLED=false
ORDERS_WRITES_ENABLED=false
FLEET_ORDERS_KILL_SWITCH=false
SHIPMENTS_ENABLED=false
SHIPMENTS_WRITES_ENABLED=false
FLEET_SHIPMENTS_KILL_SWITCH=false
PACKAGES_ENABLED=false
PACKAGES_WRITES_ENABLED=false
PACKAGE_SCANNING_ENABLED=false
FLEET_PACKAGES_KILL_SWITCH=false
MANIFESTS_ENABLED=false
MANIFESTS_WRITES_ENABLED=false
FLEET_MANIFESTS_KILL_SWITCH=false
RECURRING_ORDERS_ENABLED=false
RECURRING_ORDERS_WRITES_ENABLED=false
RECURRING_ORDERS_WORKER_ENABLED=false
FLEET_RECURRING_ORDERS_KILL_SWITCH=false
BULK_IMPORTS_ENABLED=false
BULK_IMPORTS_WRITES_ENABLED=false
PRIVATE_ORDERS_ENABLED=false
PRIVATE_ASSIGNMENTS_WRITES_ENABLED=false
PRIVATE_ASSIGNMENTS_WORKER_ENABLED=false
PRIVATE_DISPATCH_EXECUTION_ENABLED=false
PRIVATE_HAULING_EXECUTION_ENABLED=false
PRIVATE_TAXI_EXECUTION_ENABLED=false
PRIVATE_EXECUTION_WORKER_ENABLED=false
FLEET_PRIVATE_OPERATIONS_KILL_SWITCH=false
FLEET_PRIVATE_ASSIGNMENT_RESPONSE_TTL_SECONDS=1800
BULK_IMPORTS_WORKER_ENABLED=false
FLEET_BULK_IMPORTS_KILL_SWITCH=false
FLEET_BULK_IMPORT_MAX_BYTES=10485760
FLEET_BULK_IMPORT_MAX_ROWS=5000

# --- Section 16: dispatch, routes, live control and tracking ---
# Reads, writes and workers are independently gated and all default false.
# The global FLEET_INTEGRATIONS_KILL_SWITCH overrides writes and workers.
DISPATCH_PLANNING_ENABLED=false
ROUTE_PLANNING_ENABLED=false
ROUTE_OPTIMIZATION_ENABLED=false
ROUTE_PUBLICATION_ENABLED=false
CONTROL_TOWER_ENABLED=false
TRACKING_PROJECTIONS_ENABLED=false
GEOFENCES_ENABLED=false
OPERATIONAL_ALERTS_ENABLED=false
FLEET_SECTION16_WORKERS_ENABLED=false
FLEET_SECTION16_CANDIDATE_TTL_SECONDS=300
FLEET_SECTION16_TRACKING_FRESH_SECONDS=120
FLEET_SECTION16_TRACKING_STALE_SECONDS=600
FLEET_SECTION16_TRACKING_RETENTION_SECONDS=86400
FLEET_SECTION16_ALERT_SLA_SECONDS=1800

# Optional provider-neutral optimization authority. Enabling optimization
# without both values is rejected at startup. Manual planning stays available.
FLEET_PARTNER_ROUTE_OPTIMIZATION_SERVICE_BASE_URL=
FLEET_PARTNER_ROUTE_OPTIMIZATION_SERVICE_SECRET=
# Sections 17 and 18 (all new writes/workers default closed)
WORKFORCE_ENABLED=false
SHIFTS_ENABLED=false
LEAVE_ENABLED=false
QUALIFICATIONS_ENABLED=false
TRAINING_ENABLED=false
PERFORMANCE_SNAPSHOTS_ENABLED=false
ASSETS_ENABLED=false
ASSET_ASSIGNMENTS_ENABLED=false
INSPECTIONS_ENABLED=false
MAINTENANCE_ENABLED=false
BREAKDOWNS_ENABLED=false
PARTS_INVENTORY_ENABLED=false
FUEL_RECORDS_ENABLED=false
SECTION17_WORKERS_ENABLED=false
SECTION18_WORKERS_ENABLED=false

# Sections 19-21. All writes, modules and workers default closed.
COMPLIANCE_ENABLED=false
SAFETY_REPORTS_ENABLED=false
INCIDENTS_ENABLED=false
PROOF_POLICIES_ENABLED=false
PROOF_RECORDS_ENABLED=false
RESTRICTION_PROPAGATION_ENABLED=false
FLEET_PROOF_HMAC_SECRET=
SECTION19_WORKERS_ENABLED=false

SPECIALIZED_LOGISTICS_ENABLED=false
COURIER_LAST_MILE_ENABLED=false
# Taxi records are data-only; this does not enable publication or execution.
TAXI_PASSENGER_ENABLED=false
TRUCKING_HAULAGE_ENABLED=false
HEAVY_SPECIALIZED_ENABLED=false
FREIGHT_FORWARDING_ENABLED=false
COLD_CHAIN_ENABLED=false
MEDICAL_SENSITIVE_ENABLED=false
AGRICULTURAL_FOOD_ENABLED=false
MOVING_RELOCATION_ENABLED=false
TOWING_RECOVERY_ENABLED=false
SECTION20_WORKERS_ENABLED=false

WAREHOUSES_ENABLED=false
WAREHOUSE_INVENTORY_ENABLED=false
FULFILMENT_ENABLED=false
DOCK_OPERATIONS_ENABLED=false
YARD_OPERATIONS_ENABLED=false
TERMINAL_TRANSFERS_ENABLED=false
RETURNS_ENABLED=false
SECTION21_WORKERS_ENABLED=false

# Sections 22 and 23. Every capability and scheduler defaults closed.
INVOICES_ENABLED=false
RECEIVABLES_ENABLED=false
EXPENSES_ENABLED=false
BUDGETS_ENABLED=false
COMPENSATION_ENABLED=false
PAYROLL_ENABLED=false
SUBCONTRACTOR_SETTLEMENTS_ENABLED=false
CLAIMS_ENABLED=false
FINANCE_POSTING_ENABLED=false
COMMUNICATIONS_ENABLED=false
NOTIFICATION_RULES_ENABLED=false
SUPPORT_PROJECTIONS_ENABLED=false
QUALITY_CASES_ENABLED=false
SLA_MEASUREMENTS_ENABLED=false
ESCALATIONS_ENABLED=false
SECTION22_WORKERS_ENABLED=false
SECTION23_WORKERS_ENABLED=false
SEARCH_ENABLED=false
FLEET_SYNCHRONIZATION_ENABLED=false
FLEET_SYNCHRONIZATION_WORKER_ENABLED=false
FLEET_SYNCHRONIZATION_KILL_SWITCH=false

# Section 55 organization API clients and outbound webhooks. All three
# capabilities default closed. Key material has no default and is mandatory
# only when the corresponding feature is enabled.
FLEET_PARTNER_ORGANIZATION_API_CLIENTS_ENABLED=false
FLEET_PARTNER_WEBHOOKS_ENABLED=false
FLEET_PARTNER_WEBHOOK_DELIVERY_WORKER_ENABLED=false
FLEET_PARTNER_API_CLIENT_HASH_KEY=
# Exactly 32 bytes; stored webhook secrets are AES-256-GCM ciphertext.
FLEET_PARTNER_WEBHOOK_SECRET_ENCRYPTION_KEY=
# Development-only escape hatch. Production startup rejects true.
FLEET_PARTNER_WEBHOOK_ALLOW_HTTP=false
# Optional comma-separated enterprise CIDRs. Loopback, link-local,
# unspecified and metadata destinations remain prohibited.
FLEET_PARTNER_WEBHOOK_PRIVATE_DESTINATION_ALLOWLIST=
FLEET_PARTNER_WEBHOOK_DELIVERY_TIMEOUT=15s
FLEET_PARTNER_WEBHOOK_REPLAY_WINDOW=5m
FLEET_PARTNER_WEBHOOK_ROTATION_OVERLAP_MAX=1h
FLEET_PARTNER_WEBHOOK_DISABLE_AFTER_FAILURES=5
FLEET_PARTNER_WEBHOOK_DELIVERY_MAX_ATTEMPTS=12
FLEET_PARTNER_WEBHOOK_FANOUT_INTERVAL=2s
FLEET_PARTNER_WEBHOOK_FANOUT_BATCH_SIZE=50

# Section 30: HMAC-authenticated provider login/session compatibility reader.
# Provider services must also opt in with PROVIDER_ORGANIZATION_MODE_ENABLED.
PROVIDER_MEMBERSHIP_ALLOWED_CALLERS=driver-dispatch-delivery-service,driver-hauling-service
