    "/fleet-partner/v1/auth/phone/change": {
      "post": {
        "summary": "Change associated phone using a single-use, session-bound email step-up grant",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured trusted web origin."
          }
        ],
        "security": [
          {
            "BearerAccess": []
          }
        ],
        "responses": {
          "202": {
            "description": "Existing non-secret auth response."
          },
          "401": {
            "description": "Missing, invalid, revoked, expired or replayed session credential."
          },
          "403": {
            "description": "Missing or untrusted browser Origin."
          },
          "429": {
            "description": "Existing auth abuse limits."
          },
          "503": {
            "description": "Authentication dependency unavailable."
          },
          "409": {
            "description": "phone_already_associated; no association changed"
          }
        },
        "description": "Start step-up with actionClass phone_change:<E.164>, verify its emailed code, then submit this request in the same session/organization. This associates a phone and never claims SMS verification.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "phone",
                  "stepUpReference"
                ],
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "stepUpReference": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BrowserRefresh": {
        "type": "apiKey",
        "in": "cookie",
        "name": "karrygo_fleet_refresh"
      },
      "BearerAccess": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "AccessSessionEnvelope": {
        "type": "object",
        "description": "Verify nests access fields under data.tokens alongside nextStep/organizations; refresh/select return access fields directly under data.",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AccessSession"
              },
              {
                "type": "object",
                "properties": {
                  "tokens": {
                    "$ref": "#/components/schemas/AccessSession"
                  },
                  "nextStep": {
                    "type": "string"
                  },
                  "identityId": {
                    "type": "string"
                  },
                  "organizations": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "AccessSession": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "accessExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "refreshExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sessionId": {
            "type": "string"
          }
        }
      }
    }
  }
}
