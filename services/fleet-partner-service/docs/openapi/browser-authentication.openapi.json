            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured trusted web origin."
          }
        ],
        "security": [],
        "responses": {
          "202": {
            "description": "Notification Service accepted email request; actual inbox delivery is asynchronous.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "challengeId",
                        "maskedDestination",
                        "expiresAt",
                        "resendAvailableAt"
                      ],
                      "properties": {
                        "challengeId": {
                          "type": "string"
                        },
                        "deliveryChannel": {
                          "type": "string",
