{
  "openapi": "3.0.3",
  "info": {
    "title": "Fleet Corporate Browser Authentication",
    "version": "2.0.0",
    "description": "Focused browser auth contract supplement. Existing request DTOs remain authoritative; no JSON refresh credential accepted/returned. SameSite deployment policy must match trusted origins. Cookie Path: /fleet-partner/v1/auth"
  },
  "paths": {
    "/fleet-partner/v1/auth/start": {
      "post": {
        "summary": "Deprecated signup-only alias; no existing-account login",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured trusted web origin."
          }
        ],
        "security": [],
        "responses": {
          "202": {
            "description": "Notification Service accepted email request; actual inbox delivery is asynchronous.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "challengeId",
                        "maskedDestination",
                        "expiresAt",
                        "resendAvailableAt"
                      ],
                      "properties": {
                        "challengeId": {
                          "type": "string"
                        },
                        "deliveryChannel": {
                          "type": "string",
                          "enum": [
                            "EMAIL"
                          ]
                        },
                        "deliveryStatus": {
                          "type": "string",
                          "enum": [
                            "ACCEPTED"
                          ]
                        },
                        "maskedDestination": {
                          "type": "string"
                        },
                        "expiresAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "resendAvailableAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "expiresInSeconds": {
                          "type": "integer"
                        },
                        "resendAfterSeconds": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked, expired or replayed session credential."
          },
          "403": {
            "description": "Missing or untrusted browser Origin."
          },
          "429": {
            "description": "Existing auth abuse limits."
          },
          "503": {
            "description": "Authentication dependency unavailable."
          },
          "409": {
            "description": "email_already_registered or phone_already_associated; zero OTP generation/delivery"
          },
          "422": {
            "description": "Field-specific validation_failed"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "phone"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+[1-9][0-9]{7,14}$"
                  },
                  "invitationToken": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "deprecated": true
      }
    },
    "/fleet-partner/v1/auth/verify": {
      "post": {
        "summary": "verify",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Exact configured trusted web origin."
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Access credential and safe session metadata only. Refresh secret exclusively in Set-Cookie.",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly; host-only; Secure in production; SameSite=Lax by default; auth-scoped Path; Max-Age/Expires match the server session. Confidential; never expose through browser JavaScript.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessSessionEnvelope"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked, expired or replayed session credential."
          },
          "403": {
            "description": "Missing or untrusted browser Origin."
          },
          "429": {
            "description": "Existing auth abuse limits."
          },
          "503": {
            "description": "Authentication dependency unavailable."
          }
        }
      }
    },
