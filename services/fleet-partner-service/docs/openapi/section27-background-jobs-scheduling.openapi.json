{
  "openapi": "3.1.0",
  "info": {"title": "KarryGo Fleet Partner Section 27 Background Jobs and Scheduling API", "version": "27.1.0"},
  "paths": {
    "/fleet-partner/v1/jobs": {"get": {"operationId": "listJobs", "x-permission": "jobs.read", "parameters": [{"name": "status", "in": "query", "schema": {"type": "string"}}, {"name": "jobType", "in": "query", "schema": {"type": "string"}}, {"name": "limit", "in": "query", "schema": {"type": "integer"}}], "responses": {"200": {"description": "Organization-scoped job summaries; never includes the raw payload."}}}},
    "/fleet-partner/v1/jobs/{jobId}": {"get": {"operationId": "getJob", "x-permission": "jobs.read", "parameters": [{"name": "jobId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Safe job summary."}}}},
    "/fleet-partner/v1/jobs/{jobId}/attempts": {"get": {"operationId": "listJobAttempts", "x-permission": "jobs.read", "parameters": [{"name": "jobId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Immutable, safe attempt history."}}}},
    "/fleet-partner/v1/jobs/{jobId}/retry": {"post": {"operationId": "retryJob", "x-permission": "jobs.retry", "parameters": [{"name": "jobId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Dead-lettered job replayed to PENDING."}, "404": {"description": "Job not found, or not eligible (must be dead-lettered)."}}}},
    "/fleet-partner/v1/jobs/{jobId}/cancel": {"post": {"operationId": "cancelJob", "x-permission": "jobs.cancel", "parameters": [{"name": "jobId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Pending/retry-scheduled job cancelled."}, "409": {"description": "Job not found, or not cancellable."}}}},
    "/fleet-partner/v1/scheduled-tasks": {"get": {"operationId": "listScheduledTasks", "x-permission": "scheduled_tasks.read", "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer"}}], "responses": {"200": {"description": "Organization-scoped scheduled tasks; never includes the raw payload."}}}},
    "/fleet-partner/v1/scheduled-tasks/{taskId}": {"get": {"operationId": "getScheduledTask", "x-permission": "scheduled_tasks.read", "parameters": [{"name": "taskId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Safe scheduled-task summary."}}}},
    "/fleet-partner/v1/scheduled-tasks/{taskId}/runs": {"get": {"operationId": "listScheduledTaskRuns", "x-permission": "scheduled_tasks.read", "parameters": [{"name": "taskId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Immutable scheduler decision history."}}}},
    "/fleet-partner/v1/scheduled-tasks/{taskId}/enable": {"post": {"operationId": "enableScheduledTask", "x-permission": "scheduled_tasks.manage", "parameters": [{"name": "taskId", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"expectedVersion": {"type": "integer"}}, "required": ["expectedVersion"]}}}}, "responses": {"200": {"description": "Task enabled."}, "409": {"description": "Expected version does not match."}}}},
    "/fleet-partner/v1/scheduled-tasks/{taskId}/disable": {"post": {"operationId": "disableScheduledTask", "x-permission": "scheduled_tasks.manage", "parameters": [{"name": "taskId", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"expectedVersion": {"type": "integer"}}, "required": ["expectedVersion"]}}}}, "responses": {"200": {"description": "Task disabled."}, "409": {"description": "Expected version does not match."}}}},
    "/fleet-partner/v1/scheduled-tasks/{taskId}/run-now": {"post": {"operationId": "runScheduledTaskNow", "x-permission": "scheduled_tasks.run", "parameters": [{"name": "taskId", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"expectedVersion": {"type": "integer"}}, "required": ["expectedVersion"]}}}}, "responses": {"200": {"description": "Task forced to be immediately due; does not run the job inline and does not alter the ordinary schedule."}, "409": {"description": "Expected version does not match."}}}},
    "/internal/fleet-partner/v1/worker-operations/jobs": {"get": {"operationId": "listPlatformJobs", "x-auth-class": "internal-hmac-v2", "parameters": [{"name": "status", "in": "query", "schema": {"type": "string"}}, {"name": "jobType", "in": "query", "schema": {"type": "string"}}, {"name": "limit", "in": "query", "schema": {"type": "integer"}}], "responses": {"200": {"description": "Service-global (organization_id IS NULL) job summaries only -- never another organization's jobs."}}}},
    "/internal/fleet-partner/v1/worker-operations/jobs/{jobId}": {"get": {"operationId": "getPlatformJob", "x-auth-class": "internal-hmac-v2", "parameters": [{"name": "jobId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Safe platform-scoped job summary."}, "404": {"description": "Not found, or the job is tenant-owned (never disclosed here)."}}}},
    "/internal/fleet-partner/v1/worker-operations/jobs/{jobId}/attempts": {"get": {"operationId": "listPlatformJobAttempts", "x-auth-class": "internal-hmac-v2", "parameters": [{"name": "jobId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Immutable, safe attempt history."}}}},
    "/internal/fleet-partner/v1/worker-operations/jobs/{jobId}/retry": {"post": {"operationId": "retryPlatformJob", "x-auth-class": "internal-hmac-v2", "parameters": [{"name": "jobId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Dead-lettered platform job replayed to PENDING."}, "404": {"description": "Not found, or not eligible."}}}},
    "/internal/fleet-partner/v1/worker-operations/jobs/{jobId}/cancel": {"post": {"operationId": "cancelPlatformJob", "x-auth-class": "internal-hmac-v2", "parameters": [{"name": "jobId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Pending/retry-scheduled platform job cancelled."}, "409": {"description": "Not found, or not cancellable."}}}},
    "/internal/fleet-partner/v1/worker-operations/scheduled-tasks": {"get": {"operationId": "listPlatformScheduledTasks", "x-auth-class": "internal-hmac-v2", "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer"}}], "responses": {"200": {"description": "Service-global scheduled tasks only."}}}},
    "/internal/fleet-partner/v1/worker-operations/scheduled-tasks/{taskId}": {"get": {"operationId": "getPlatformScheduledTask", "x-auth-class": "internal-hmac-v2", "parameters": [{"name": "taskId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Safe platform-scoped scheduled-task summary."}}}},
    "/internal/fleet-partner/v1/worker-operations/scheduled-tasks/{taskId}/runs": {"get": {"operationId": "listPlatformScheduledTaskRuns", "x-auth-class": "internal-hmac-v2", "parameters": [{"name": "taskId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Immutable scheduler decision history."}}}},
    "/internal/fleet-partner/v1/worker-operations/scheduled-tasks/{taskId}/enable": {"post": {"operationId": "enablePlatformScheduledTask", "x-auth-class": "internal-hmac-v2", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"expectedVersion": {"type": "integer"}}, "required": ["expectedVersion"]}}}}, "parameters": [{"name": "taskId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Task enabled."}, "409": {"description": "Expected version does not match."}}}},
    "/internal/fleet-partner/v1/worker-operations/scheduled-tasks/{taskId}/disable": {"post": {"operationId": "disablePlatformScheduledTask", "x-auth-class": "internal-hmac-v2", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"expectedVersion": {"type": "integer"}}, "required": ["expectedVersion"]}}}}, "parameters": [{"name": "taskId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Task disabled."}, "409": {"description": "Expected version does not match."}}}},
    "/internal/fleet-partner/v1/worker-operations/scheduled-tasks/{taskId}/run-now": {"post": {"operationId": "runPlatformScheduledTaskNow", "x-auth-class": "internal-hmac-v2", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"expectedVersion": {"type": "integer"}}, "required": ["expectedVersion"]}}}}, "parameters": [{"name": "taskId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Task forced immediately due."}, "409": {"description": "Expected version does not match."}}}},
    "/internal/fleet-partner/v1/operations/backlogs": {"get": {"operationId": "getPlatformBacklogs", "x-auth-class": "internal-hmac-v2", "responses": {"200": {"description": "Section 29: platform-wide job and outbox backlog/staleness snapshot."}}}},
    "/internal/fleet-partner/v1/operations/outbox/replay": {"post": {"operationId": "replayOutboxRecord", "x-auth-class": "internal-hmac-v2", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"recordId": {"type": "string"}}, "required": ["recordId"]}}}}, "responses": {"200": {"description": "Section 29: exactly one dead-lettered outbox record replayed to PENDING."}, "404": {"description": "Not found, or not currently dead-lettered."}}}}
  },
  "components": {"securitySchemes": {
    "CorporateBearer": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"},
    "InternalServiceHmac": {"type": "apiKey", "in": "header", "name": "X-Service-Signature", "description": "HMAC v2 service-to-service auth (shared/go/serviceauth) plus a per-route caller allowlist (WORKER_OPERATIONS_ALLOWED_CALLERS)."}
  }},
  "security": [{"CorporateBearer": []}]
}
