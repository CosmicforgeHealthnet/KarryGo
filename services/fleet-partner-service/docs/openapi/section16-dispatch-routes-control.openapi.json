  "components": {
    "securitySchemes": {"CorporateBearer":{"type":"http","scheme":"bearer","bearerFormat":"JWT"},"ServiceHMACv2":{"type":"apiKey","in":"header","name":"X-Service-Signature"}},
    "parameters": {
      "IdempotencyKey":{"name":"Idempotency-Key","in":"header","required":true,"schema":{"type":"string","minLength":1,"maxLength":200}},
      "IfMatch":{"name":"If-Match","in":"header","required":false,"description":"Positive expected aggregate version; expectedVersion in JSON is equivalent.","schema":{"type":"string"}},
      "BranchId":{"name":"branchId","in":"query","schema":{"type":"string"}},"Limit":{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":200}},"Offset":{"name":"offset","in":"query","schema":{"type":"integer","minimum":0}},
      "PlanId":{"name":"planId","in":"path","required":true,"schema":{"type":"string"}},"RouteId":{"name":"routeId","in":"path","required":true,"schema":{"type":"string"}},"StopId":{"name":"stopId","in":"path","required":true,"schema":{"type":"string"}},"GeofenceId":{"name":"geofenceId","in":"path","required":true,"schema":{"type":"string"}},"AlertId":{"name":"alertId","in":"path","required":true,"schema":{"type":"string"}}
    },
    "schemas": {
      "VersionedCommand":{"type":"object","properties":{"expectedVersion":{"type":"integer","minimum":1},"reason":{"type":"string"}}},
      "CreateDispatchPlan":{"type":"object","required":["branchId","planDate","workWindowStart","workWindowEnd","timezone"],"properties":{"branchId":{"type":"string"},"planDate":{"type":"string","format":"date"},"workWindowStart":{"type":"string","format":"date-time"},"workWindowEnd":{"type":"string","format":"date-time"},"timezone":{"type":"string"}}},
      "CreateRoute":{"type":"object","required":["branchId","routeReference","routeType","executionService"],"properties":{"branchId":{"type":"string"},"dispatchPlanId":{"type":"string"},"routeReference":{"type":"string"},"routeType":{"enum":["DELIVERY","HAULING","WAREHOUSE_TRANSFER","RETURN","MIXED"]},"providerMembershipId":{"type":"string"},"providerId":{"type":"string"},"vehicleOrTruckReference":{"type":"string"},"executionService":{"enum":["DISPATCH","HAULING"]},"constraintSnapshot":{"type":"object"}}},
      "RouteStop":{"type":"object","required":["stopType"],"properties":{"stopType":{"enum":["PICKUP","DELIVERY","WAREHOUSE_TRANSFER","RETURN","DEPOT_START","DEPOT_END"]},"orderId":{"type":"string"},"shipmentId":{"type":"string"},"packageId":{"type":"string"},"manifestId":{"type":"string"},"sourceOrderStopId":{"type":"string"},"locationReference":{"type":"string"},"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180},"timeWindowStart":{"type":"string","format":"date-time"},"timeWindowEnd":{"type":"string","format":"date-time"},"serviceDurationSeconds":{"type":"integer","minimum":0},"version":{"type":"integer","minimum":1}}},
      "Candidate":{"type":"object","required":["eligibilityStatus","totalScore","scoreComponents","eligibilityReasons","warnings","hardBlocks","dataFreshness","expiresAt","sourceVersions"],"properties":{"eligibilityStatus":{"enum":["ELIGIBLE","INELIGIBLE","UNKNOWN","STALE"]},"totalScore":{"type":"integer","minimum":0,"maximum":100},"scoreComponents":{"type":"array","items":{"$ref":"#/components/schemas/ScoreComponent"}},"eligibilityReasons":{"type":"array","items":{"type":"string"}},"warnings":{"type":"array","items":{"type":"string"}},"hardBlocks":{"type":"array","items":{"type":"string"}},"dataFreshness":{"$ref":"#/components/schemas/Freshness"},"expiresAt":{"type":"string","format":"date-time"},"sourceVersions":{"type":"object","additionalProperties":{"type":"integer"}}}},
      "ScoreComponent":{"type":"object","required":["name","points","reason"],"properties":{"name":{"type":"string"},"points":{"type":"integer"},"reason":{"type":"string"}}},
      "PublishRoute":{"allOf":[{"$ref":"#/components/schemas/VersionedCommand"},{"type":"object","properties":{"overrideReason":{"type":"string","description":"Required for allowed warnings and requires dispatch.override_warning. Hard blocks cannot be overridden."}}}]},
      "Freshness":{"type":"string","enum":["FRESH","AGING","STALE","UNKNOWN","GAPPED"]},
      "TrackingProjection":{"type":"object","required":["sourceService","canonicalTripReference","operationalStatus","sourceTimestamp","receivedAt","sourceVersion","freshnessStatus","gapStatus"],"properties":{"sourceService":{"enum":["driver-dispatch-delivery-service","driver-hauling-service"]},"canonicalTripReference":{"type":"string"},"assignmentId":{"type":"string"},"routePlanId":{"type":"string"},"providerId":{"type":"string"},"vehicleOrTruckReference":{"type":"string"},"latitude":{"type":"number"},"longitude":{"type":"number"},"operationalStatus":{"type":"string"},"sourceTimestamp":{"type":"string","format":"date-time"},"receivedAt":{"type":"string","format":"date-time"},"sourceVersion":{"type":"integer","minimum":1},"freshnessStatus":{"$ref":"#/components/schemas/Freshness"},"gapStatus":{"enum":["CURRENT","GAP_DETECTED","CONFLICT","RECONCILING"]}}},
      "TrackingEvent":{"type":"object","required":["eventId","organizationId","canonicalTripReference","sourceTimestamp","sourceVersion"],"properties":{"eventId":{"type":"string"},"organizationId":{"type":"string"},"canonicalTripReference":{"type":"string"},"assignmentId":{"type":"string"},"routePlanId":{"type":"string"},"providerId":{"type":"string"},"vehicleOrTruckReference":{"type":"string"},"latitude":{"type":"number"},"longitude":{"type":"number"},"heading":{"type":"number"},"speed":{"type":"number"},"accuracy":{"type":"number"},"operationalStatus":{"type":"string"},"sourceTimestamp":{"type":"string","format":"date-time"},"sourceVersion":{"type":"integer","minimum":1},"reconcilesThroughVersion":{"type":"integer","minimum":1,"description":"Authoritative source attestation that continuity has been read back through this version; only this may clear a prior gap."}}},
      "Point":{"type":"object","required":["latitude","longitude"],"properties":{"latitude":{"type":"number","minimum":-90,"maximum":90},"longitude":{"type":"number","minimum":-180,"maximum":180}}},
      "Geometry":{"type":"object","properties":{"center":{"$ref":"#/components/schemas/Point"},"radiusMeters":{"type":"number","exclusiveMinimum":0},"points":{"type":"array","minItems":4,"items":{"$ref":"#/components/schemas/Point"}}}},
      "Geofence":{"type":"object","required":["name","geometryType","geometry","eventRules"],"properties":{"branchId":{"type":"string"},"name":{"type":"string"},"geometryType":{"enum":["CIRCLE","POLYGON"]},"geometry":{"$ref":"#/components/schemas/Geometry"},"geometryReference":{"type":"string"},"eventRules":{"type":"array","items":{"enum":["ENTER","EXIT","DWELL","ROUTE_DEVIATION","RESTRICTED_AREA"]}},"expectedVersion":{"type":"integer","minimum":1}}},
      "OperationalAlert":{"type":"object","properties":{"alertType":{"type":"string"},"severity":{"enum":["INFO","LOW","MEDIUM","HIGH","CRITICAL"]},"status":{"enum":["OPEN","ACKNOWLEDGED","IN_PROGRESS","RESOLVED","DISMISSED"]},"ownerUserId":{"type":"string"},"slaDueAt":{"type":"string","format":"date-time"},"resolutionCode":{"type":"string"},"resolutionReason":{"type":"string"},"version":{"type":"integer"}}},
      "ResolveAlert":{"type":"object","required":["resolutionCode","resolutionReason"],"properties":{"expectedVersion":{"type":"integer","minimum":1},"resolutionCode":{"type":"string","minLength":1},"resolutionReason":{"type":"string","minLength":1}}},
      "BoardResponse":{"type":"object","properties":{"unassigned":{"type":"array","items":{"type":"object"}},"pendingAssignments":{"type":"array","items":{"type":"object"}},"acceptedAssignments":{"type":"array","items":{"type":"object"}},"activeRoutes":{"type":"array","items":{"type":"object"}},"activeTrips":{"type":"array","items":{"$ref":"#/components/schemas/TrackingProjection"}},"alerts":{"type":"array","items":{"$ref":"#/components/schemas/OperationalAlert"}},"trackingSummary":{"type":"object"},"capacitySummary":{"type":"object","additionalProperties":{"type":"integer"}},"providerAvailability":{"type":"array","items":{"type":"object"}},"vehicleAvailability":{"type":"array","items":{"type":"object"}},"projectionGaps":{"type":"array","items":{"type":"object"}},"projectionIncomplete":{"type":"boolean"},"reconciliationRequired":{"type":"boolean"}}},
      "OptimizationResult":{"type":"object","properties":{"sequence":{"type":"array","items":{"type":"string"}},"estimatedDistance":{"type":"number"},"estimatedDurationSeconds":{"type":"integer"},"constraintViolations":{"type":"array","items":{"type":"string"}},"unservedStops":{"type":"array","items":{"type":"string"}},"warnings":{"type":"array","items":{"type":"string"}},"providerReference":{"type":"string"},"providerJobReference":{"type":"string"},"inputFingerprint":{"type":"string"},"resultVersion":{"type":"integer"}}}
    }
  }
}
