    },
    "/fleet-partner/v1/integrations/api-clients/{id}/revoke": {
      "post": {"operationId":"revokeOrganizationApiClient","security":[{"CorporateBearer":[]}],"x-permission":"integrations.manage","x-step-up":true,"x-idempotency-key":true,"x-expected-version":true,"parameters":[{"$ref":"#/components/parameters/Id"}],"responses":{"200":{"description":"Revocation is immediate"},"409":{"$ref":"#/components/responses/Error"}}}
    },
    "/fleet-partner/v1/integrations/webhooks": {
