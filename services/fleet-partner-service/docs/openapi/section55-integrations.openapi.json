    },
    "/fleet-partner/v1/integrations/webhooks/{id}/deliveries": {
      "get": {"operationId":"listWebhookDeliveries","security":[{"CorporateBearer":[]}],"x-permission":"integrations.read","parameters":[{"$ref":"#/components/parameters/Id"}],"responses":{"200":{"description":"Redacted delivery history; request bodies and secrets are excluded"}}}
    },
    "/fleet-partner/v1/integrations/webhook-deliveries/{id}/replay": {
      "post": {"operationId":"replayWebhookDelivery","security":[{"CorporateBearer":[]}],"x-permission":"webhooks.manage","x-step-up":true,"x-idempotency-key":true,"parameters":[{"$ref":"#/components/parameters/Id"}],"responses":{"201":{"description":"Controlled new attempt preserving the original history"},"404":{"$ref":"#/components/responses/Error"}}}
