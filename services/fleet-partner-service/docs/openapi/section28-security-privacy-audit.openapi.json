{
  "openapi": "3.1.0",
  "info": {"title": "KarryGo Fleet Partner Section 28 Security, Privacy and Audit API", "version": "28.1.0"},
  "paths": {
    "/fleet-partner/v1/audit-logs": {"get": {"operationId": "listAuditLogs", "x-permission": "audit.read", "parameters": [{"name": "branchId", "in": "query", "schema": {"type": "string"}}, {"name": "actorType", "in": "query", "schema": {"type": "string"}}, {"name": "actorId", "in": "query", "schema": {"type": "string"}}, {"name": "action", "in": "query", "schema": {"type": "string"}}, {"name": "resourceType", "in": "query", "schema": {"type": "string"}}, {"name": "resourceId", "in": "query", "schema": {"type": "string"}}, {"name": "requestId", "in": "query", "schema": {"type": "string"}}, {"name": "correlationId", "in": "query", "schema": {"type": "string"}}, {"name": "highRiskOnly", "in": "query", "schema": {"type": "boolean"}}, {"name": "from", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "to", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "cursor", "in": "query", "schema": {"type": "string"}}, {"name": "limit", "in": "query", "schema": {"type": "integer"}}], "responses": {"200": {"description": "Organization- and branch-scoped audit-log summaries. Before/after value summaries and network metadata are never included in the list response, even for a caller holding audit.read_sensitive -- those are detail-route-only."}, "400": {"description": "Invalid filter, or a from/to span exceeding 90 days."}}}},
    "/fleet-partner/v1/audit-logs/{auditId}": {"get": {"operationId": "getAuditLog", "x-permission": "audit.read", "parameters": [{"name": "auditId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Single audit record. previousSummary/newSummary/networkMeta are populated only when the caller also holds audit.read_sensitive."}, "404": {"description": "Not found, or belongs to a different organization (indistinguishable)."}}}},
    "/fleet-partner/v1/audit/verify-chain": {"post": {"operationId": "verifyAuditChain", "x-permission": "security.audit_chain.verify", "requestBody": {"required": false, "content": {"application/json": {"schema": {"type": "object", "properties": {"month": {"type": "string", "description": "YYYY-MM; defaults to the current UTC calendar month when omitted."}}}}}}, "responses": {"200": {"description": "Recomputes the tamper-evident hash chain (HMAC-SHA256, migration 000069) for the caller's own organization and the given calendar month, and reports whether it is intact. Never returns record content -- only IDs, counts, and break reasons -- so this route does not additionally require audit.read_sensitive."}, "400": {"description": "month is not formatted YYYY-MM."}}}},
    "/fleet-partner/v1/legal-holds": {
      "post": {"operationId": "createLegalHold", "x-permission": "privacy.legal_hold.manage", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"scopeType": {"type": "string", "enum": ["ORGANIZATION", "CUSTOMER", "PROVIDER", "TRIP", "ASSIGNMENT", "INCIDENT", "SUPPORT_CASE", "INVOICE", "EXPORT", "AUDIT_RANGE"]}, "scopeReference": {"type": "string"}, "reason": {"type": "string"}, "approvedByActorId": {"type": "string"}, "stepUpReference": {"type": "string"}}, "required": ["scopeType", "scopeReference", "reason"]}}}}, "responses": {"201": {"description": "Legal hold created (ACTIVE)."}, "422": {"description": "scopeType unsupported or reason missing."}}},
      "get": {"operationId": "listLegalHolds", "x-permission": "privacy.legal_hold.read", "parameters": [{"name": "scopeType", "in": "query", "schema": {"type": "string"}}, {"name": "scopeReference", "in": "query", "schema": {"type": "string"}}, {"name": "status", "in": "query", "schema": {"type": "string"}}, {"name": "limit", "in": "query", "schema": {"type": "integer"}}], "responses": {"200": {"description": "Organization-scoped legal holds."}}}
    },
    "/fleet-partner/v1/legal-holds/{holdId}": {"get": {"operationId": "getLegalHold", "x-permission": "privacy.legal_hold.read", "parameters": [{"name": "holdId", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Single legal hold."}, "404": {"description": "Not found, or belongs to a different organization."}}}},
    "/fleet-partner/v1/legal-holds/{holdId}/release": {"post": {"operationId": "releaseLegalHold", "x-permission": "privacy.legal_hold.release", "parameters": [{"name": "holdId", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"expectedVersion": {"type": "integer"}, "releaseReason": {"type": "string"}}, "required": ["expectedVersion"]}}}}, "responses": {"200": {"description": "Hold transitioned to RELEASED."}, "409": {"description": "Expected version does not match, or the hold is already released."}, "404": {"description": "Not found."}}}},
    "/fleet-partner/v1/security-settings": {
      "get": {"operationId": "getSecuritySettings", "x-permission": "security.settings.read", "responses": {"200": {"description": "Organization security settings, or platform defaults (version 0) if never overridden."}}},
      "put": {"operationId": "updateSecuritySettings", "x-permission": "security.settings.manage", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"expectedVersion": {"type": "integer", "description": "0 to create the first override for this organization."}, "mfaRequiredForSensitiveActions": {"type": "boolean"}, "stepUpFreshnessSeconds": {"type": "integer", "minimum": 300, "maximum": 3600}, "sessionRevocationPolicy": {"type": "string", "enum": ["IMMEDIATE", "STANDARD"]}, "allowedProviderAccessPolicy": {"type": "string", "enum": ["ACTIVE_MEMBERSHIP_ONLY", "ASSIGNED_ONLY"]}, "sensitiveExportThresholdKobo": {"type": "integer", "minimum": 0}, "restrictedDocumentStepUpRequired": {"type": "boolean"}, "auditCapturePolicy": {"type": "string", "enum": ["FULL", "NONE"]}, "retentionPreferenceDays": {"type": "integer", "minimum": 0}}, "required": ["expectedVersion"]}}}}, "responses": {"200": {"description": "Settings updated."}, "422": {"description": "A value violates a platform minimum or maximum."}, "409": {"description": "Expected version does not match, or a row already exists when expectedVersion=0."}}}
    },
    "/fleet-partner/v1/retention-policies": {"get": {"operationId": "listRetentionPolicies", "x-permission": "privacy.retention.read", "responses": {"200": {"description": "All fourteen retention classes with their effective (override-or-platform-minimum) duration in days."}}}},
    "/fleet-partner/v1/retention-policies/{class}": {
      "get": {"operationId": "getRetentionPolicy", "x-permission": "privacy.retention.read", "parameters": [{"name": "class", "in": "path", "required": true, "schema": {"type": "string"}}], "responses": {"200": {"description": "Effective policy for one class."}, "422": {"description": "Unrecognized retention class."}}},
      "put": {"operationId": "updateRetentionPolicy", "x-permission": "privacy.retention.manage", "parameters": [{"name": "class", "in": "path", "required": true, "schema": {"type": "string"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "properties": {"expectedVersion": {"type": "integer"}, "retentionDays": {"type": "integer"}}, "required": ["expectedVersion", "retentionDays"]}}}}, "responses": {"200": {"description": "Policy updated. retentionDays can only extend, never shorten, the platform minimum for the class."}, "422": {"description": "Unrecognized class, or retentionDays below the platform minimum."}, "409": {"description": "Expected version does not match, or a row already exists when expectedVersion=0."}}}
    }
  },
  "components": {"securitySchemes": {
    "CorporateBearer": {"type": "http", "scheme": "bearer", "bearerFormat": "JWT"}
  }},
  "security": [{"CorporateBearer": []}]
}
