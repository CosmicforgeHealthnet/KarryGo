{
  "openapi": "3.0.3",
  "info": {"title": "Dispatch assignment, queue and multi-vendor planning", "version": "1.1.0"},
  "paths": {
    "/api/v1/internal/dispatch/v1/assignments": {"post": {"summary": "Start a server-policy assignment", "security": [{"hmacV2": []}], "responses": {"202": {"description": "Assignment started"}, "409": {"description": "Conflict or stale quote"}}}},
    "/api/v1/provider/assignment-offers": {"get": {"summary": "List authenticated provider offers", "description": "Existing initial offers are unchanged. Replacement offers additionally include purpose=PROVIDER_REPLACEMENT and incident_ref. They prepare a replacement for the existing Trip, not a new delivery or custody transfer.", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Offers"}}}},
    "/api/v1/provider/assignment-offers/{offerId}/accept": {"post": {"summary": "Accept an exclusive offer", "description": "Replacement acceptance returns REPLACEMENT_READY with the existing Trip reference. It never creates another Trip or transfers custody; existing provider-transfer authorization remains required.", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Accepted or replayed"}, "409": {"description": "Expired or won"}}}},
    "/api/v1/provider/assignment-offers/{offerId}/decline": {"post": {"summary": "Decline an exclusive offer", "security": [{"bearerAuth": []}], "responses": {"200": {"description": "Declined"}}}},
    "/api/v1/customer/dispatch/missions/{missionId}/queue-options": {"post": {"summary": "Choose a queue option", "security": [{"customerBearer": []}], "responses": {"200": {"description": "Queue updated"}, "404": {"description": "Not found or not owned"}, "409": {"description": "Requote required"}}}},
    "/api/v1/internal/dispatch/v1/partner/missions/{missionId}/queue-options": {"post": {"summary": "Apply a source-scoped partner queue option", "security": [{"hmacV2": []}], "responses": {"200": {"description": "Queue updated"}, "404": {"description": "Not found or source scope mismatch"}}}},
    "/api/v1/internal/dispatch/v1/admin-assisted-assignments": {"post": {"summary": "Start a reasoned admin-assisted offer", "security": [{"hmacV2": []}], "responses": {"202": {"description": "Controlled provider offer created"}, "409": {"description": "Provider or assignment conflict"}}}},
    "/api/v1/internal/dispatch/v1/delivery-plans": {"post": {"summary": "Create an immutable multi-vendor plan", "security": [{"hmacV2": []}], "responses": {"201": {"description": "Plan created"}}}},
    "/api/v1/internal/dispatch/v1/delivery-plans/by-source/{sourceRef}": {"get": {"summary": "Read a Vendor Commerce plan by exact source reference and version", "security": [{"hmacV2": []}], "parameters": [{"in": "path", "name": "sourceRef", "required": true, "schema": {"type": "string"}}, {"in": "query", "name": "source_version", "required": true, "schema": {"type": "integer", "format": "int64", "minimum": 1}}], "responses": {"200": {"description": "Source-scoped plan"}, "404": {"description": "No matching source/version"}}}},
    "/api/v1/internal/dispatch/v1/delivery-plans/{groupRef}": {"get": {"summary": "Read active plan", "security": [{"hmacV2": []}], "responses": {"200": {"description": "Plan"}}}},
    "/api/v1/internal/dispatch/v1/delivery-plans/{groupRef}/replans": {"post": {"summary": "Create a source- and version-guarded replacement plan", "security": [{"hmacV2": []}], "responses": {"201": {"description": "Replacement plan"}, "409": {"description": "Execution or expected-version conflict"}}}},
    "/api/v1/internal/dispatch/v1/delivery-plans/manifests/{manifestRef}/custody/activate": {"post": {"summary": "Activate immutable manifest custody membership", "security": [{"hmacV2": []}], "responses": {"200": {"description": "Custody activated"}, "409": {"description": "Parcel already has active custody"}}}},
    "/api/v1/internal/dispatch/v1/delivery-plans/manifests/{manifestRef}/custody/release": {"post": {"summary": "Release active manifest custody membership", "security": [{"hmacV2": []}], "responses": {"200": {"description": "Custody released"}, "409": {"description": "Custody state conflict"}}}}
  },
  "components": {"securitySchemes": {"hmacV2": {"type": "apiKey", "in": "header", "name": "X-Service-Signature"}, "bearerAuth": {"type": "http", "scheme": "bearer"}, "customerBearer": {"type": "http", "scheme": "bearer"}}}
}
