# referral-service -- copy to .env and fill in the secrets.
APP_ENV=development
HTTP_ADDR=:8114
# Apply migrations on start (or run `go run ./cmd/migrate` once).
REFERRAL_MIGRATION=true
REFERRAL_DATABASE_URL=postgres://cosmicforge_logistics:cosmicforge_logistics@localhost:5450/referral_service?sslmode=disable
# Optional: rate-limits the public code check. Empty = unthrottled (local only).
REFERRAL_REDIS_ADDR=localhost:6391
REFERRAL_REDIS_PASSWORD=
REFERRAL_REDIS_DB=0

# Services allowed to call /internal/referral/v1, as caller=secret pairs,
# comma-separated. Each secret must equal what that service signs with:
#   payment-wallet-service            PAYMENT_WALLET_REFERRAL_OUTBOX_SECRET
#   customer-service                  CUSTOMER_REFERRAL_SERVICE_SECRET
#   driver-hauling-service            HAULING_REFERRAL_SERVICE_SECRET
#   driver-dispatch-delivery-service  DISPATCH_REFERRAL_SERVICE_SECRET
#   driver-taxi-service               TAXI_REFERRAL_SERVICE_SECRET
#   admin-backoffice-service          (operators' admin actions)
REFERRAL_SERVICE_SECRETS=
REFERRAL_ADMIN_CALLERS=admin-backoffice-service
# Pre-Secure-Admin HMAC-only operator routes remain off unless an explicit
# compatibility window is approved.
REFERRAL_LEGACY_ADMIN_ENABLED=false
# Who may ask whether a driver may cash out referral earnings.
REFERRAL_WITHDRAWAL_CHECK_CALLERS=payment-wallet-service

# Secure Admin Section 15: private owner boundary. All privileged capabilities
# default off; no production policy, source context, staff grant or key ships
# with the service.
REFERRAL_ADMIN_RESOURCE_READ_ENABLED=false
REFERRAL_ADMIN_CONTEXT_PUBLISH_ENABLED=false
REFERRAL_ADMIN_COMMAND_WRITES_ENABLED=false
REFERRAL_ADMIN_COMMAND_READBACK_ENABLED=false
REFERRAL_ADMIN_ACCESS_POLICY_FILE=
REFERRAL_ADMIN_ACCESS_POLICY_KEYS_FILE=
REFERRAL_ADMIN_CONTEXT_KEYS_FILE=
REFERRAL_ADMIN_RESOURCE_SECRET_FILE=
REFERRAL_ADMIN_CONTEXT_PUBLISH_SECRET_FILE=
REFERRAL_ADMIN_COMMAND_WRITE_SECRET_FILE=
REFERRAL_ADMIN_COMMAND_READBACK_SECRET_FILE=

# Login tokens for GET /api/v1/referrals/me. Each must equal the issuing
# service's access-token secret. Provider secrets are actor=secret pairs
# (hauling, dispatch, taxi).
REFERRAL_CUSTOMER_TOKEN_SECRET=
REFERRAL_PROVIDER_TOKEN_SECRETS=

REFERRAL_SHARE_LINK_BASE=https://karry-go.vercel.app/r/

# Posting rewards to payment-wallet: its bare origin (e.g.
# http://localhost:8105) and the secret it knows referral-service by (the
# referral-service entry in PAYMENT_WALLET_SERVICE_SECRETS). Set both or
# neither; with neither, approved rewards queue until a wallet is configured.
REFERRAL_WALLET_URL=
REFERRAL_WALLET_SECRET=

# Programme rules. Amounts are kobo.
REFERRAL_CUSTOMER_BONUS_KOBO=50000
REFERRAL_CUSTOMER_WELCOME_CREDIT_KOBO=20000
# Stands in for "10% off the first booking": a one-time spend-only credit.
REFERRAL_FIRST_BOOKING_CREDIT_KOBO=100000
REFERRAL_PROVIDER_WELCOME_CREDIT_KOBO=50000
# false = spend-only promotional credit (the spec); true = withdrawable.
REFERRAL_PROVIDER_WELCOME_WITHDRAWABLE=false
REFERRAL_PROVIDER_COMMISSION_BPS=1000
REFERRAL_PROVIDER_ACTIVATION_JOBS=5
REFERRAL_PROVIDER_WINDOW_DAYS=90
REFERRAL_CUSTOMER_ACTIVITY_THRESHOLD=5
REFERRAL_PROVIDER_ACTIVITY_THRESHOLD=10
REFERRAL_ACTIVITY_WINDOW_DAYS=30
# Stands in for the "free standard delivery" voucher at 5 referrals.
REFERRAL_MILESTONE_5_CREDIT_KOBO=150000
REFERRAL_MILESTONE_10_BONUS_KOBO=750000
REFERRAL_ACTIVITY_DECISION_DELAY_MINUTES=60
# Every Nth reversed job on one referral puts it under review; 0 = off.
REFERRAL_REVERSAL_REVIEW_THRESHOLD=3

# Background workers.
REFERRAL_DECISION_INTERVAL_SECONDS=30
REFERRAL_WALLET_INTERVAL_SECONDS=10
REFERRAL_EXPIRY_INTERVAL_SECONDS=3600
REFERRAL_RECONCILIATION_INTERVAL_SECONDS=86400
REFERRAL_WORKER_BATCH_SIZE=100
