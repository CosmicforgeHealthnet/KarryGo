# Notification Service
APP_ENV=development
HTTP_ADDR=:8106
MIGRATION=false

# Notification-owned Postgres database.
NOTIFICATION_DATABASE_URL=

# Notification-owned Redis instance or namespace.
NOTIFICATION_REDIS_ADDR=localhost:6385
NOTIFICATION_REDIS_PASSWORD=
NOTIFICATION_REDIS_DB=0

# Comma-separated service secrets, e.g. customer-service=secret,payment-wallet-service=secret
NOTIFICATION_SERVICE_SECRETS=

# Firebase Cloud Messaging. Leave empty in local development to use the logging push sender.
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Outbound SMTP: configure Resend with smtp.resend.com:465, username=resend,
# TLS mode=tls and a dedicated sending API key as the password, only after
# karryam.com is verified. See deploy/notification-service/RESEND_KARRYAM_CUTOVER.md.
# Missing credentials make email unavailable.
# Explicit logging is supported only with APP_ENV=development/test and NOTIFICATION_EMAIL_PROVIDER=logging.
NOTIFICATION_EMAIL_PROVIDER=smtp
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_USERNAME=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_TLS_MODE=starttls
NOTIFICATION_SMTP_TIMEOUT_SECONDS=15
NOTIFICATION_EMAIL_FROM=

# Realtime websocket token signing.
NOTIFICATION_REALTIME_TOKEN_SECRET=

# Worker and queue settings.
NOTIFICATION_WORKER_CONCURRENCY=5
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_REQUEST_STREAM=notification:requests
NOTIFICATION_DELIVERY_STREAM=notification:deliveries
NOTIFICATION_DEAD_LETTER_STREAM=notification:dead_letters

# Section 17 campaign fulfilment (default off; routes answer 503 when off).
# The campaign secret file holds a dedicated base64url HMAC key (>=32 bytes)
# shared only with admin-backoffice-service. The customer audience secret file
# holds the plain secret customer-service lists for notification-service in
# CUSTOMER_SERVICE_SECRETS. NOTIFICATION_CUSTOMER_SERVICE_URL is a bare origin.
NOTIFICATION_CAMPAIGNS_ENABLED=false
NOTIFICATION_CAMPAIGN_SECRET_FILE=
NOTIFICATION_CUSTOMER_SERVICE_URL=
NOTIFICATION_CUSTOMER_AUDIENCE_SECRET_FILE=

# Section 22 owner admin events (default off).
NOTIFICATION_ADMIN_EVENTS_ENABLED=false
NOTIFICATION_ADMIN_EVENTS_BRIDGE_ORIGIN=
NOTIFICATION_ADMIN_EVENTS_SECRET_FILE=
NOTIFICATION_ADMIN_EVENTS_SNAPSHOT_ENABLED=false
NOTIFICATION_ADMIN_EVENTS_SNAPSHOT_SECRET_FILE=
