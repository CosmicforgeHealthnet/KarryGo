APP_ENV=development
HTTP_ADDR=:8111
VERIFICATION_COMPLIANCE_DATABASE_URL=
VERIFICATION_COMPLIANCE_MIGRATION=false
VERIFICATION_COMPLIANCE_PRIVATE_API_ENABLED=false
# Comma-separated caller=name secret mappings, injected by the secret manager.
VERIFICATION_COMPLIANCE_SERVICE_SECRETS=
VERIFICATION_COMPLIANCE_ALLOWED_CALLERS=fleet-partner-service,vendor-service,admin-backoffice-service
# Optional durable Vendor callback delivery; configure both or neither.
VERIFICATION_COMPLIANCE_VENDOR_CALLBACK_URL=
VERIFICATION_COMPLIANCE_VENDOR_CALLBACK_SECRET=

# --- Section 12: asset capability and service-tier certification ---
# Gates WRITES only. Reads stay open while this is false so a rollout pause
# cannot make a certification-gated product look ungated.
ASSET_CAPABILITY_CERTIFICATION_ENABLED=false
# Per-authority certification ingress. Bare origin only: the path is fixed per
# authority because the three services mount their internal groups differently.
VERIFICATION_COMPLIANCE_TAXI_CALLBACK_URL=
VERIFICATION_COMPLIANCE_TAXI_CALLBACK_SECRET=
VERIFICATION_COMPLIANCE_DISPATCH_CALLBACK_URL=
VERIFICATION_COMPLIANCE_DISPATCH_CALLBACK_SECRET=
VERIFICATION_COMPLIANCE_HAULING_CALLBACK_URL=
VERIFICATION_COMPLIANCE_HAULING_CALLBACK_SECRET=
# media-file-service, for binding cited evidence to the asset it describes.
VERIFICATION_COMPLIANCE_MEDIA_BASE_URL=
VERIFICATION_COMPLIANCE_MEDIA_TOKEN=
