# Customer Service
APP_ENV=development
HTTP_ADDR=:8101
MIGRATION=false

# Customer-owned Postgres database.
CUSTOMER_DATABASE_URL=postgres://cosmicforge_logistics:cosmicforge_logistics@localhost:5433/customer_service?sslmode=disable

# Customer-owned Redis instance or namespace.
CUSTOMER_REDIS_ADDR=localhost:6380
CUSTOMER_REDIS_PASSWORD=
CUSTOMER_REDIS_DB=0

# Local development secrets only. Replace these in staging/production.
CUSTOMER_ACCESS_TOKEN_SECRET=development-customer-access-token-secret
CUSTOMER_REFRESH_TOKEN_SECRET=development-customer-refresh-token-secret
CUSTOMER_OTP_SECRET=development-customer-otp-secret

# Token and OTP timing.
CUSTOMER_ACCESS_TOKEN_TTL_SECONDS=900
CUSTOMER_REFRESH_TOKEN_TTL_HOURS=720
CUSTOMER_OTP_TTL_SECONDS=300
CUSTOMER_OTP_RATE_LIMIT_WINDOW_SECONDS=600

# OTP limits.
CUSTOMER_OTP_MAX_REQUESTS=5
CUSTOMER_OTP_MAX_ATTEMPTS=5

# Local-only debug mode. When true, OTPs can be exposed/logged for testing.
CUSTOMER_DEBUG_OTP=true

# ── Internal service clients ──────────────────────────────────────────────────
# Notification service (port 8106). Bare origin only — the client appends
# /api/v1/notifications/... itself, so do NOT include that path here.
# When unset, the /notifications proxy routes are skipped (no-op local dev).
CUSTOMER_NOTIFICATION_BASE_URL=http://localhost:8106
CUSTOMER_NOTIFICATION_SECRET=development-customer-notification-secret

# Referral programme feed. When enabled, every new customer is announced to
# referral-service in the same transaction that creates the account (only
# keyed hashes of phone/email/device are sent). URL is a bare origin; the
# secret must match customer-service in REFERRAL_SERVICE_SECRETS; the pepper
# must be identical in every service that feeds referral-service.
# Existing customers: run `go run ./cmd/referral-backfill` once.
CUSTOMER_REFERRAL_FEED_ENABLED=false
CUSTOMER_REFERRAL_SERVICE_URL=http://localhost:8114
CUSTOMER_REFERRAL_SERVICE_SECRET=
CUSTOMER_REFERRAL_IDENTITY_PEPPER=

# Section 6 customer context (all default false)
CUSTOMER_MOBILITY_PREFERENCES_ENABLED=false
CUSTOMER_GUEST_TRAVELLERS_ENABLED=false
CUSTOMER_TRUSTED_CONTACTS_ENABLED=false
CUSTOMER_UNIFIED_MOVEMENT_HISTORY_ENABLED=false
CUSTOMER_MOVEMENT_EVENTS_CONSUMER_ENABLED=false
# Each caller also needs an HMAC secret in CUSTOMER_SERVICE_SECRETS.
CUSTOMER_MOVEMENT_EVENT_CALLERS=driver-taxi-service=TAXI;driver-dispatch-delivery-service=DISPATCH;driver-hauling-service=HAULING;vendor-service=VENDOR_COMMERCE
CUSTOMER_CONTEXT_CALLER_SCOPES=driver-taxi-service=mobility_preferences|saved_location|guest_traveller;vendor-service=saved_location

# Customer V4 N12 customer upload capability. Off until secure-upload
# certification; when true, CUSTOMER_MEDIA_BASE_URL, CUSTOMER_MEDIA_PUBLIC_BASE_URL,
# CUSTOMER_SUPPORT_BASE_URL and CUSTOMER_MEDIA_PRIVATE_SECRET are required at startup.
CUSTOMER_MEDIA_UPLOAD_SESSION_ENABLED=false

# Section 7 Customer administrative commands (customer.admin-command.v1).
# Off by default. Readback must be enabled whenever writes are. Secret files hold
# base64url (no padding) keys of >=32 bytes that differ from every other Admin
# credential this service holds. Requires migrations 018/019 and an enabled
# owner admin runtime (CUSTOMER_ADMIN_RESOURCE_READ_ENABLED and its keys).
CUSTOMER_ADMIN_COMMAND_WRITES_ENABLED=false
CUSTOMER_ADMIN_COMMAND_READBACK_ENABLED=false
CUSTOMER_ADMIN_COMMAND_WRITE_SECRET_FILE=
CUSTOMER_ADMIN_COMMAND_READBACK_SECRET_FILE=
