{
  "openapi": "3.1.0",
  "info": {
    "title": "Analytics private scoped mission-success counts",
    "version": "1.0.0"
  },
  "security": [
    {
      "ScopedServiceHMAC": []
    }
  ],
  "paths": {
    "/internal/analytics/v1/admin/scoped-network/mission-success": {
      "get": {
        "operationId": "analytics.scoped.mission-success.read",
        "description": "Default off. Dedicated credential, durable nonce, report-specific permission, five-scope governance, independent producer contexts, suppression/reconstruction journal and original-member reauthorization. This is an incomplete counts-only source: complete membership and rate semantics remain engineering work. Current source always returns PARTIAL_COVERAGE with every value withheld; it cannot publish metrics by turning a flag on.",
        "parameters": [
          {
            "name": "market",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          {
            "name": "zone",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          {
            "name": "organization",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          {
            "name": "tenant",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          {
            "name": "staff",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          {
            "name": "role",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          {
            "name": "purpose",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          {
            "name": "policy_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          {
            "name": "authority",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          {
            "name": "product_code",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
            }
          },
          {
            "name": "policy_version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "policy_checksum",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "schema": {
              "const": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scoped suppressed counts and explicit coverage. No raw cohort size, member identifiers or producer payload.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "policy_id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "policy_version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "policy_checksum": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "scope": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "product": {
                          "const": "karryam"
                        },
                        "market": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
                        },
                        "zone": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
                        },
                        "organization": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
                        },
                        "tenant": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$"
                        }
                      },
                      "required": [
                        "product",
                        "market",
                        "zone",
                        "organization",
                        "tenant"
                      ]
                    },
                    "metric": {
                      "const": "mission-success"
                    },
                    "source_version": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/-]{0,127}$",
                      "maxLength": 128
                    },
                    "as_of": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "freshness": {
                      "enum": [
                        "LIVE",
                        "STALE"
                      ]
                    },
                    "coverage": {
                      "enum": [
                        "COMPLETE",
                        "PARTIAL_COVERAGE"
                      ]
                    },
                    "cells": {
                      "type": "array",
                      "minItems": 4,
                      "maxItems": 4,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "key": {
                            "enum": [
                              "completed",
                              "failed",
                              "cancelled",
                              "guarantee_breaches"
                            ]
                          },
                          "value": {
                            "type": [
                              "integer",
                              "null"
                            ],
                            "minimum": 0
                          },
                          "suppression": {
                            "enum": [
                              "NONE",
                              "UNKNOWN",
                              "SMALL_CELL",
                              "COMPLEMENTARY",
                              "PARTIAL_COVERAGE",
                              "STALE"
                            ]
                          }
                        },
                        "required": [
                          "key",
                          "value",
                          "suppression"
                        ],
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "suppression": {
                                  "const": "NONE"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "value": {
                                  "type": "integer"
                                }
                              }
                            },
                            "else": {
                              "properties": {
                                "value": {
                                  "type": "null"
                                }
                              }
                            }
                          }
                        ]
                      },
                      "allOf": [
                        {
                          "contains": {
                            "properties": {
                              "key": {
                                "const": "completed"
                              }
                            },
                            "required": [
                              "key"
                            ]
                          },
                          "minContains": 1,
                          "maxContains": 1
                        },
                        {
                          "contains": {
                            "properties": {
                              "key": {
                                "const": "failed"
                              }
                            },
                            "required": [
                              "key"
                            ]
                          },
                          "minContains": 1,
                          "maxContains": 1
                        },
                        {
                          "contains": {
                            "properties": {
                              "key": {
                                "const": "cancelled"
                              }
                            },
                            "required": [
                              "key"
                            ]
                          },
                          "minContains": 1,
                          "maxContains": 1
                        },
                        {
                          "contains": {
                            "properties": {
                              "key": {
                                "const": "guarantee_breaches"
                              }
                            },
                            "required": [
                              "key"
                            ]
                          },
                          "minContains": 1,
                          "maxContains": 1
                        }
                      ]
                    }
                  },
                  "required": [
                    "policy_id",
                    "policy_version",
                    "policy_checksum",
                    "scope",
                    "metric",
                    "source_version",
                    "as_of",
                    "freshness",
                    "coverage",
                    "cells"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "anyOf": [
                          {
                            "properties": {
                              "coverage": {
                                "const": "PARTIAL_COVERAGE"
                              }
                            }
                          },
                          {
                            "properties": {
                              "freshness": {
                                "const": "STALE"
                              }
                            }
                          }
                        ]
                      },
                      "then": {
                        "properties": {
                          "cells": {
                            "items": {
                              "properties": {
                                "value": {
                                  "type": "null"
                                },
                                "suppression": {
                                  "not": {
                                    "const": "NONE"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Sanitized denial/unavailable; no release values"
          },
          "401": {
            "description": "Sanitized denial/unavailable; no release values"
          },
          "403": {
            "description": "Sanitized denial/unavailable; no release values"
          },
          "409": {
            "description": "Sanitized denial/unavailable; no release values"
          },
          "429": {
            "description": "Sanitized denial/unavailable; no release values"
          },
          "503": {
            "description": "Sanitized denial/unavailable; no release values"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ScopedServiceHMAC": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Signature",
        "description": "Dedicated admin-backoffice-service HMAC v2 key, distinct from every legacy Analytics audience. Exact method/path/query/body, name/version/timestamp/nonce headers and durable cross-replica replay protection."
      }
    }
  }
}
