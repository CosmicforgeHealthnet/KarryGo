# Driver Hauling Service
APP_ENV=development
HTTP_ADDR=:8104

# Set to true to run database migrations on startup.
HAULING_MIGRATION=false

# ── Database ──────────────────────────────────────────────────────────────────
HAULING_DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
HAULING_REDIS_ADDR=localhost:6383
HAULING_REDIS_PASSWORD=
HAULING_REDIS_DB=0

# ── Token secrets ─────────────────────────────────────────────────────────────
# Inject long random strings through the deployment secret manager.
HAULING_PROVIDER_TOKEN_SECRET=
HAULING_PROVIDER_REFRESH_SECRET=
HAULING_PROVIDER_OTP_SECRET=

# Must match CUSTOMER_ACCESS_TOKEN_SECRET in customer-service.
HAULING_CUSTOMER_TOKEN_SECRET=

# Signs/verifies pickup & delivery handover codes (QR/OTP). Service-local — no
# other service needs to match this value.
HANDOVER_CODE_SECRET=development-handover-code-secret

# ── Token & OTP timing ────────────────────────────────────────────────────────
HAULING_ACCESS_TOKEN_TTL_SECONDS=3600
HAULING_REFRESH_TOKEN_TTL_DAYS=30
HAULING_OTP_TTL_SECONDS=600
HAULING_OTP_RATE_WINDOW_SECONDS=60
HAULING_OTP_MAX_REQUESTS=5
HAULING_OTP_MAX_ATTEMPTS=5

# Set to true in local dev to expose OTP codes in logs.
HAULING_OTP_DEBUG=false

# ── Internal service clients ──────────────────────────────────────────────────
# Bare origin only — the client appends /api/v1/notifications/... itself.
HAULING_NOTIFICATION_URL=
HAULING_NOTIFICATION_SECRET=

# Booking-lifecycle notifications are queued on a Redis stream that
# notification-service consumes, so this must point at ITS Redis instance —
# not this service's own. Defaults to HAULING_REDIS_ADDR, which is only correct
# when both services share a single Redis; otherwise notifications are published
# to a stream nobody reads and are silently never delivered.
HAULING_NOTIFICATION_REDIS_ADDR=

# Bare origin only — the client appends /api/v1/payment-wallet/internal/... itself.
HAULING_PAYMENT_URL=
HAULING_PAYMENT_SECRET=

# Google Cloud key with the Routes API enabled, for the road geometry the
# customer's live trip map draws and the progress bar measures along. Separate
# from the app-side Maps SDK key. Unset means routes are never fetched and
# consumers fall back to straight-line geometry.
HAULING_ROUTES_API_KEY=
# Explicit non-Wallet collection mode. Keep false unless operations approve it;
# cash bookings remain UNPAID in Hauling and never fabricate settlement.
HAULING_CASH_PAYMENTS_ENABLED=false

# Fleet integration is closed unless all gates and credentials are explicit.
HAULING_FLEET_INTEGRATION_ENABLED=false
HAULING_FLEET_INTEGRATION_KILL_SWITCH=false
HAULING_FLEET_ALLOWED_CALLERS=fleet-partner-service
# Inbound internal HMAC callers, as name=secret pairs.
# The internal commerce delivery-quote contract (Vendor Service Section 17C)
# is registered ONLY when this list contains a "vendor-service" entry, so a
# deployment that does not serve commerce quotes exposes no route to probe
# rather than one that answers 401 and confirms it exists.
#   HAULING_SERVICE_SECRETS=support-dispute-service=...,vendor-service=...
HAULING_SERVICE_SECRETS=
# How long an issued commerce delivery quote stands. Longer than dispatch's
# because a truck fleet's availability is less volatile than a bike courier's,
# and shorter than a checkout session so a plan can never outlive its quote.
HAULING_COMMERCE_QUOTE_TTL_SECONDS=1200
HAULING_OUTBOX_WORKER_ENABLED=false
# Full Fleet internal event ingestion URL.
HAULING_FLEET_EVENT_URL=
HAULING_FLEET_EVENT_SECRET=
# Dedicated Fleet private-order authority and provider-app decision relay.
# All credentials are required when enabled; secrets stay empty in source.
HAULING_PRIVATE_EXECUTION_ENABLED=false
FLEET_PARTNER_SERVICE_URL=
FLEET_PARTNER_SERVICE_CALLER=driver-hauling-service
FLEET_PARTNER_SERVICE_SECRET=
FLEET_PARTNER_SERVICE_TIMEOUT_SECONDS=5
PROVIDER_ORGANIZATION_MODE_ENABLED=false

# ── Matching tuning ───────────────────────────────────────────────────────────
HAULING_BOOKING_MATCH_TIMEOUT=30
# Total seconds to keep searching (rescanning for providers who come online)
# before a booking is marked unmatched. Must be >= match timeout.
HAULING_BOOKING_SEARCH_WINDOW=60
# Seconds a provider stays visible in the online pool without a heartbeat.
# Keep short — a stale value lets a force-quit provider stay dispatchable and
# eat a full match timeout out of the search window above for nothing.
HAULING_PROVIDER_ONLINE_TTL=90
