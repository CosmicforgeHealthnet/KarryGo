# Reference only. Provision real, distinct credentials directly on the VPS.
# The application rejects this file's empty credentials in staging/production.
APP_ENV=staging
HTTP_ADDR=:8111
ANALYTICS_DATABASE_URL=
ANALYTICS_REDIS_ADDR=karrygo-analytics-redis:6379
ANALYTICS_REDIS_PASSWORD=
ANALYTICS_SERVICE_SECRETS=
ANALYTICS_COMMERCE_EVENT_CALLERS=vendor-service,support-dispute-service,driver-dispatch-delivery-service,driver-hauling-service
ANALYTICS_NETWORK_EVENT_CALLERS=driver-taxi-service,driver-dispatch-delivery-service,driver-hauling-service,vendor-service
ANALYTICS_NETWORK_READ_CALLERS=vendor-service,driver-taxi-service,driver-dispatch-delivery-service,driver-hauling-service,fleet-partner-service
ANALYTICS_ADMIN_CALLER=admin-backoffice-service
# The first installation applies only this new service's own embedded schema.
MIGRATION=true
# Enable these only with source enrollment and signed, approved scoped policy.
ANALYTICS_ADMIN_SCOPED_NETWORK_READ_ENABLED=false
ANALYTICS_ADMIN_CONTEXT_PUBLISH_ENABLED=false
ANALYTICS_ADMIN_COVERAGE_PUBLISH_ENABLED=false
