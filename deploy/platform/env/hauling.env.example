# /opt/karrygo/hauling-service/hauling.env  (mode 600)
APP_ENV=staging
HTTP_ADDR=:8104
# Creates/updates this service's tables at startup.
HAULING_MIGRATION=true

# --- Own database and Redis (passwords from db.env) ---
HAULING_DATABASE_URL=postgres://cosmicforge_logistics:<db.env POSTGRES_PASSWORD>@karrygo-hauling-db:5432/hauling_service?sslmode=disable
HAULING_REDIS_ADDR=karrygo-hauling-redis:6379
HAULING_REDIS_PASSWORD=<db.env REDIS_PASSWORD>
HAULING_REDIS_DB=0

# --- Login tokens ---
# Truck drivers' token secret. MUST MATCH support SUPPORT_DISPUTE_HAULING_PROVIDER_TOKEN_SECRET
# and the hauling=... entry in payment-wallet PAYMENT_WALLET_PROVIDER_ACCESS_TOKEN_SECRETS.
HAULING_PROVIDER_TOKEN_SECRET=GENERATE
HAULING_PROVIDER_REFRESH_SECRET=GENERATE
HAULING_PROVIDER_OTP_SECRET=GENERATE
HAULING_CUSTOMER_TOKEN_SECRET=MUST MATCH customer CUSTOMER_ACCESS_TOKEN_SECRET
HANDOVER_CODE_SECRET=GENERATE
# Never true on a server: it would show login codes in API responses.
HAULING_OTP_DEBUG=false

# --- Other services (bare origins, no path) ---
# Ride/booking notifications go onto notification-service's OWN Redis queue.
# Without these three, they land in this service's Redis and nobody reads them
# (no push, no in-app alert). Password: REDIS_PASSWORD in notification-service/db.env.
HAULING_NOTIFICATION_REDIS_ADDR=karrygo-notification-redis:6379
HAULING_NOTIFICATION_REDIS_PASSWORD=MUST MATCH notification-service db.env REDIS_PASSWORD
HAULING_NOTIFICATION_REDIS_DB=0
HAULING_NOTIFICATION_URL=http://karrygo-notification-service:8106
HAULING_NOTIFICATION_SECRET=GENERATE (then add driver-hauling-service=<this> to NOTIFICATION_SERVICE_SECRETS)
HAULING_PAYMENT_URL=http://karrygo-payment-wallet-service:8105
HAULING_PAYMENT_SECRET=GENERATE (then add driver-hauling-service=<this> to PAYMENT_WALLET_SERVICE_SECRETS)
HAULING_MEDIA_URL=http://karrygo-media-file-service:8109
HAULING_MEDIA_TOKEN=GENERATE (then add driver-hauling-service=<this> to MEDIA_FILE_SERVICE_TOKENS)
# Who may call this service. MUST MATCH support SUPPORT_DISPUTE_HAULING_SERVICE_SECRET.
HAULING_SERVICE_SECRETS=support-dispute-service=GENERATE
# Real road routes on the map (optional; without it routes are straight lines).
HAULING_ROUTES_API_KEY=YOUR Google Cloud key with the Routes API enabled

# --- Features (switch on deliberately, one at a time) ---
HAULING_CASH_PAYMENTS_ENABLED=false
HAULING_FLEET_INTEGRATION_ENABLED=false
HAULING_COMMERCE_INTEGRATION_ENABLED=false
HAULING_OUTBOX_WORKER_ENABLED=false
HAULING_REFERRAL_FEED_ENABLED=false
HAULING_CUSTOMER_MOVEMENT_EVENTS_ENABLED=false

# Staging only: reserved test numbers (+23480000 block, comma-separated) sign in
# with this fixed 6-digit code. Leave empty in production (the service refuses it there).
HAULING_TEST_LOGIN_PHONES=
HAULING_TEST_LOGIN_CODE=

# Internal callers allowed to sign requests to this service (name=secret, comma-separated).
# admin-backoffice-service is used by bin/approve-driver.sh to approve drivers.
HAULING_SERVICE_SECRETS=support-dispute-service=MATCH-support-dispute,admin-backoffice-service=GENERATE
