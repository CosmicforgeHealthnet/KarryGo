# /opt/karrygo/support-dispute-service/support.env  (mode 600)
APP_ENV=staging
HTTP_ADDR=:8107
# Creates/updates this service's tables at startup.
MIGRATION=true

# --- Own database (password from db.env) ---
SUPPORT_DISPUTE_DATABASE_URL=postgres://cosmicforge_logistics:<db.env POSTGRES_PASSWORD>@karrygo-support-dispute-db:5432/support_dispute_service?sslmode=disable

# --- Token secrets of the apps whose users file complaints (all MUST MATCH) ---
SUPPORT_DISPUTE_CUSTOMER_ACCESS_TOKEN_SECRET=MUST MATCH customer CUSTOMER_ACCESS_TOKEN_SECRET
SUPPORT_DISPUTE_HAULING_PROVIDER_TOKEN_SECRET=MUST MATCH hauling HAULING_PROVIDER_TOKEN_SECRET
SUPPORT_DISPUTE_TAXI_PROVIDER_TOKEN_SECRET=MUST MATCH taxi TAXI_PROVIDER_TOKEN_SECRET
SUPPORT_DISPUTE_DISPATCH_PROVIDER_TOKEN_SECRET=MUST MATCH dispatch DISPATCH_RIDER_ACCESS_TOKEN_SECRET

# --- Who may call this service (name=secret, comma separated) ---
# These caller names are the ones the code expects (see the service's defaults).
SUPPORT_DISPUTE_SERVICE_SECRETS=customer-service=GENERATE,taxi-service=GENERATE,dispatch-delivery-service=GENERATE,hauling-service=GENERATE,admin-backoffice-service=GENERATE,fleet-partner-service=GENERATE,vendor-service=GENERATE

# --- Services this one calls (bare origins) and the secret for each ---
SUPPORT_DISPUTE_NOTIFICATION_URL=http://karrygo-notification-service:8106
SUPPORT_DISPUTE_NOTIFICATION_SECRET=GENERATE (then add support-dispute-service=<this> to NOTIFICATION_SERVICE_SECRETS)
SUPPORT_DISPUTE_PAYMENT_URL=http://karrygo-payment-wallet-service:8105
SUPPORT_DISPUTE_PAYMENT_SECRET=GENERATE (then add support-dispute-service=<this> to PAYMENT_WALLET_SERVICE_SECRETS)
SUPPORT_DISPUTE_CUSTOMER_SERVICE_URL=http://karrygo-customer-service:8101
SUPPORT_DISPUTE_CUSTOMER_SERVICE_SECRET=MUST MATCH the support-dispute-service=... entry in customer CUSTOMER_SERVICE_SECRETS
SUPPORT_DISPUTE_HAULING_SERVICE_URL=http://karrygo-hauling-service:8104
SUPPORT_DISPUTE_HAULING_SERVICE_SECRET=MUST MATCH the support-dispute-service=... entry in hauling HAULING_SERVICE_SECRETS
SUPPORT_DISPUTE_TAXI_SERVICE_URL=http://karrygo-taxi-service:8102
SUPPORT_DISPUTE_TAXI_SERVICE_SECRET=MUST MATCH the support-dispute-service=... entry in taxi TAXI_SERVICE_SECRETS
SUPPORT_DISPUTE_DISPATCH_SERVICE_URL=http://karrygo-dispatch-delivery-service:8103
SUPPORT_DISPUTE_DISPATCH_SERVICE_SECRET=MUST MATCH the support-dispute-service=... entry in dispatch DISPATCH_SERVICE_SECRETS
