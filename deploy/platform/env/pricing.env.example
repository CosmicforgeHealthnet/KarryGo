# /opt/karrygo/pricing-service/pricing.env  (mode 600)
# Pricing is internal only: no app talks to it. Taxi, dispatch and hauling ask it
# for quotes over signed internal routes (shadow mode: for comparison only).
APP_ENV=staging
HTTP_ADDR=:8115
# Creates/updates this service's tables at startup.
PRICING_MIGRATION=true

# --- Own database (password from db.env) ---
PRICING_DATABASE_URL=postgres://cosmicforge_logistics:<db.env POSTGRES_PASSWORD>@karrygo-pricing-db:5432/pricing_service?sslmode=disable

# --- Who may call this service (name=secret, comma separated) ---
# Each quote caller's secret must match that service's *_PRICING_SECRET.
PRICING_SERVICE_SECRETS=admin-backoffice-service=GENERATE,pricing-ops-cli=GENERATE,driver-taxi-service=GENERATE,driver-dispatch-delivery-service=GENERATE,driver-hauling-service=GENERATE
PRICING_QUOTE_CALLERS=driver-taxi-service,driver-dispatch-delivery-service,driver-hauling-service
PRICING_ADMIN_CALLERS=admin-backoffice-service,pricing-ops-cli
PRICING_FOUR_EYE_REQUIRED=true
