# /opt/karrygo/pricing-service/pricing.env  (mode 600)
# Pricing is internal only: no app talks to it, and it has no quote endpoint
# yet, so nothing calls it today. Deploying it now only prepares its database.
APP_ENV=staging
HTTP_ADDR=:8115
# Creates/updates this service's tables at startup.
PRICING_MIGRATION=true

# --- Own database (password from db.env) ---
PRICING_DATABASE_URL=postgres://cosmicforge_logistics:<db.env POSTGRES_PASSWORD>@karrygo-pricing-db:5432/pricing_service?sslmode=disable

# --- Who may call this service (name=secret, comma separated) ---
PRICING_SERVICE_SECRETS=admin-backoffice-service=GENERATE,pricing-ops-cli=GENERATE
PRICING_QUOTE_CALLERS=
PRICING_ADMIN_CALLERS=admin-backoffice-service,pricing-ops-cli
PRICING_FOUR_EYE_REQUIRED=true
