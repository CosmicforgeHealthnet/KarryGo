# /opt/karrygo/<service-home>/db.env  (mode 600)
# Passwords for this service's OWN database and Redis containers. The database
# container reads POSTGRES_*; the Redis container reads REDIS_PASSWORD.
# The same values must appear in the service's settings file:
#   *_DATABASE_URL=postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@karrygo-<name>-db:5432/<POSTGRES_DB>?sslmode=disable
#   *_REDIS_PASSWORD=<REDIS_PASSWORD>
POSTGRES_DB=customer_service
POSTGRES_USER=cosmicforge_logistics
POSTGRES_PASSWORD=GENERATE
REDIS_PASSWORD=GENERATE
