# Provision only after reviewing docs/admin-bridge/runbook.md.
ADMIN_REMOTE_ENABLED=false
ADMIN_TLS_ADDR=:8110
ADMIN_BACKOFFICE_DATABASE_URL=
ADMIN_TLS_CERT_FILE=/run/admin-secrets/server.crt
ADMIN_TLS_KEY_FILE=/run/admin-secrets/server.key
ADMIN_TLS_CLIENT_CA_FILE=/run/admin-secrets/hq-client-ca.pem
ADMIN_TRUST_FILE=/run/admin-secrets/trust.json
# Rollout requests never grant permissions or implement an owner capability.
# All domain commands remain disabled even if these flags are set true.
ADMIN_REMOTE_WRITES_ENABLED=false
ADMIN_ANALYTICS_READ_ENABLED=false
ADMIN_CUSTOMER_SENSITIVE_READ_ENABLED=false
ADMIN_CUSTOMER_WRITES_ENABLED=false
ADMIN_TAXI_WRITES_ENABLED=false
ADMIN_DISPATCH_RECOVERY_ENABLED=false
ADMIN_HAULING_RECOVERY_ENABLED=false
# Signed owner-approved policy and independently pinned governance public keys.
# Missing/DRAFT policy blocks disclosure. Never mount test approval keys here.
ADMIN_ACCESS_POLICY_FILE=
ADMIN_ACCESS_POLICY_KEYS_FILE=
# Scoped Taxi owner reads are separately disabled. These settings do not
# provision network access; an approved private owner path is required.
ADMIN_TAXI_READ_ENABLED=false
ADMIN_TAXI_ORIGIN=
ADMIN_TAXI_SECRET_FILE=
# Comma-separated exact roles from the approved authorization policy.
ADMIN_TAXI_READ_ROLES=
