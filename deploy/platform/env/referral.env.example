# /opt/karrygo/referral-service/referral.env  (mode 600)
APP_ENV=staging
HTTP_ADDR=:8114
# Creates/updates this service's tables at startup.
REFERRAL_MIGRATION=true

# --- Own database and Redis (passwords from db.env) ---
REFERRAL_DATABASE_URL=postgres://cosmicforge_logistics:<db.env POSTGRES_PASSWORD>@karrygo-referral-db:5432/referral_service?sslmode=disable
REFERRAL_REDIS_ADDR=karrygo-referral-redis:6379
REFERRAL_REDIS_PASSWORD=<db.env REDIS_PASSWORD>
REFERRAL_REDIS_DB=0

# --- Who may call this service (name=secret, comma separated) ---
# The producers that announce new accounts and paid jobs, plus admin.
REFERRAL_SERVICE_SECRETS=payment-wallet-service=GENERATE,customer-service=GENERATE,driver-hauling-service=GENERATE,driver-dispatch-delivery-service=GENERATE,driver-taxi-service=GENERATE,admin-backoffice-service=GENERATE
REFERRAL_ADMIN_CALLERS=admin-backoffice-service
REFERRAL_WITHDRAWAL_CHECK_CALLERS=payment-wallet-service

# --- Login tokens (for the app's "my referrals" screens) ---
REFERRAL_CUSTOMER_TOKEN_SECRET=MUST MATCH customer CUSTOMER_ACCESS_TOKEN_SECRET
REFERRAL_PROVIDER_TOKEN_SECRETS=hauling=MUST MATCH hauling HAULING_PROVIDER_TOKEN_SECRET,taxi=MUST MATCH taxi TAXI_PROVIDER_TOKEN_SECRET,dispatch=MUST MATCH dispatch DISPATCH_RIDER_ACCESS_TOKEN_SECRET

# --- Wallet (referral never holds money; it asks payment-wallet to credit) ---
# Leave both empty until referral payouts are switched on deliberately.
REFERRAL_WALLET_URL=
REFERRAL_WALLET_SECRET=

REFERRAL_SHARE_LINK_BASE=https://karryam.com/r/
# Reward amounts are product decisions; these are the documented defaults (kobo).
REFERRAL_CUSTOMER_BONUS_KOBO=50000
REFERRAL_CUSTOMER_WELCOME_CREDIT_KOBO=20000
REFERRAL_FIRST_BOOKING_CREDIT_KOBO=100000
REFERRAL_PROVIDER_WELCOME_CREDIT_KOBO=50000
REFERRAL_PROVIDER_WELCOME_WITHDRAWABLE=false
REFERRAL_PROVIDER_COMMISSION_BPS=1000
REFERRAL_MILESTONE_5_CREDIT_KOBO=150000
REFERRAL_MILESTONE_10_BONUS_KOBO=750000
