# /opt/karrygo/taxi-service/taxi.env  (mode 600)
APP_ENV=staging
HTTP_ADDR=:8102
# Creates/updates this service's tables at startup.
TAXI_MIGRATION=true

# --- Own database and Redis (passwords from db.env) ---
TAXI_DATABASE_URL=postgres://cosmicforge_logistics:<db.env POSTGRES_PASSWORD>@karrygo-taxi-db:5432/taxi_service?sslmode=disable
TAXI_REDIS_ADDR=karrygo-taxi-redis:6379
TAXI_REDIS_PASSWORD=<db.env REDIS_PASSWORD>
TAXI_REDIS_DB=0

# --- Login tokens ---
# Taxi drivers' token secret. MUST MATCH support SUPPORT_DISPUTE_TAXI_PROVIDER_TOKEN_SECRET
# and the taxi=... entry in payment-wallet PAYMENT_WALLET_PROVIDER_ACCESS_TOKEN_SECRETS.
TAXI_PROVIDER_TOKEN_SECRET=GENERATE
TAXI_PROVIDER_REFRESH_SECRET=GENERATE
TAXI_PROVIDER_OTP_SECRET=GENERATE
TAXI_CUSTOMER_TOKEN_SECRET=MUST MATCH customer CUSTOMER_ACCESS_TOKEN_SECRET
HANDOVER_CODE_SECRET=GENERATE
# Never true on a server: it would show login codes in API responses.
TAXI_OTP_DEBUG=false

# --- Other services ---
TAXI_NOTIFICATION_URL=http://karrygo-notification-service:8106
TAXI_NOTIFICATION_SECRET=GENERATE (then add driver-taxi-service=<this> to NOTIFICATION_SERVICE_SECRETS)
TAXI_PAYMENT_URL=http://karrygo-payment-wallet-service:8105
TAXI_PAYMENT_SECRET=GENERATE (then add driver-taxi-service=<this> to PAYMENT_WALLET_SERVICE_SECRETS)
TAXI_MEDIA_URL=http://karrygo-media-file-service:8109
TAXI_MEDIA_TOKEN=GENERATE (then add driver-taxi-service=<this> to MEDIA_FILE_SERVICE_TOKENS)
# Who may call this service. MUST MATCH support SUPPORT_DISPUTE_TAXI_SERVICE_SECRET.
TAXI_SERVICE_SECRETS=support-dispute-service=GENERATE
# Real road routes on the map (optional; without it routes are straight lines).
TAXI_ROUTES_API_KEY=YOUR Google Cloud key with the Routes API enabled

# --- Features (switch on deliberately, one at a time) ---
TAXI_GOODS_DELIVERY_ENABLED=false
TAXI_REFERRAL_FEED_ENABLED=false
TAXI_SERVICE_PRODUCTS_ENABLED=false
TAXI_CAPABILITY_MATCHING_ENABLED=false
TAXI_CUSTOMER_MOVEMENT_EVENTS_ENABLED=false
TAXI_CUSTOMER_CONTEXT_ENABLED=false

# Private Admin read subset: requires reviewed network provisioning, dedicated
# HMAC secret and the same signed policy revision pinned by the Admin bridge.
TAXI_ADMIN_READ_ENABLED=false
TAXI_ADMIN_READ_SECRET_FILE=
TAXI_ADMIN_ACCESS_POLICY_FILE=
TAXI_ADMIN_ACCESS_POLICY_KEYS_FILE=
