# /opt/karrygo/customer-service/customer.env  (mode 600)
APP_ENV=staging
HTTP_ADDR=:8101
# Creates/updates this service's tables at startup.
MIGRATION=true

# --- Own database and Redis (passwords from db.env) ---
CUSTOMER_DATABASE_URL=postgres://cosmicforge_logistics:<db.env POSTGRES_PASSWORD>@karrygo-customer-db:5432/customer_service?sslmode=disable
CUSTOMER_REDIS_ADDR=karrygo-customer-redis:6379
CUSTOMER_REDIS_PASSWORD=<db.env REDIS_PASSWORD>
CUSTOMER_REDIS_DB=0

# --- Login tokens ---
# The access-token secret is shared: every service that accepts a customer login
# checks tokens with it.
# MUST MATCH payment-wallet PAYMENT_WALLET_CUSTOMER_ACCESS_TOKEN_SECRET (already
# set on the server), and is copied into hauling, taxi, dispatch, support and referral.
CUSTOMER_ACCESS_TOKEN_SECRET=MUST MATCH payment-wallet PAYMENT_WALLET_CUSTOMER_ACCESS_TOKEN_SECRET
CUSTOMER_REFRESH_TOKEN_SECRET=GENERATE
CUSTOMER_OTP_SECRET=GENERATE
CUSTOMER_ACCESS_TOKEN_TTL_SECONDS=900
CUSTOMER_REFRESH_TOKEN_TTL_HOURS=720
CUSTOMER_OTP_TTL_SECONDS=300
CUSTOMER_OTP_RATE_LIMIT_WINDOW_SECONDS=600
CUSTOMER_OTP_MAX_REQUESTS=5
CUSTOMER_OTP_MAX_ATTEMPTS=5
# Never true on a server: it would show login codes in API responses.
CUSTOMER_DEBUG_OTP=false

# --- Other services (private network addresses; bare origins, no path) ---
CUSTOMER_NOTIFICATION_BASE_URL=http://karrygo-notification-service:8106
# MUST MATCH the customer-service=... entry in notification NOTIFICATION_SERVICE_SECRETS
CUSTOMER_NOTIFICATION_SECRET=GENERATE (then add customer-service=<this> to NOTIFICATION_SERVICE_SECRETS)
CUSTOMER_MEDIA_BASE_URL=http://karrygo-media-file-service:8109
# MUST MATCH the customer-service=... entry in media MEDIA_FILE_SERVICE_TOKENS
CUSTOMER_MEDIA_SERVICE_TOKEN=GENERATE (then add customer-service=<this> to MEDIA_FILE_SERVICE_TOKENS)
CUSTOMER_SUPPORT_BASE_URL=http://karrygo-support-dispute-service:8107
# Who may call this service, and with which secret (support-dispute reads customer identities).
# MUST MATCH support SUPPORT_DISPUTE_CUSTOMER_SERVICE_SECRET
CUSTOMER_SERVICE_SECRETS=support-dispute-service=GENERATE

# --- Features (switch on deliberately, one at a time) ---
CUSTOMER_REFERRAL_FEED_ENABLED=false
CUSTOMER_MOBILITY_PREFERENCES_ENABLED=false
CUSTOMER_GUEST_TRAVELLERS_ENABLED=false
CUSTOMER_TRUSTED_CONTACTS_ENABLED=false
CUSTOMER_UNIFIED_MOVEMENT_HISTORY_ENABLED=false
CUSTOMER_MOVEMENT_EVENTS_CONSUMER_ENABLED=false
CUSTOMER_MEDIA_UPLOAD_SESSION_ENABLED=false

# Staging only: reserved test numbers (+23480000 block, comma-separated) sign in
# with this fixed 6-digit code. Leave empty in production (the service refuses it there).
CUSTOMER_TEST_LOGIN_PHONES=
CUSTOMER_TEST_LOGIN_CODE=
