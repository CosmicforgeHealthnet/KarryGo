# Copy to /opt/karrygo/vendor-service/vendor.env on the staging VPS and chmod 600.
# Inject real values through the operator-approved secret manager. Never commit them.
APP_ENV=staging
VENDOR_DATABASE_URL=
VENDOR_REDIS_ADDR=
VENDOR_REDIS_PASSWORD=
VENDOR_REDIS_DB=0

VENDOR_AUTH_ACCESS_TOKEN_SECRET=
VENDOR_AUTH_REFRESH_TOKEN_SECRET=
VENDOR_AUTH_OTP_SECRET=
VENDOR_AUTH_OTP_DEBUG=false
VENDOR_SERVICE_SECRETS=

VENDOR_WALLET_URL=
VENDOR_WALLET_SECRET=
VENDOR_DISPATCH_URL=
VENDOR_DISPATCH_SECRET=
VENDOR_HAULING_URL=
VENDOR_HAULING_SECRET=
VENDOR_TAXI_URL=
VENDOR_TAXI_SECRET=
VENDOR_VERIFICATION_URL=
VENDOR_VERIFICATION_SECRET=
VENDOR_MEDIA_URL=
VENDOR_MEDIA_SECRET=
VENDOR_NOTIFICATION_URL=
VENDOR_NOTIFICATION_SECRET=
VENDOR_SUPPORT_URL=
VENDOR_SUPPORT_SECRET=
VENDOR_CUSTOMER_URL=
VENDOR_CUSTOMER_SECRET=

# Safe initial rollout. Enable only after the matching endpoint, credential,
# reciprocal allowlist and black-box probe have passed.
VENDOR_SERVICE_ENABLED=false
COMMERCE_GLOBAL_KILL_SWITCH=true
COMMERCE_FULFILMENT_WORKERS_ENABLED=false
PAYMENT_WALLET_COMMERCE_ENABLED=false
DISPATCH_COMMERCE_INTEGRATION_ENABLED=false
HAULING_COMMERCE_INTEGRATION_ENABLED=false
TAXI_GOODS_DELIVERY_ENABLED=false
VENDOR_VERIFICATION_INTEGRATION_ENABLED=false

# ---------------------------------------------------------------------------
# Vendor-app required set. Every Vendor Flutter app screen needs ALL of the
# flags below (enable-staging-app-features.sh [staging|production] writes them,
# proven by internal/config/app_feature_set_test.go). COMMERCE_GLOBAL_KILL_SWITCH
# must then be false: while true it makes onboarding/catalogue/taxonomy writes
# read-only, unregisters the readiness and orchestration routes and stops every
# worker, so most app flows fail. It is the emergency stop, not a rollout gate.
# Needs: Notification, Media (+VENDOR_MEDIA_PUBLIC_URL), Wallet, Verification
# (+verification-compliance-service in VENDOR_SERVICE_SECRETS) and at least one
# of Dispatch/Hauling/Taxi URL+secret; VENDOR_TAXONOMY_INTERNAL_CALLERS and
# VENDOR_SEARCH_INTERNAL_CALLERS must be non-empty.
# ---------------------------------------------------------------------------
# COMMERCE_GLOBAL_KILL_SWITCH=false
# VENDOR_SERVICE_ENABLED=true
# VENDOR_ONBOARDING_WRITES_ENABLED=true
# VENDOR_CRM_ENABLED=true
# VENDOR_CRM_WRITES_ENABLED=true
# VENDOR_CRM_CUSTOMER_PROJECTION_ENABLED=true
# VENDOR_CRM_CONSENT_INTEGRATION_ENABLED=true
# VENDOR_CRM_PRIVACY_INTEGRATION_ENABLED=true
# VENDOR_CRM_SEGMENTATION_ENABLED=true
# VENDOR_CRM_SEGMENT_MATERIALIZATION_ENABLED=true
# VENDOR_CRM_INTERACTIONS_ENABLED=true
# VENDOR_CRM_TASKS_ENABLED=true
# VENDOR_CRM_LOYALTY_ENABLED=true
# VENDOR_CRM_CAMPAIGNS_ENABLED=true
# VENDOR_CRM_CAMPAIGN_PREPARATION_ENABLED=true
# VENDOR_CRM_CAMPAIGN_EXECUTION_ENABLED=true
# VENDOR_CRM_CORPORATE_ENABLED=true
# VENDOR_CRM_INTELLIGENCE_ENABLED=true
# VENDOR_CRM_INTELLIGENCE_WORKER_ENABLED=true
# VENDOR_CRM_EXPORTS_ENABLED=true
# VENDOR_PRIVACY_RETENTION_ENABLED=true
# VENDOR_INVENTORY_ENABLED=true
# VENDOR_INVENTORY_WRITES_ENABLED=true
# VENDOR_PURCHASING_ENABLED=true
# VENDOR_RECIPES_ENABLED=true
# VENDOR_COST_ENABLED=true
# COMMERCE_FOOD_ENABLED=true
# VENDOR_FOOD_CATALOGUE_WRITES_ENABLED=true
# COMMERCE_SHOP_ENABLED=true
# VENDOR_SHOP_CATALOGUE_WRITES_ENABLED=true
# CUSTOMER_FOOD_ENABLED=true
# CUSTOMER_SHOP_ENABLED=true
# COMMERCE_MULTI_VENDOR_ENABLED=true
# COMMERCE_VARIABLE_WEIGHT_ENABLED=true
# COMMERCE_BULK_RFQ_ENABLED=true
# VENDOR_OWN_DELIVERY_ENABLED=true
# COMMERCE_CHECKOUT_ENABLED=true
# COMMERCE_CHECKOUT_RECOVERY_ENABLED=true
# COMMERCE_FULFILMENT_PLANNING_ENABLED=true
# COMMERCE_FULFILMENT_WORKERS_ENABLED=true
# COMMERCE_QUOTE_LOCK_ENABLED=true
# COMMERCE_ORDERS_ENABLED=true
# VENDOR_READINESS_ORCHESTRATION_ENABLED=true
# VENDOR_JIT_PICKUP_ENABLED=true
# VENDOR_AUTO_AUTHORITY_SELECTION_ENABLED=true
# VENDOR_TAXONOMY_ENABLED=true
# VENDOR_TAXONOMY_WRITES_ENABLED=true
# VENDOR_SEARCH_ENABLED=true
# PAYMENT_WALLET_COMMERCE_ENABLED=true
# VENDOR_VERIFICATION_INTEGRATION_ENABLED=true
# DISPATCH_COMMERCE_INTEGRATION_ENABLED=true
# HAULING_COMMERCE_INTEGRATION_ENABLED=true
# TAXI_GOODS_DELIVERY_ENABLED=true
# VENDOR_DISPATCH_HANDOVER_RELAY_ENABLED=true
# VENDOR_HAULING_HANDOVER_RELAY_ENABLED=true
# VENDOR_TAXI_HANDOVER_RELAY_ENABLED=true
# VENDOR_OWNED_HANDOVER_RELAY_ENABLED=true
# VENDOR_TAXONOMY_INTERNAL_CALLERS=admin-backoffice-service
# VENDOR_SEARCH_INTERNAL_CALLERS=customer-service
